@using CookieCommerce.Web.Models.Products
@using CookieCommerce.Web.Services
@using CookieCommerce.Web.Services.Products
@rendermode InteractiveServer

@inject ICookieService CookieService
@inject ICartService CartService

<style>
    @@keyframes slideInFromRight {
        from {
            transform: translateX(100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes slideOutToLeft {
        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(-100%);
            opacity: 0;
        }
    }

    @@keyframes slideInFromLeft {
        from {
            transform: translateX(-100%);
            opacity: 0;
        }

        to {
            transform: translateX(0);
            opacity: 1;
        }
    }

    @@keyframes slideOutToRight {
        from {
            transform: translateX(0);
            opacity: 1;
        }

        to {
            transform: translateX(100%);
            opacity: 0;
        }
    }

    /* Base class for animated images */
    .variant-image-slide {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease-in-out, opacity 0.5s ease-in-out;
        /* Ensure images don't overflow during animation */
        will-change: transform, opacity;
    }

    /* Animation trigger classes */
    .animate-enter-right {
        animation: slideInFromRight 0.5s ease-in-out forwards;
        z-index: 2;
    }

    .animate-exit-left {
        animation: slideOutToLeft 0.5s ease-in-out forwards;
        z-index: 1;
    }

    .animate-enter-left {
        animation: slideInFromLeft 0.5s ease-in-out forwards;
        z-index: 2;
    }

    .animate-exit-right {
        animation: slideOutToRight 0.5s ease-in-out forwards;
        z-index: 1;
    }
</style>

@{
    var standardClassList = "cookie-shadow group rounded-3xl p-6 transition-all duration-300 hover:-translate-y-2 border relative overflow-hidden flex flex-col";
    var h3ClassList = "font-display font-bold text-2xl";
    var spanPriceClassList = "font-display font-bold text-xl";
    var pClassList = "";
    var btnClassList = "w-full py-4 font-bold rounded-2xl flex items-center justify-center gap-2 transition-all shadow-lg";

    if (IsLimitedEdition)
    {
        standardClassList += " rare-card  bg-brand-orange  border-orange-400";
        h3ClassList += " font-display font-bold text-2xl text-white";
        spanPriceClassList += " text-white";
        pClassList += "text-orange-50 leading-relaxed mb-6 opacity-90";
        btnClassList += "  hover:bg-orange-50 text-brand-orange shadow-black/10";
    }
    else
    {
        standardClassList += " bg-surface-light dark:bg-surface-dark border-amber-50 dark:border-amber-900/20";
        h3ClassList += " group-hover:text-primary transition-colors";
        pClassList += "text-gray-500 dark:text-gray-400 leading-relaxed mb-6";
        btnClassList += " flex items-center justify-center p-2 ";
    }
}

<div class="@standardClassList">
    <a href="/shop/cookie/@Id">
        @if (IsLimitedEdition)
        {
            <div class="rare-find-sash">Rare Find</div>
        }
        <div class="relative aspect-square rounded-2xl overflow-hidden mb-6 bg-white/20">

            @* 🐯 Case 1: Active Animation - Render both images *@
            @if (_isAnimating && PreviousVariant != null && CurrentVariant != null)
            {
                @* The Image Exiting (Old Variant) *@
                <img alt="Exiting Variant"
                     class="variant-image-slide group-hover:scale-105 transition-transform duration-700
                        @(_animationDirection == "next" ? "animate-exit-left" : "animate-exit-right")"
                     src="@PreviousVariant.ImageUrls.First()" />

                @* The Image Entering (New Variant) *@
                <img alt="Entering Variant"
                     class="variant-image-slide group-hover:scale-105 transition-transform duration-700
                        @(_animationDirection == "next" ? "animate-enter-right" : "animate-enter-left")"
                     src="@CurrentVariant.ImageUrls.First()" />
            }
            @* 🐯 Case 2: Idle State - Render only the current image (Static) *@
            else if (CurrentVariant != null)
            {
                <img alt="@CookieTitle"
                     class="variant-image-slide group-hover:scale-105 transition-transform duration-700"
                     src="@CurrentVariant.ImageUrls.First()" />
            }

            @* Best Seller Badge - Keeps z-index higher than images *@
            <div class="absolute top-3 left-3 flex gap-2 z-10">
                @if (IsBestSeller)
                {
                    <div class="bg-white dark:bg-black/60 backdrop-blur text-xs font-bold px-2 py-1 rounded-md shadow-sm">
                        Best Seller
                    </div>
                }
            </div>
        </div>
        <div class="flex-grow">
            <div class="flex justify-between items-start mb-2">
                <h3 class="@h3ClassList">@CookieTitle</h3>
                <span class="@spanPriceClassList">@CurrencySymbol@Price.ToString("F2")</span>
            </div>
            <p class="@pClassList">
                @Description
            </p>
        </div>
    </a>
    @* 🐯 Flex container with a gap *@
    <div class="flex items-center gap-2 mt-4">

        @* Left Navigation Group *@
        <div class="flex items-center bg-gray-100 dark:bg-white/10 rounded-2xl p-1 border border-gray-200 dark:border-white/5">
            <button @onclick="PrevVariant"
                    class="size-10 flex items-center justify-center hover:text-primary transition-colors cursor-pointer active:scale-90">
                <span class="material-symbols-outlined text-xl">chevron_left</span>
            </button>

            @* 🐯 Middle Label for the variant name *@
            <span class="text-[10px] font-black uppercase tracking-widest px-2 min-w-[70px] text-center opacity-70">
                @CurrentVariant?.Title
            </span>

            <button @onclick="NextVariant"
                    class="size-10 flex items-center justify-center hover:text-primary transition-colors cursor-pointer active:scale-90">
                <span class="material-symbols-outlined text-xl">chevron_right</span>
            </button>
        </div>

        @* Right Side: Main Add to Cart Button (Flexible width) *@
        <button @onclick="async () => await AddToCartAsync()"
                disabled="@(isAddingToCart || showCheckMark)"
                class="@btnClassList flex-grow cursor-pointer flex items-center justify-center gap-3 transition-all duration-500 h-[50px]
            @(showCheckMark ? "bg-emerald-600 text-white"
                                            : IsLimitedEdition ? "bg-white text-brand-orange"
                                                               : "bg-primary text-white")
            disabled:opacity-90 disabled:cursor-not-allowed">

            @if (isAddingToCart)
            {
                <svg class="animate-spin size-5 text-white" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                <span class="font-bold text-sm">Adding...</span>
            }
            else if (showCheckMark)
            {
                <span class="material-symbols-outlined text-white animate-in zoom-in duration-300">check_circle</span>
                <span class="font-bold text-sm">Added!</span>
            }
            else
            {
                <span class="material-symbols-outlined">add_shopping_cart</span>
                <span class="font-bold text-sm">Add</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public bool IsBestSeller { get; set; }
    [Parameter] public bool IsLimitedEdition { get; set; }
    [Parameter] public string ImageUrl { get; set; } = string.Empty;
    [Parameter] public string CookieTitle { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public string CurrencySymbol { get; set; } = "$";
    [Parameter] public decimal Price { get; set; }

    // Animation State Tracking
    private int _currentVariantIndex = 0;
    private int? _previousVariantIndex = null;
    private string _animationDirection = "none"; // "next", "prev", or "none"
    private bool _isAnimating = false;

    private StorefrontProductDto? product = null;
    private bool isAddingToCart { get; set; } = false;
    private bool showCheckMark = false;
    private decimal DisplayPrice => CurrentVariant?.Price ?? Price;
    private string DisplayTitle => CurrentVariant != null ? $"{CookieTitle} ({CurrentVariant.Title})" : CookieTitle;
    private string DisplayImage => CurrentVariant?.ImageUrls.FirstOrDefault() ?? ImageUrl;
    
    private StorefrontProductVariantDto? CurrentVariant =>
        Variants != null && Variants.Any() ? Variants.ElementAt(_currentVariantIndex) : null;
    private StorefrontProductVariantDto? PreviousVariant =>
        _previousVariantIndex.HasValue ? Variants?.ElementAtOrDefault(_previousVariantIndex.Value) : null;

    protected override async Task OnInitializedAsync()
    {
        product = await CookieService.GetProductByIdAsync(Id);
    }

    private void NextVariant()
    {
        if (Variants == null || Variants.Count <= 1 || _isAnimating) return;
        TriggerAnimation("next", (_currentVariantIndex + 1) % Variants.Count);
    }

    private void PrevVariant()
    {
        if (Variants == null || Variants.Count <= 1 || _isAnimating) return;
        TriggerAnimation("prev", (_currentVariantIndex - 1 + Variants.Count) % Variants.Count);
    }

    private void TriggerAnimation(string direction, int nextIndex)
    {
        _isAnimating = true;
        _animationDirection = direction;
        _previousVariantIndex = _currentVariantIndex;
        _currentVariantIndex = nextIndex;

        // This triggers the render block to show both images
        StateHasChanged();

        // 🐯 Wait for animation duration (0.5s) before cleanup
        _ = CleanupAnimationAsync();
    }

    private async Task CleanupAnimationAsync()
    {
        await Task.Delay(550); // Slightly longer than CSS duration
        _previousVariantIndex = null;
        _animationDirection = "none";
        _isAnimating = false;
        StateHasChanged(); // Final render to remove the exiting image
    }

    private async Task AddToCartAsync()
    {
        if (isAddingToCart || showCheckMark) return;

        isAddingToCart = true;
        StateHasChanged();

        try
        {
            // Simulate the API call to your CartService
            if (CurrentVariant is not null)
                await CartService.AddToCartAsync(Id, CurrentVariant.Id, 1);
            else
                await CartService.AddToCartAsync(Id, 1);

            // 🐯 Transition to Success
            isAddingToCart = false;
            showCheckMark = true;
            StateHasChanged();

            // Keep the check mark for 2 seconds
            await Task.Delay(2000);
        }
        catch (Exception ex)
        {
            // Handle error logic here
        }
        finally
        {
            showCheckMark = false;
            isAddingToCart = false;
            StateHasChanged();
        }
    }

    private IReadOnlyList<StorefrontProductVariantDto> Variants =>
        product?.Variants is ICollection<StorefrontProductVariantDto> collection
            ? collection.ToList().AsReadOnly()
            : Array.Empty<StorefrontProductVariantDto>().AsReadOnly();
}