@using CookieCommerce.Web.Services
@inject IAuthService Auth

<footer class="bg-surface-light dark:bg-surface-dark pt-16 pb-8 border-t border-amber-100 dark:border-amber-900/30">
    <div class="container mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
            <div class="space-y-6">
                <div class="flex items-center gap-3">                    
                   <CookieCommerce.Web.Components.Layout._Logo />
                </div>
                <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">
                    Spreading joy one chunky cookie at a time. Baked with love and a little bit of wild spirit in every bite.
                </p>

                <!-- Our Socials -->
                <div class="flex gap-6">
                    <a class="group relative flex flex-col items-center text-gray-400 hover:text-primary transition-colors"
                       href="https://www.facebook.com/tigervancookie">
                        <span class="material-icons-round">facebook</span>
                        <span class="absolute -top-10 scale-0 transition-all rounded bg-primary p-2 text-xs text-white group-hover:scale-100 whitespace-nowrap">
                            Facebook
                        </span>
                    </a>

                    <a class="group relative flex flex-col items-center text-gray-400 hover:text-primary transition-colors"
                       href="https://www.instagram.com/tigervancookie">
                        <span class="material-icons-round">photo_camera</span>
                        <span class="absolute -top-10 scale-0 transition-all rounded bg-primary p-2 text-xs text-white group-hover:scale-100 whitespace-nowrap">
                            Instagram
                        </span>
                    </a>

                    <a class="group relative flex flex-col items-center text-gray-400 hover:text-primary transition-colors"
                       href="#">
                        <span class="material-icons-round">smart_display</span>
                        <span class="absolute -top-10 scale-0 transition-all rounded bg-primary p-2 text-xs text-white group-hover:scale-100 whitespace-nowrap">
                            YouTube
                        </span>
                    </a>

                    <a class="group relative flex flex-col items-center text-gray-400 hover:text-primary transition-colors"
                       href="mailto:info@tigervancookie.nl">
                        <span class="material-icons-round">alternate_email</span>
                        <span class="absolute -top-10 scale-0 transition-all rounded bg-primary p-2 text-xs text-white group-hover:scale-100 whitespace-nowrap">
                            Email
                        </span>
                    </a>
                </div>
                <!-- Our Socials -->

            </div>
            <div>
                <h4 class="font-display font-bold text-lg mb-6">Shop</h4>
                <ul class="space-y-4 text-sm text-gray-600 dark:text-gray-300">
                    <li><a class="hover:text-primary transition-colors" href="#">All Cookies</a></li>
                    <li><a class="hover:text-primary transition-colors" href="#">Gift Boxes</a></li>

                </ul>
            </div>
            <div>
                <h4 class="font-display font-bold text-lg mb-6">Support</h4>
                <ul class="space-y-4 text-sm text-gray-600 dark:text-gray-300">
                    <li><a class="hover:text-primary transition-colors" href="/contact">Contact Us</a></li>
                    <li><a class="hover:text-primary transition-colors" href="/faq">FAQs</a></li>
                    <li><a class="hover:text-primary transition-colors" href="#">Shipping &amp; Returns</a></li>
                    <li><a class="hover:text-primary transition-colors" href="/track">Track Order</a></li>
                </ul>
            </div>
            <div>
                <h4 class="font-display font-bold text-lg mb-6">My Account</h4>
                <ul class="space-y-4 text-sm text-gray-600 dark:text-gray-300">
                    @if(Auth.IsLoggedIn)
                    {
                        <li><a class="hover:text-primary transition-colors" href="/account">Dashboard</a></li>
                    }
                    else
                    {
                        <li><a class="hover:text-primary transition-colors" href="/auth/signin">Sign In</a></li>
                        <li><a class="hover:text-primary transition-colors" href="/auth/signup">Sign Up</a></li>
                    }
                    <li><a class="hover:text-primary transition-colors" href="/shop/cart">My Cart</a></li>
                    <li><a class="hover:text-primary transition-colors" href="/account/my-orders">Order History</a></li>
                    <li><a class="hover:text-primary transition-colors" href="/loyalty/my-rewards">Tiger Rewards</a></li>
                </ul>
            </div>
        </div>
        <div class="border-t border-amber-100 dark:border-amber-900/30 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
            <p class="text-xs text-gray-400 text-center md:text-left">
                © @DateTime.Now.Year Tiger van Cookie. All rights reserved.
            </p>
            <div class="flex gap-6 text-xs text-gray-400">
                <a class="hover:text-primary transition-colors" href="/legal/privacy">Privacy Policy</a>
                <a class="hover:text-primary transition-colors" href="/legal/terms">Terms of Service</a>
            </div>
        </div>
    </div>
</footer>
