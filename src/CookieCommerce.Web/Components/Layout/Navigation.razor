@using CookieCommerce.Web.Components.Auth
@using CookieCommerce.Web.Components.Layout
@using CookieCommerce.Web.Components.Storefront.Cart
@using CookieCommerce.Web.Components.Shared
@using CookieCommerce.Web.Services
@rendermode InteractiveServer
@inject IAuthService Auth


<nav class="sticky top-0 z-50 bg-background-light/90 dark:bg-background-dark/90 backdrop-blur-md border-b border-amber-100 dark:border-amber-900/30">
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">
        
        <a class="flex items-center gap-3 group" href="/storefront">
            <Logo />
        </a>

        <div class="hidden md:flex items-center gap-8 font-semibold">
            <!-- Navigate to Main Shop -->
            <NavLink class="hover:text-primary transition-colors" href="/storefront" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink class="hover:text-primary transition-colors" href="/shop" Match="NavLinkMatch.Prefix">Shop Cookies</NavLink>
            <NavLink class="hover:text-primary transition-colors" href="/our-story" Match="NavLinkMatch.All">Our Story</NavLink>
        </div>

        <div class="hidden md:flex items-center gap-4">

            <ToggleNightMode />
            <ShoppingBag />
            <AuthUserButton />          

        </div>

        <button class="lg:hidden w-10 h-10 flex flex-col items-center justify-center gap-1.5 focus:outline-none" @onclick="ToggleMenu">
            <div class="w-6 h-0.5 bg-current transition-all duration-300 @(isMenuOpen ? "rotate-45 translate-y-2" : "")"></div>
            <div class="w-6 h-0.5 bg-current transition-all duration-300 @(isMenuOpen ? "opacity-0" : "")"></div>
            <div class="w-6 h-0.5 bg-current transition-all duration-300 @(isMenuOpen ? "-rotate-45 -translate-y-2" : "")"></div>
        </button>

    </div>

</nav>

<!-- Mobile Menu -->
<div class="fixed inset-0 z-[100] lg:hidden transition-all duration-500 @(isMenuOpen ? "visible" : "invisible pointer-events-none")">
    <div class="fixed inset-0 bg-black/70 backdrop-blur-md" @onclick="ToggleMenu"></div>
    <div class="fixed top-1/2 left-1/2 -translate-x-1/2 transition-all duration-500 w-[90%] max-w-sm bg-white dark:bg-surface-dark rounded-[2.5rem] p-8 shadow-[0_35px_60px_-15px_rgba(0,0,0,0.5)] border border-white/20 dark:border-amber-900/30 @(isMenuOpen ? "opacity-100 -translate-y-1/2 scale-100" : "opacity-0 -translate-y-[40%] scale-95")">

        <div class="relative flex flex-col gap-6">
            <div class="flex justify-end">
                <button @onclick="ToggleMenu" class="w-8 h-8 flex items-center justify-center rounded-full bg-gray-100 dark:bg-white/10">
                    <span class="material-icons-round text-sm">close</span>
                </button>
            </div>

            <div class="flex flex-col gap-6 text-center">
                <div class="flex flex-col gap-2">
                    @foreach (var link in new[] { ("/storefront", "Home"), ("/shop", "Shop"), ("/our-story", "Our Story") })
                    {
                        <NavLink @onclick="ToggleMenu"
                                 class="text-3xl font-display font-bold py-2 hover:text-primary transition-colors"
                                 href="@link.Item1">
                            @link.Item2
                        </NavLink>
                    }
                </div>

                <div class="flex items-center justify-center gap-4 bg-gray-50 dark:bg-white/5 p-3 rounded-3xl">

                    <ToggleNightMode IsMobileMenu="true" />

                    <div class="w-px h-8 bg-gray-200 dark:bg-white/10"></div>

                    <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-white dark:bg-white/10 shadow-sm hover:scale-105 transition-all">
                        <ShoppingBag />
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-6 border-t border-amber-100 dark:border-amber-900/20 flex flex-col items-center gap-4">
                @if (Auth.IsLoggedIn)
                {
                    <span class="w-full text-center py-2 font-display font-bold uppercase opacity-50 text-sm tracking-wider">
                        Welcome, @Auth.CurrentUser!.FirstName 🐯
                    </span>
                    <button @onclick="() => { Auth.Logout(); ToggleMenu(); }" class="w-full py-4 rounded-2xl bg-red-50 dark:bg-red-500/10 text-red-500 font-bold">
                        Sign Out
                    </button>
                }
                else
                {
                    <a href="/auth/signin" @onclick="ToggleMenu" class="w-full bg-primary text-white text-center py-4 rounded-2xl font-bold block">
                        Sign In
                    </a>
                }
            </div>
        </div>
    </div>
</div>
<!-- Mobile Menu -->
@code {
    
    private bool isMenuOpen = false;

    [Inject] IJSRuntime JS { get; set; } = default!;

    protected override void OnInitialized()
    {
        Auth.OnChange += HandleStatusChange;
    }

    private void HandleStatusChange()
    {
        InvokeAsync(StateHasChanged);
    }    

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }

    public void Dispose()
    {
        Auth.OnChange -= HandleStatusChange;
    }
}