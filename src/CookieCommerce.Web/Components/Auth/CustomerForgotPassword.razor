@page "/auth/forgot-password"
@using System.ComponentModel.DataAnnotations
@using CookieCommerce.Web.Services
@rendermode InteractiveServer

@layout AuthLayout

<main class="flex-grow relative flex items-center justify-center py-12 px-6 overflow-hidden">
    <div class="absolute inset-0 pattern-bg pointer-events-none"></div>
    <div class="absolute top-20 left-10 opacity-20 -rotate-12 hidden lg:block">
        <span class="material-symbols-outlined !text-8xl text-primary">cookie</span>
    </div>
    <div class="absolute bottom-20 right-10 opacity-20 rotate-12 hidden lg:block">
        <span class="material-symbols-outlined !text-9xl text-primary">bakery_dining</span>
    </div>
    <div class="absolute top-1/2 left-1/4 opacity-10 rotate-45 hidden lg:block">
        <span class="material-symbols-outlined !text-7xl text-primary">restaurant</span>
    </div>
    <div class="w-full max-w-md relative">
        <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-40 h-40 z-20 drop-shadow-2xl">
            <img alt="Confused Baby Tiger Mascot" class="w-full h-full object-contain"
                 src="/images/logo.png" />
        </div>
        <div class="bg-white dark:bg-surface-dark p-8 md:p-10 rounded-3xl cookie-shadow border border-amber-50 dark:border-amber-900/20 relative z-10 overflow-hidden mt-20">
            <div class="absolute top-0 right-0 w-24 h-24 bg-amber-50 dark:bg-amber-900/10 rounded-bl-full -mr-12 -mt-12">
            </div>           

            @if (!isSent)
            {
                <div class="text-center mb-8 pt-4">
                    <h1 class="font-display font-bold text-3xl text-text-light dark:text-text-dark mb-4">
                        Lost Your Cookie Path?
                    </h1>
                    <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
                        Enter your email address and we'll send you a magic link to reset your password.
                    </p>
                </div>

                <form class="space-y-6" @onsubmit="HandleSubmit">
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-text-light dark:text-text-dark ml-1"
                               for="email">Email Address</label>
                        <input class="w-full px-5 py-4 rounded-2xl border-2 border-amber-100 dark:border-amber-900/30 bg-amber-50/30 dark:bg-background-dark/50 focus:bg-white transition-all outline-none"
                               id="email"
                               type="email"
                               placeholder="roar@tiger.com"
                               value="@Email"
                               @oninput="@((e) => { Email = e.Value?.ToString(); })" />
                    </div>

                    <button class="w-full py-4 rounded-2xl font-bold text-lg shadow-lg transition-all
                @(IsEmailValid()
                                            ? "bg-primary hover:bg-amber-700 text-white shadow-amber-500/30 hover:-translate-y-1 active:translate-y-0 cursor-pointer"
                                            : "bg-gray-300 text-gray-500 cursor-not-allowed")"
                            disabled="@(!IsEmailValid() || isProcessing)"
                            type="submit">
                        @if (isProcessing)
                        {
                            <span class="animate-pulse">Tracking the scent...</span>
                        }
                        else
                        {
                            <span>Send Reset Link</span>
                        }
                    </button>
                </form>
            }
            else
            {
                <div class="text-center space-y-6 animate-in fade-in zoom-in duration-500 mt-5">
                    <div class="inline-flex items-center justify-center w-20 h-20 bg-amber-100 dark:bg-amber-900/30 rounded-full mb-2">
                        <span class="material-symbols-outlined text-4xl text-primary">mail_lock</span>
                    </div>

                    <div class="space-y-3 text-center">
                        <div class="inline-flex items-center gap-3 border-4 border-green-500/30 dark:border-green-400/20 px-4 py-1 rounded-xl -rotate-3 mb-2 bg-green-50/50 dark:bg-green-900/10">
                            <span class="material-symbols-outlined text-green-600 dark:text-green-400 font-bold">
                                pets
                            </span>
                            <h2 class="text-2xl font-black text-green-600 dark:text-green-400 uppercase tracking-tighter">
                                Scent Detected!
                            </h2>
                        </div>

                        <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
                            If that email exists in our jungle, a magic link is pouncing toward your inbox right now.
                        </p>
                    </div>

                    <div class="bg-amber-50/50 dark:bg-amber-900/10 p-4 rounded-2xl border border-amber-100 dark:border-amber-900/20">
                        <p class="text-sm text-amber-800 dark:text-amber-200">
                            <span class="font-bold">Tiger Tip:</span> Don't let the link get lost in the tall grass! Check your <strong>Spam or Junk folder</strong> if it doesn't arrive in a few minutes.
                        </p>
                    </div>

                    <button @onclick="() => isSent = false" class="cursor-pointer text-sm text-primary font-bold hover:underline">
                        Didn't get it? Try another email
                    </button>
                </div>
            }

            <div class="mt-8 text-center">
                <a class="text-primary font-bold inline-flex items-center gap-2 group" href="/auth/signin">
                    <span class="material-icons-round text-sm group-hover:-translate-x-1 transition-transform no-underline">arrow_back</span>
                    <span class="group-hover:underline">Back to Login</span>
                </a>
            </div>
        </div>
    </div>
</main>

@code {
    [Inject] public IAuthService Auth { get; set; }
    private string Email { get; set; } = string.Empty;
    private bool isSent = false;
    private bool isProcessing = false;

    private async Task HandleSubmit()
    {
        if (IsEmailValid() && !isProcessing)
        {
            isProcessing = true;
            try
            {
                // Hit your service at 192.168.0.195
                await Auth.SendForgotPasswordLinkAsync(Email);
                isSent = true;
            }
            finally
            {
                isProcessing = false;
            }
        }
    }

    private bool IsEmailValid()
    {
        if (string.IsNullOrWhiteSpace(Email)) return false;
        try
        {
            var address = new System.Net.Mail.MailAddress(Email);
            return address.Address == Email && Email.Contains(".");
        }
        catch { return false; }
    }
}