@page "/shop/checkout"
@using CookieCommerce.Web.Models.Auth
@using CookieCommerce.Web.Models.Cart
@using CookieCommerce.Web.Models.Addresses
@using CookieCommerce.Web.Models.Checkout
@using CookieCommerce.Web.Services
@using CookieCommerce.Web.Services.Commerce
@rendermode InteractiveServer
@layout CheckoutLayout
@inject IAuthService Auth
@inject NavigationManager Navigation
@inject ICartService CartService
@inject ICheckoutService CheckoutService

<main class="container mx-auto px-6 py-12">
    <div class="flex flex-col lg:flex-row gap-6">
        <div class="lg:w-2/3 space-y-6">
            <CheckoutCustomerInformation CurrentStep="currentStep" User="User"
                @bind-CheckoutEmail="CheckoutEmail" @bind-ShouldCreateAccount="shouldCreateAccount"
                @bind-Password="Password" @bind-ConfirmPassword="ConfirmPassword"
                CurrentStepChanged="step => currentStep = step" />
            <ContactAndShipping @bind-CurrentStep="currentStep" @bind-SelectedShippingAddress="shippingAddressDto"
                @bind-SelectedBillingAddress="billingAddressDto" @bind-SameAsShipping="SameAsShipping"
                HasExistingAccount="@(User is not null)" />
            <DeliveryMethodSelector @bind-CurrentStep="currentStep" SelectedShippingAddress="shippingAddressDto"
                SelectedDelivery="selectedDelivery" SelectedDeliveryChanged="DeliveryChangedAsync" />
            @if (currentStep == 4)
            {
                <section class="bg-white dark:bg-surface-dark rounded-2xl border border-amber-100 p-8">
                    <h2 class="font-display font-bold text-xl">Secure payment</h2>
                    <p class="mt-4">Continue to our payment partner to choose your payment method and complete your purchase.</p>
                    <p class="mt-4 text-sm">Your order will be confirmed once payment is received.</p>
                </section>
            }
            @if (!string.IsNullOrEmpty(error))
            {
                <p role="alert" class="text-red-600 bg-red-50 p-4 rounded-xl">@error</p>
                <button type="button" @onclick="CancelCheckoutAsync" class="text-primary underline">Cancel checkout and edit cart</button>
            }
        </div>
        <CheckoutCookieJar AllCheckoutStepsComplete="@(currentStep == 4 && !submitting)" OnCheckout="PlaceOrderAsync" />
    </div>
</main>

@code {
    [SupplyParameterFromQuery(Name = "cancelled")] public bool Cancelled { get; set; }
    private int currentStep = 1;
    private UserDto? User;
    private bool shouldCreateAccount;
    private DeliveryInfoDto? selectedDelivery;
    private string Password = "";
    private string ConfirmPassword = "";
    private string CheckoutEmail = "";
    private AddressBookItemDto? shippingAddressDto;
    private AddressBookItemDto? billingAddressDto;
    private bool SameAsShipping = true;
    private bool submitting;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Auth.InitializeAsync();
        User = Auth.CurrentUser;
        CheckoutEmail = User?.Email ?? "";
        if (Cancelled) await CancelCheckoutAsync();
        StateHasChanged();
    }

    private async Task DeliveryChangedAsync(DeliveryInfoDto? delivery)
    {
        selectedDelivery = delivery;
        if (CartService is CartService persistent) await persistent.SetShippingAsync(delivery?.Price);
    }

    private async Task CancelCheckoutAsync()
    {
        if (CheckoutService is CookieCommerce.Web.Services.Commerce.CheckoutService service && await service.CancelPendingAsync()) Navigation.NavigateTo("/shop/cart");
        else error = "Payment may already be in progress. Check your order status before trying again.";
    }
    private async Task PlaceOrderAsync()
    {
        if (submitting) return;
        error = null;
        if (shippingAddressDto is null || (!SameAsShipping && billingAddressDto is null) || selectedDelivery is null)
        { error = "Complete the shipping, billing and delivery steps."; return; }
        submitting = true;
        try
        {
            AnonymousCheckoutRequest request = User is not null
                ? new ExistingCustomerCheckoutRequest { UserId = User.Id.ToString() }
                : shouldCreateAccount
                    ? new NewCustomerCheckoutRequest { Password = Password, ConfirmPassword = ConfirmPassword }
                    : new GuestCheckoutRequest();
            request.CartId = (await CartService.GetCartAsync()).CartId.ToString();
            request.FristName = shippingAddressDto.FirstName;
            request.LastName = shippingAddressDto.LastName;
            request.Email = User?.Email ?? CheckoutEmail;
            request.ShippingAddress = MapAddress(shippingAddressDto);
            request.BillingAddress = MapAddress(SameAsShipping ? shippingAddressDto : billingAddressDto!);
            request.DeliveryMethod = selectedDelivery.Title;
            request.PaymentMethod = "online";
            var result = request switch
            {
                ExistingCustomerCheckoutRequest customer => await CheckoutService.CheckoutExistingCustomerAsync(customer),
                NewCustomerCheckoutRequest customer => await CheckoutService.CheckoutNewCustomerAsync(customer),
                GuestCheckoutRequest guest => await CheckoutService.CheckoutGuestAsync(guest),
                _ => throw new InvalidOperationException()
            };
            if (result.Success && result.PaymentUrl is not null) Navigation.NavigateTo(result.PaymentUrl, forceLoad: true);
            else error = result.Message;
        }
        catch (Exception) { error = "Unable to start payment. Please try again."; }
        finally { submitting = false; }
    }

    private static AddressDto MapAddress(AddressBookItemDto address) => new()
    {
        FirstName = address.FirstName, LastName = address.LastName,
        Street = address.Street, HouseNumber = address.HouseNumber, HouseNumberAddition = address.HouseNumberAddition,
        City = address.City, PostalCode = address.PostalCode, Province = address.Province, Country = address.Country
    };
}
