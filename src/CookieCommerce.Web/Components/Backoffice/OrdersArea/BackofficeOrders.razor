@page "/backoffice/orders/"
@namespace CookieCommerce.Web.Components.Backoffice.OrdersArea
@using CookieCommerce.Web.Models.Backoffice
@using CookieCommerce.Web.Models.Order
@using CookieCommerce.Web.Services
@using CookieCommerce.Web.Services.StaticData
@rendermode InteractiveServer
@layout BackofficeLayout
@inject IBackofficeService BackofficeService

<style>
    @@keyframes shimmer {
        0% {
            background-position: -200% 0;
        }

        100% {
            background-position: 200% 0;
        }
    }

    .animate-skeleton {
        background: linear-gradient(90deg, rgba(251, 191, 36, 0.05) 25%, rgba(251, 191, 36, 0.15) 50%, rgba(251, 191, 36, 0.05) 75%);
        background-size: 200% 100%;
        animation: shimmer 2s infinite linear;
    }
</style>

<div class="grid grid-cols-12 gap-6 mb-8 items-start">
    <div class="col-span-12 lg:col-span-4 xl:col-span-3">
        <QuotaCookiesRequired IsLoading="isLoadingTodaysQuotaOrders"
                              QuotaItems="quotaDateOrders.Items" />
    </div>
    <div class="col-span-12 lg:col-span-8 xl:col-span-9">
        <QuotaOrdersTable Orders="quotaDateOrders.Orders"
                          IsLoading="isLoadingTodaysQuotaOrders"
                          Shortfalls="shortfalls" />
    </div>
</div>

@code {

    private QuotaDateOrdersDto quotaDateOrders = new();
    private bool isLoadingTodaysQuotaOrders = false;
    private Dictionary<Guid, IReadOnlyList<MissingCookieDto>> shortfalls = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTodaysQuotaOrders();
    }

    public async Task LoadTodaysQuotaOrders()
    {
        isLoadingTodaysQuotaOrders = true;
        quotaDateOrders = await BackofficeService.GetQuotaDateOrdersAsync(DateTime.Now.Date);
        shortfalls = ComputeFifoShortfalls(quotaDateOrders.Orders);
        isLoadingTodaysQuotaOrders = false;
    }

    private static Dictionary<Guid, IReadOnlyList<MissingCookieDto>> ComputeFifoShortfalls(
        IEnumerable<QuotaOrderDto> orders)
    {
        var date = DateOnly.FromDateTime(DateTime.Now.Date);
        var stock = MockInventoryData.GetAvailableStockForDate(date);
        var result = new Dictionary<Guid, IReadOnlyList<MissingCookieDto>>();

        foreach (var order in orders.OrderBy(o => o.PlacedOn))
        {
            var missing = new List<MissingCookieDto>();
            foreach (var line in order.Items)
            {
                if (string.IsNullOrEmpty(line.ProductReference)) continue;
                int available = stock.GetValueOrDefault(line.ProductReference, 0);
                int fulfilled = Math.Min(available, line.Quantity);
                stock[line.ProductReference] = available - fulfilled;
                int missingQty = line.Quantity - fulfilled;
                if (missingQty > 0)
                    missing.Add(new MissingCookieDto(line.ProductName, missingQty));
            }
            result[order.Id] = missing;
        }
        return result;
    }
}