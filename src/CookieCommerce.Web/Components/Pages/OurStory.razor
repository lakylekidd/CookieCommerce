@page "/our-story"
@using CookieCommerce.Web.Components.Features.Shop
@layout ShopLayout

<main class="flex-grow">
    <section class="relative overflow-hidden pt-20 pb-32">
        <div class="absolute inset-0 pattern-bg pointer-events-none"></div>
        <div class="container mx-auto px-6 relative z-10 flex flex-col items-center text-center">
            <div class="mb-8 relative">
                <div class="w-48 h-48 bg-secondary rounded-full flex items-center justify-center border-4 border-white shadow-xl rotate-3">
                    <span class="text-8xl">🐅</span>
                </div>
                <div class="absolute -bottom-4 -right-4 bg-white dark:bg-surface-dark px-4 py-2 rounded-full shadow-lg border border-amber-100 dark:border-amber-900/30 font-display font-bold text-primary italic">
                    ROAR!
                </div>
            </div>
            <h1 class="font-display text-6xl md:text-8xl font-bold mb-6 text-text-light dark:text-text-dark tracking-tight">
                The Legend of the <span class="text-primary">Cookie Tiger</span>
            </h1>
            <p class="text-xl md:text-2xl max-w-2xl text-amber-900/70 dark:text-amber-100/70 font-medium">
                Every great cookie has a story. Ours involves a lot of YouTube, a bit of luck, and one very confused
                Tiger.
            </p>
        </div>
    </section>

    <div class="container mx-auto px-6 mb-24">
        <div class="flex items-center justify-center gap-6 py-10 bg-surface-light dark:bg-surface-dark rounded-[40px] border border-amber-100 dark:border-amber-900/30 shadow-sm max-w-xl mx-auto">
        
            <div class="flex flex-col items-center min-w-[100px]">
                <span class="text-4xl mb-3">🇳🇱</span>
                <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-amber-900/60 dark:text-amber-100/50">Dutch Roots</span>
            </div>

            <div class="flex items-center gap-2 flex-grow max-w-[150px]">
                <div class="h-px border-b-2 border-dashed border-primary flex-grow"></div>
                <span class="material-symbols-outlined text-primary text-8xl animate-pulse" style="font-variation-settings: 'FILL' 1;">
                    cookie
                </span>
                <div class="h-px border-b-2 border-dashed border-primary flex-grow"></div>
            </div>

            <div class="flex flex-col items-center min-w-[100px]">
                <span class="text-4xl mb-3">🐅</span>
                <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-amber-900/60 dark:text-amber-100/50">Taiwanese Soul</span>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-6 space-y-24 mb-32">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="bg-surface-light dark:bg-surface-dark p-12 rounded-[3rem] shadow-xl shadow-amber-900/5 border border-amber-100 dark:border-amber-900/30">
                <span class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-4 block">
                    Chapter One
                </span>
                <h2 class="font-display text-4xl font-bold mb-6">The Nickname</h2>
                <p class="text-lg leading-relaxed text-amber-900/80 dark:text-amber-100/80 mb-6">
                    When I first started calling my husband Tiger, I didn’t realize that here in the Netherlands, 
                    it carries a bit of a "naughty" wink. To me, he was just my Tiger—my partner in life, travel, 
                    and most importantly, food.
                </p>
                <p class="text-lg  text-amber-900/80 dark:text-amber-100/80 mb-6">
                    We are obsessed foodies. Our YouTube "Watch Later" lists are graveyards of thousands of 
                    recipes we promised to try but never did. We spent more time watching people bake than 
                    actually picking up a whisk.
                </p>
                <div class="flex items-center gap-4 p-4 bg-amber-50 dark:bg-white/5 rounded-2xl border border-amber-100 dark:border-amber-800/30">
                    <span class="material-symbols-outlined text-primary text-3xl">sentiment_very_satisfied</span>
                    <p class="text-sm italic">
                        The name 'Tiger' in the Netherlands has a slightly different nuance
                        than we first thought... we're keeping it anyway.
                    </p>
                </div>
            </div>
            <div class="flex justify-center">
                <div class="polaroid rotate-3 max-w-sm">
                    <img alt="First Batch" class="w-full h-64 object-cover grayscale-[0.2] mb-4"
                         src="/images/logo.png" />
                    <p class="font-display text-xl text-center text-gray-700">The First Batch (2026)</p>
                </div>
            </div>
        </div>
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div class="order-2 lg:order-1 flex justify-center">
                <div class="bg-red-600 text-white p-8 rounded-3xl shadow-2xl flex flex-col items-center w-full max-w-sm">
                    <div class="flex items-center gap-2 mb-4">
                        <span class="material-symbols-outlined text-4xl">video_library</span>
                        <span class="font-bold text-xl">YouTube Counter</span>
                    </div>
                    <div class="text-5xl font-display font-bold mb-2">1,432</div>
                    <p class="text-center text-red-100 text-sm">
                        saved recipes, but this is the ONE that made the
                        cut.
                    </p>
                </div>
            </div>
            <div class="order-1 lg:order-2 bg-surface-light dark:bg-surface-dark p-12 rounded-[3rem] shadow-xl shadow-amber-900/5 border border-amber-100 dark:border-amber-900/30">
                <span class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-4 block">
                    Chapter Two
                </span>
                <h2 class="font-display text-4xl font-bold mb-6">The Solo Bake</h2>
                <p class="text-lg leading-relaxed text-amber-900/80 dark:text-amber-100/80 mb-6">
                   One afternoon, while Tiger was at work, the sweet tooth won. I was home alone, 
                   scrolling through that massive list of saved videos, and I finally picked one. 
                   It was a simple cookie recipe. I didn't expect much—I just wanted something sweet.
                </p>
                <p class="text-lg text-amber-900/80 dark:text-amber-100/80">
                    But when they came out of the oven, they were perfect. The symmetry was like art. 
                    I snapped a photo and sent it to Tiger at the office.
                </p>
            </div>
        </div>
        <div class="bg-surface-light dark:bg-surface-dark p-12 rounded-[3rem] shadow-xl shadow-amber-900/5 border border-amber-100 dark:border-amber-900/30">
            <div class="max-w-3xl mx-auto text-center">
                <span class="text-sm font-bold uppercase tracking-[0.2em] text-primary mb-4 block">
                    Chapter Three
                </span>
                <h2 class="font-display text-4xl font-bold mb-6">The 'Aha' Moment</h2>
                <p class="text-lg leading-relaxed text-amber-900/80 dark:text-amber-100/80 mb-8">
                    Usually, when I pitch a new business idea to Tiger, he’s supportive, but the 
                    "spark" isn't always there. This time was different.
                </p>
                <div class="inline-flex items-center mb-8 gap-3 px-6 py-3 bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-300 rounded-full font-bold">
                    <span class="material-symbols-outlined">chat</span>
                    "You need to sell these. Now."
                </div>
                <p class="text-lg text-amber-900/80 dark:text-amber-100/80">
                    That was the moment. For the first time, the enthusiasm was mutual. 
                    The tech-lover and the sweet-tooth dreamer finally found their shared mission. Today, we aren’t a factory. 
                    We are just two people in a kitchen, baking together, taking photos of our creations, and obsessing 
                    over every chocolate chip. We just made our very first sale to a friend, and now, we’re building 
                    this digital home to share our "accidental" cookies with you. We don't just bake them; we live them. 
                    And we promise: <b>they taste even better than they look</b>
                </p>
            </div>
        </div>
    </div>
    <section class="bg-amber-100/50 dark:bg-white/5 py-24">
        <div class="container mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="font-display text-5xl font-bold mb-4">The Journey from Screen to Oven</h2>
                <h3 class="font-display text-2xl mb-2">(The four T's)</h3>
                <div class="w-24 h-1 bg-primary mx-auto rounded-full"></div>
            </div>
            <div class="relative timeline-line max-w-4xl mx-auto">
                <div class="relative z-10 flex flex-col md:flex-row items-center gap-8 mb-20">
                    <div class="md:w-1/2 md:text-right">
                        <h4 class="font-display text-2xl font-bold text-primary">The List</h4>
                        <p class="text-amber-900/60 dark:text-amber-100/60">Watching 1,000+ recipes (2020-2025)</p>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-primary border-4 border-white dark:border-surface-dark shadow flex items-center justify-center text-white">
                        <span class="material-symbols-outlined text-sm">visibility</span>
                    </div>
                    <div class="md:w-1/2"></div>
                </div>
                <div class="relative z-10 flex flex-col md:flex-row items-center gap-8 mb-20">
                    <div class="md:w-1/2 order-3 md:order-1"></div>
                    <div class="w-12 h-12 rounded-full bg-primary border-4 border-white dark:border-surface-dark shadow flex items-center justify-center text-white order-2">
                        <span class="material-symbols-outlined text-sm">oven_gen</span>
                    </div>
                    <div class="md:w-1/2 order-1 md:order-3">
                        <h4 class="font-display text-2xl font-bold text-primary">The Bake</h4>
                        <p class="text-amber-900/60 dark:text-amber-100/60">The afternoon Tiger was at work</p>
                    </div>
                </div>
                <div class="relative z-10 flex flex-col md:flex-row items-center gap-8 mb-20">
                    <div class="md:w-1/2 md:text-right">
                        <h4 class="font-display text-2xl font-bold text-primary">The Text</h4>
                        <p class="text-amber-900/60 dark:text-amber-100/60">
                            The WhatsApp message that changed
                            everything
                        </p>
                    </div>
                    <div class="w-12 h-12 rounded-full bg-primary border-4 border-white dark:border-surface-dark shadow flex items-center justify-center text-white">
                        <span class="material-symbols-outlined text-sm">send</span>
                    </div>
                    <div class="md:w-1/2"></div>
                </div>
                <div class="relative z-10 flex flex-col md:flex-row items-center gap-8">
                    <div class="md:w-1/2 order-3 md:order-1"></div>
                    <div class="w-12 h-12 rounded-full bg-primary border-4 border-white dark:border-surface-dark shadow flex items-center justify-center text-white order-2">
                        <span class="material-symbols-outlined text-sm">local_shipping</span>
                    </div>
                    <div class="md:w-1/2 order-1 md:order-3">
                        <h4 class="font-display text-2xl font-bold text-primary">The Pack</h4>
                        <p class="text-amber-900/60 dark:text-amber-100/60">First sale (Feb 2026)</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</main>