@using CookieCommerce.Web.Models.Reviews
@using CookieCommerce.Web.Services.Products
@using CookieCommerce.Web.Models.Products
@inject ICookieService CookieService

<style>
    .reviews-viewport {
        --items-per-view: 1;
    }

    @@media (min-width: 768px) {
        .reviews-viewport {
            --items-per-view: 3;
        }
    }
</style>

<section class="py-20 mt-12 bg-secondary dark:bg-surface-dark/30">
    <div class="container mx-auto px-6">
        <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-text-light dark:text-text-dark">
                What Cookie Lovers Say
            </h2>
        </div>
        <div class="relative group reviews-viewport">
            <div class="overflow-hidden">
                <div class="flex transition-transform duration-500 ease-in-out py-4"
                     style="transform: translateX(calc(-100% * @(_currentIndex) / var(--items-per-view)));">

                    @foreach (var review in Reviews.Concat(Reviews))
                    {
                        var initials = new string(review.Author?.Where(char.IsUpper).Take(2).ToArray() ?? []);

                        <div class="w-full md:w-1/3 flex-shrink-0 px-4">
                            <div class="bg-white dark:bg-surface-dark p-8 rounded-3xl border border-amber-100 dark:border-amber-900/30 shadow-sm relative h-full">
                                <div class="absolute -top-4 left-8 text-6xl text-primary font-serif leading-none">“</div>
                                <div class="flex gap-1 mb-4">
                                    @foreach (var i in Enumerable.Range(0, review.Rating))
                                    {
                                        <span class="material-icons-round text-amber-400 text-sm">star</span>
                                    }
                                </div>
                                <p class="text-gray-600 dark:text-gray-300 italic mb-8 leading-relaxed">
                                    "@review.Content"
                                </p>
                                <div class="flex items-center gap-4">
                                    @if (string.IsNullOrEmpty(review.ProfileImageUrl))
                                    {
                                        <div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center font-bold text-primary">
                                            @initials
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-primary/20">
                                            <img alt="@review.Author"
                                                 class="w-full h-full object-cover"
                                                 src="@review.ProfileImageUrl" />
                                        </div>
                                    }
                                    <div>
                                        <h4 class="font-bold text-text-light dark:text-text-dark">@review.Author</h4>
                                        <span class="text-xs text-gray-400 uppercase tracking-wider font-bold">
                                            Verified
                                            Buyer
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @if (Reviews.Count > 1)
            {
                <button @onclick="() => Navigate(-1)"
                        class="absolute -left-4 top-1/2 -translate-y-1/2 size-12 rounded-full bg-white dark:bg-surface-dark text-primary shadow-xl 
                               hover:scale-110 active:scale-95 transition-all flex items-center justify-center cursor-pointer z-10 opacity-30 hover:opacity-100">
                    <span class="material-icons-round">chevron_left</span>
                </button>

                <button @onclick="() => Navigate(1)"
                        class="absolute -right-4 top-1/2 -translate-y-1/2 size-12 rounded-full bg-white dark:bg-surface-dark text-primary shadow-xl 
                               hover:scale-110 active:scale-95 transition-all flex items-center justify-center cursor-pointer z-10 opacity-30 hover:opacity-100">
                    <span class="material-icons-round">chevron_right</span>
                </button>
            }
        </div>
    </div>
</section>

@code {
    [Parameter] public Guid Id { get; set; }

    private IReadOnlyList<ReviewDto> Reviews { get; set; } = [];
    private int _currentIndex = 0;

    protected override async Task OnInitializedAsync()
    {
        Reviews = await CookieService.GetReviewsByCookieIdAsync(Id);
    }

    private void Navigate(int direction)
    {
        if (Reviews.Count == 0) return;
        _currentIndex = (_currentIndex + direction + Reviews.Count) % Reviews.Count;
    }
}