<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="9.0.4" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.2" />
    <ProjectReference Include="..\CookieCommerce.DevBootstrap\CookieCommerce.DevBootstrap.csproj" />
    <ProjectReference Include="..\CookieCommerce.ServiceDefaults\CookieCommerce.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Fonts\*.ttf" />
  </ItemGroup>

  <Target Name="Tailwind" AfterTargets="Build" Condition="'$(SkipTailwind)' != 'true'">
    <Message Importance="high" Text="Building Tailwind CSS..." />
    <Exec Command="npx tailwindcss -i ./Styles/app.css -o ./wwwroot/css/app.min.css --minify" />
  </Target>

</Project>
