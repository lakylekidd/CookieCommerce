@using System.Globalization

<div class="group p-4 rounded-xl bg-surface-light col-span-6 sm:col-span-6 lg:col-span-3 xl:col-span-2
            dark:bg-surface-dark shadow-sm border border-amber-100/50
            dark:border-zinc-800 flex flex-col justify-between h-28 transition-all">
    <div class="flex justify-between items-start">
        <span class="text-[11px] font-bold text-gray-400 dark:text-zinc-500 uppercase tracking-widest">
            @if (SelectedDate == DateOnly.FromDateTime(DateTime.Today))
            {
                @:Daily Quota
            }
            else
            {
                @:Quota on @SelectedDate.ToString("ddd d MMM")
            }
        </span>
        <div class="w-10 h-1 bg-gray-100 dark:bg-zinc-800 rounded-full mt-2 overflow-hidden">
            <div class="bg-primary h-full" style="width: @((int)Math.Min(100, Percentage * 100))%"></div>
        </div>
    </div>
    <div>
        <h3 class="text-2xl font-black text-primary dark:text-amber-500">@QuotaDisplay</h3>
        <p class="text-[10px] text-gray-400 dark:text-zinc-600">@UnitsLeft.ToString("N0", CultureInfo.InvariantCulture) units left</p>
    </div>
</div>

@code {
    [Parameter] public double Percentage { get; set; }
    [Parameter] public int UnitsLeft { get; set; }
    [Parameter] public int CurrentQuota { get; set; }
    [Parameter] public DateOnly SelectedDate { get; set; }

    private string QuotaDisplay =>
        CurrentQuota > 0
            ? $"{Percentage:P1}"
            : "—";
}
