@page "/account/overview"
@rendermode InteractiveServer
@layout AccountLayout

<style>
    @@theme {
        --color-primary: #F59E0B;
        --color-secondary: #92400E;
        --color-background-light: #FFFBEB;
        --color-background-dark: #1F1D18;
        --color-card-light: #FFFFFF;
        --color-card-dark: #2D2A26;
        --color-accent-light: #FEF3C7;
        --color-accent-dark: #453825;
    }
</style>

<main class="flex-grow max-w-7xl w-full mx-auto px-6 py-8 flex flex-col md:flex-row gap-8">
    <AccountASide />
    <div class="flex-grow space-y-8">
        <WelcomeHeaderWithPointsRedemable />
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <PersonalDetailsCard />
            <DefaultShippingCard />
        </div>
        <RecentOrdersCard />
        <ReorderYourFavoritesArea />
    </div>
</main>