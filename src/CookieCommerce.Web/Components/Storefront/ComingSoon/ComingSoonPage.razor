@page "/coming-soon"

@layout ComingSoonLayout
@rendermode InteractiveServer
@using System.Net.Http
@using CookieCommerce.Web.Components.Shared
@inject HttpClient Http

<style>
    /* The Shadow Pulsing */
    .shadow-element {
        width: 60%;
        height: 20px;
        background: rgba(0, 0, 0, 0.15); /* Soft dark shadow */
        border-radius: 50%;
        position: absolute;
        bottom: -15px; /* Positioned below the image */
        filter: blur(8px);
        animation: shadow-pulse 4s ease-in-out infinite;
        z-index: 0;
    }

    .floating {
        animation: float 4s ease-in-out infinite
    }

    /* Syncing the animations */
    @@keyframes float {
        0%, 100% {
            transform: translateY(0px);
        }
        50% {
            transform: translateY(-20px);
        }
        /* Bouncing higher for better effect */
    }

    @@keyframes shadow-pulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(0.6); /* Shrink as image goes up */
            opacity: 0.6; /* Fade as image goes up */
        }
    }
</style>

<div class="min-h-screen min-h-[100dvh] w-full flex items-center justify-center p-4 bg-amber-50/30 dark:bg-black/10">    
    <div class="absolute inset-0 pattern-bg pointer-events-none"></div>    
    <main class="relative bg-amber-100 dark:bg-surface-dark max-w-[700px] bg-off-white rounded-3xl p-8 md:p-12 overflow-hidden border border-amber-50 dark:border-amber-900/20 card-shadow">
        <div class="absolute -left-[45px] top-[25px] w-[180px] bg-[#f41e4d] text-white py-2 text-center font-black text-xs tracking-widest rotate-[-45deg] shadow-lg border-b-2 border-red-700 z-10">
            COMING SOON
        </div>

        <div class="absolute top-8 right-8 md:top-8 md:right-8 flex items-center gap-2">
            @* Dark Mode Toggle *@
            <ToggleNightMode />

            @* Instagram Link *@
            <a class="w-10 h-10 flex items-center justify-center text-cookie-brown/40 hover:text-cookie-brown transition-colors"
               href="https://www.instagram.com/tigervancookie"
               target="_blank">
                <svg class="w-7 h-7" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.791-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.209-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z">
                    </path>
                </svg>
            </a>
        </div>
        <div class="flex justify-center mb-10">
            <div class="relative w-56 h-56 md:w-64 md:h-64">
                <img alt="Tiger Mascot eating cookie" class="w-full h-full object-contain floating"
                     src="/images/logo.png" />
                <div class="shadow-element"></div>
            </div>
        </div>
        <div class="text-center space-y-2 mb-10">
            <h1 class="font-display font-bold text-4xl md:text-5xl text-cookie-brown tracking-tight">
                <span class="font-display font-bold tracking-tight">Tiger</span>
                <span class="font-display font-bold text-primary tracking-tight -ml-1">van Cookie</span>
            </h1>
            <h2 class="font-display font-medium text-2xl md:text-3xl text-cookie-brown/80">Homemade Cookies</h2>
            <p class="text-sm md:text-base text-cookie-brown/60 max-w-sm mx-auto pt-4 leading-relaxed">
                Enter your e-mail address and we will notify you when we're open for business!
            </p>
        </div>
        <div class="max-w-2xl mx-auto min-h-[80px] flex items-center justify-center">
            @if (!IsSuccess)
            {
                <form @onsubmit="HandleSubmit" @onsubmit:preventDefault
                      class="flex flex-col md:flex-row items-center bg-white dark:bg-surface-dark p-1.5 
                                rounded-xl shadow-lg border border-amber-100 dark:border-amber-900/30 gap-2
                                w-full transition-all duration-500 @(IsSubmitting ? "opacity-50 pointer-events-none scale-95" : "")">

                    @* Name Input *@
                    <div class="flex items-center flex-1 px-4 w-full">
                        <span class="material-icons-round text-primary/50 mr-2">person</span>
                        <input type="text" @bind="Name" placeholder="Full Name"
                               class="w-full bg-transparent border-none focus:ring-0 text-text-light dark:text-text-dark placeholder:text-gray-400 py-3" />
                    </div>

                    <div class="hidden md:block w-px h-8 bg-amber-100 dark:bg-amber-900/30"></div>

                    @* Email Input *@
                    <div class="flex items-center flex-1 px-4 w-full">
                        <span class="material-icons-round text-primary/50 mr-2">email</span>
                        <input type="email" @bind="Email" required placeholder="Enter your email..."
                               class="w-full bg-transparent border-none focus:ring-0 text-text-light dark:text-text-dark placeholder:text-gray-400 py-3" />
                    </div>

                    @* Submit Button / Loading *@
                    <button type="submit" disabled="@IsSubmitting"
                            class="cursor-pointer w-full md:w-auto bg-surface-dark dark:bg-primary text-white dark:text-text-dark px-8 py-3 rounded-2xl font-bold hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center min-w-[140px]">
                        @if (IsSubmitting)
                        {
                            <div class="animate-spin h-5 w-5 border-2 border-white dark:border-text-dark border-t-transparent rounded-full"></div>
                        }
                        else
                        {
                            <span>Subscribe</span>
                        }
                    </button>
                </form>
            }
            else
            {
                @* Beautiful Success Message *@
                <div class="flex flex-col items-center text-center animate-in fade-in zoom-in duration-500">
                    <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 rounded-full flex items-center justify-center mb-4">
                        <span class="material-icons-round text-green-500 text-3xl">mark_email_read</span>
                    </div>
                    <h3 class="font-display font-bold text-2xl text-cookie-brown dark:text-white">You're on the list!</h3>
                    <p class="text-sm text-cookie-brown/60 dark:text-gray-400 mt-2 max-w-xs">
                        Check your inbox to <span class="text-primary font-bold">confirm your subscription</span>.
                        Don't forget to peek in your <span class="italic">junk folder</span> just in case! 🐯
                    </p>
                </div>
            }
        </div>
        <div class="mt-6 text-center">
            <a href="/auth/signin" class="text-xs font-semibold text-cookie-brown/45 hover:text-primary transition-colors">
                Team sign in
            </a>
        </div>
    </main>
</div>

@code {
    private bool IsSubmitting = false;
    private bool IsSuccess = false;
    private string Name = "";
    private string Email = "";

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(Email)) return;

        IsSubmitting = true;

        try
        {
            // Listmonk form data
            var dict = new Dictionary<string, string>
            {
                { "l", "707d985a-fdbf-487e-a892-259609dc12a9" },
                { "name", Name },
                { "email", Email }
            };

            var content = new FormUrlEncodedContent(dict);

            // Post to your Listmonk instance
            var response = await Http.PostAsync("https://listmonk.vlachos.nl/subscription/form", content);

            // Listmonk usually returns a redirect or 200 on success
            if (response.IsSuccessStatusCode)
            {
                IsSuccess = true;
            }
        }
        catch (Exception ex)
        {
            // Log error to your homelab console if needed
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            IsSubmitting = false;
        }
    }
}
