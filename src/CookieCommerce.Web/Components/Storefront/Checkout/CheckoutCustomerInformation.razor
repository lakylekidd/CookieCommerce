@using CookieCommerce.Web.Models.Auth
@using CookieCommerce.Web.Services
@using CookieCommerce.Web.Components.Auth
@using System.ComponentModel.DataAnnotations

<div class="bg-white dark:bg-surface-dark rounded-2xl border border-amber-100 dark:border-amber-900/30 overflow-hidden cookie-shadow transition-all duration-500">
    <div class="p-6 flex items-center gap-4 border-b border-amber-50 dark:border-amber-900/20 bg-amber-50/30 dark:bg-amber-900/10">
        <span class="w-8 h-8 rounded-full @(CurrentStep >= 1 ? "bg-primary text-white" : "bg-gray-200 text-gray-500") flex items-center justify-center font-bold">1</span>
        <h2 class="font-display font-bold text-xl dark:text-amber-50">Customer Information</h2>
        @if (Auth.IsLoggedIn)
        {
            <div class="ml-auto flex justify-end items-center gap-2 px-3 py-1 rounded-full bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400 text-xs font-bold uppercase tracking-wider">
                <span class="material-symbols-outlined text-sm">check_circle</span>
                Logged In
            </div>
        }
        @if (CurrentStep > 1)
        {
            <button @onclick="() => GoToStep(1)" class="cursor-pointer ml-auto text-primary text-sm font-bold hover:underline">Edit</button>
        }
    </div>

    @if (CurrentStep == 1)
    {
        <div class="p-8 animate-in fade-in slide-in-from-top-4 duration-300">
            @if (Auth.IsLoggedIn && User is not null)
            {
                <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                    <div class="flex items-center gap-4">
                        <div class="w-16 h-16 rounded-full bg-amber-100 dark:bg-amber-900/40 flex items-center justify-center text-primary">
                            <span class="material-symbols-outlined text-3xl">person</span>
                        </div>

                        <div>
                            <h3 class="font-display font-bold text-xl text-text-light dark:text-amber-100">
                                Welcome back, @User.FirstName!
                            </h3>
                            <p class="text-sm text-gray-500 dark:text-amber-100/50">
                                Checking out as <span class="font-bold text-primary">@User.Email</span>
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-4 w-full md:w-auto">
                        <button @onclick="HandleSignOut"
                                class="cursor-pointer flex-1 md:flex-none px-6 py-2 rounded-full border border-gray-200 dark:border-amber-900/50 text-gray-500 dark:text-amber-100/40 text-sm font-bold hover:bg-gray-50 dark:hover:bg-amber-900/10 transition-colors">
                            Not you? Sign out
                        </button>
                        <button @onclick="() => GoToStep(2)" class="cursor-pointer bg-primary text-white px-8 py-3 rounded-full font-bold">Continue</button>
                    </div>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 relative">
                    <div class="hidden md:block absolute left-1/2 top-12 bottom-12 w-px bg-amber-100 dark:bg-amber-900/30"></div>

                    <div class="space-y-4">
                        <h3 class="font-display font-bold text-xl text-text-light dark:text-amber-100">New Customer?</h3>
                        <p class="text-sm text-gray-500 dark:text-amber-100/50">Checkout as a guest or create an account.</p>

                        <div class="space-y-4 pt-2">
                            <div>
                                <label class="block text-xs font-bold text-primary mb-1 uppercase tracking-wider">
                                    Email Address *
                                </label>
                            <input class="w-full px-5 py-3 rounded-full border-amber-100 dark:border-amber-900/30 focus:border-primary focus:ring-primary bg-background-light/30 dark:bg-amber-900/10 dark:text-white"
                                   @bind:get="CheckoutEmail"
                                   @bind:set="OnCheckoutEmailChanged"
                                   @bind:event="oninput"
                                   placeholder="roar@tiger.nl" required type="email" />
                            </div>

                            <div class="space-y-4">
                                <label class="flex items-center gap-3 cursor-pointer group">
                                    <input type="checkbox"
                                           @bind:get="ShouldCreateAccount"
                                           @bind:set="OnShouldCreateAccountChanged"
                                           @onclick="RemovePassword"
                                           class="w-5 h-5 rounded-full border-amber-200 text-primary focus:ring-primary accent-primary cursor-pointer" />
                                    <span class="text-sm font-semibold text-gray-600 dark:text-amber-100/70 group-hover:text-primary transition-colors">
                                        Create an account?
                                    </span>
                                </label>

                                @if (ShouldCreateAccount)
                                {
                                    <div class="space-y-4 animate-in fade-in slide-in-from-top-2 duration-300">
                                        <div>
                                            <label class="block text-xs font-bold text-gray-500 dark:text-amber-100/40 mb-1 uppercase tracking-wider">Password</label>
                                            <input class="w-full px-5 py-3 rounded-full border-amber-100 dark:border-amber-900/30 focus:border-primary focus:ring-primary bg-background-light/30 dark:bg-amber-900/10 dark:text-white"
                                                   @bind:get="Password"
                                                   @bind:set="OnPasswordChanged"
                                                   @bind:event="oninput"
                                                   placeholder="••••••••" type="password" />
                                        </div>
                                        <div>
                                            <label class="block text-xs font-bold text-gray-500 dark:text-amber-100/40 mb-1 uppercase tracking-wider">Confirm Password</label>
                                            <input class="w-full px-5 py-3 rounded-full border-amber-100 dark:border-amber-900/30 focus:border-primary focus:ring-primary bg-background-light/30 dark:bg-amber-900/10 dark:text-white"
                                                   @bind:get="ConfirmPassword"
                                                   @bind:set="OnConfirmPasswordChanged"
                                                   @bind:event="oninput"
                                                   placeholder="••••••••" type="password" />
                                        </div>

                                        <PasswordValidator
                                            Password="@Password"
                                            ConfirmPassword="@ConfirmPassword"
                                            OnStrengthChanged="@((strength) => CurrentPasswordStrength = strength)"/>

                                    </div>
                                }
                        <div class="flex justify-end pt-4">
                            <button @onclick="() => GoToStep(2)"
                                    disabled="@DisableContinueFromStep1()"
                                    class="px-8 py-3 rounded-full font-bold transition-all
                                                               @(DisableContinueFromStep1()
                                                                                                     ? "bg-gray-300 cursor-not-allowed text-gray-500"
                                                                                                     : "bg-primary hover:bg-amber-700 shadow-xl cursor-pointer text-white")">
                                        Continue to Contact & Shipping
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-4">
                        <h3 class="font-display font-bold text-xl text-text-light dark:text-amber-100">Already a Tiger?</h3>
                        <p class="text-sm text-gray-500 dark:text-amber-100/50">Log in to speed up your checkout.</p>
                        <div class="pt-2">
                            <NavLink href="@($"/auth/signin?returnUrl={Uri.EscapeDataString(Navigation.Uri)}")"
                                     class="block w-full py-3 px-6 rounded-full border-2 border-primary font-bold text-primary hover:bg-amber-50 dark:hover:bg-primary/10 transition-colors text-lg text-center">
                                Sign In
                            </NavLink>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {

    [Parameter] public UserDto User { get; set; }
    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public string ConfirmPassword { get; set; } = string.Empty;
    [Parameter] public string CheckoutEmail { get; set; } = string.Empty;

    [Parameter] public int CurrentStep { get; set; }
    [Parameter] public bool ShouldCreateAccount { get; set; }

    [Parameter] public EventCallback<int> CurrentStepChanged { get; set; }
    [Parameter] public EventCallback<bool> ShouldCreateAccountChanged { get; set; }
    [Parameter] public EventCallback<string> CheckoutEmailChanged { get; set; }
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }
    [Parameter] public EventCallback<string> ConfirmPasswordChanged { get; set; }

    [Inject] private IAuthService Auth { get; set; }
    [Inject] private NavigationManager Navigation { get; set; }
    private int CurrentPasswordStrength = 0;

    private void GoToStep(int step)
    {
        CurrentStepChanged.InvokeAsync(step);
    }

    private async Task OnCheckoutEmailChanged(string value)
    {
        CheckoutEmail = value;
        await CheckoutEmailChanged.InvokeAsync(value);
    }

    private async Task OnShouldCreateAccountChanged(bool value)
    {
        ShouldCreateAccount = value;
        await ShouldCreateAccountChanged.InvokeAsync(value);
    }

    private async Task OnPasswordChanged(string value)
    {               Password = value;
        await PasswordChanged.InvokeAsync(value);
    }

    private async Task OnConfirmPasswordChanged(string value)
    {
        ConfirmPassword = value;
        await ConfirmPasswordChanged.InvokeAsync(value);
    }

    private async Task HandleSignOut()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private bool DisableContinueFromStep1()
    {
        // 1. Validate Email first (Required for both Guest and Account)
        var isEmailValid = !string.IsNullOrWhiteSpace(CheckoutEmail) &&
                           new EmailAddressAttribute().IsValid(CheckoutEmail);

        // If email is bad, we stop here.
        if (!isEmailValid) return true;

        // 2. If they want to create an account, check password requirements
        if (ShouldCreateAccount)
        {
            bool passwordsMatch = !string.IsNullOrEmpty(Password) && Password == ConfirmPassword;
            bool isStrongEnough = CurrentPasswordStrength >= 2;

            // Disable if passwords don't match OR if it's too weak
            return !passwordsMatch || !isStrongEnough;
        }

        // 3. If we got here, email is valid and they are checking out as a guest
        return false;
    }

    private void RemovePassword()
    {
        Password = string.Empty;
        ConfirmPassword = string.Empty;
    }
}
