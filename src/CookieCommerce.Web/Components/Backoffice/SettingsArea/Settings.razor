</div>

@code {
    @* ── Section definitions ──────────────────────────────────────────────── *@
    private enum SettingsSection { Commerce, Promotions, Loyalty, Inventory, Notifications, Appearance, Email, Templates, Invoices }

    private record SectionMeta(string Label, string Icon, string Description);

    private static readonly Dictionary<SettingsSection, SectionMeta> Sections = new()
    {
        [SettingsSection.Commerce]      = new("Commerce",          "payments",       "Shipping costs, VAT, order flow, and checkout behaviour."),
        [SettingsSection.Promotions]    = new("Promotions",        "sell",           "Manage discount codes and promotional campaigns."),
        [SettingsSection.Loyalty]       = new("Loyalty & Rewards", "star",           "Configure the reward points programme for customers."),
        [SettingsSection.Inventory]     = new("Inventory",         "inventory_2",    "Batch production defaults and stock alert thresholds."),
        [SettingsSection.Notifications] = new("Notifications",     "notifications",  "Admin alerts for orders, low stock, and customer events."),
        [SettingsSection.Appearance]    = new("Appearance",        "palette",        "Storefront copy, product badges, and theme preferences."),
        [SettingsSection.Email]         = new("Email", "mail", "Outbound email, password recovery and delivery status."),
        [SettingsSection.Templates]     = new("Templates", "description", "Edit and preview customer emails and the PDF invoice layout."),
        [SettingsSection.Invoices]      = new("Invoices", "receipt_long", "Company details, invoice numbering and automatic invoice emails."),
    };

    private (string Ref, string Name)[] CookieOptions = [];

    @* ── Active section ──────────────────────────────────────────────────── *@
    private SettingsSection activeSection = SettingsSection.Commerce;
    private void SetSection(SettingsSection s) { activeSection = s; savedVisible = false; }

    @* ── Save state ───────────────────────────────────────────────────────── *@
    private bool savedVisible = false;

    protected override async Task OnInitializedAsync()
    {
        var config = await SettingsService.GetAsync();
        CookieOptions = (await Catalog.GetInventoryItemsAsync()).Select(p => (Ref: p.ProductId.ToString(), Name: p.ProductName)).ToArray();
        orderReferencePrefix = config.OrderReferencePrefix;
        freeShippingThreshold = config.FreeShippingThreshold;
        standardShippingCost = config.StandardShippingCost;
        vatRate = config.VatRate;
        nextDayDeliveryCutoff = config.NextDayDeliveryCutoff;
        allowGuestCheckout = config.AllowGuestCheckout;
        allowOrderNotes = config.AllowOrderNotes;
        maxItemsPerOrder = config.MaxItemsPerOrder;
        promoCodes = config.Promotions.Select(p => new PromoCodeEntry { Code = p.Code, Description = p.Description, Discount = p.Discount, IsPercentage = p.IsPercentage, IsActive = p.IsActive }).ToList();
        foreach (var field in GetType().GetFields(System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic))
            if (config.AdditionalSettings.TryGetValue(field.Name, out var value)) field.SetValue(this, System.Text.Json.JsonSerializer.Deserialize(value, field.FieldType));
    }
    private string? saveError;
    private async Task SaveSection()
    {
        saveError = null;
        try
        {
            var config = new CommerceSettings
            {
                OrderReferencePrefix = orderReferencePrefix, FreeShippingThreshold = freeShippingThreshold,
                StandardShippingCost = standardShippingCost, VatRate = vatRate, NextDayDeliveryCutoff = nextDayDeliveryCutoff,
                AllowGuestCheckout = allowGuestCheckout, AllowOrderNotes = allowOrderNotes, MaxItemsPerOrder = maxItemsPerOrder,
                Promotions = promoCodes.Select(p => new PromotionDefinition { Code = p.Code.Trim().ToUpperInvariant(), Description = p.Description, Discount = p.Discount, IsPercentage = p.IsPercentage, IsActive = p.IsActive }).ToList()
            };
            foreach (var field in GetType().GetFields(System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.NonPublic))
                if (field.FieldType == typeof(int) || field.FieldType == typeof(decimal) || field.FieldType == typeof(string) || field.FieldType == typeof(bool))
                    if (field.Name is not "savedVisible" and not "showAddPromoForm" and not "saveError") config.AdditionalSettings[field.Name] = System.Text.Json.JsonSerializer.Serialize(field.GetValue(this));
            await SettingsService.SaveAsync(config);
            if (browserPushNotifications) await JS.InvokeVoidAsync("requestCommerceNotifications");
            savedVisible = true;
        }
        catch (Exception ex) { saveError = ex.Message; savedVisible = false; }
    }

    @* ── Commerce ─────────────────────────────────────────────────────────── *@
    private string orderReferencePrefix = "TGR";
    private decimal freeShippingThreshold = 40m;
    private decimal standardShippingCost = 4.95m;
    private decimal vatRate = 7m;
    private TimeOnly nextDayDeliveryCutoff = new TimeOnly(14, 0);
    private bool allowGuestCheckout = true;
    private bool allowOrderNotes = true;
    private int maxItemsPerOrder = 120;

    @* ── Promotions ───────────────────────────────────────────────────────── *@
    private class PromoCodeEntry
    {
        public string Code { get; set; } = "";
        public string Description { get; set; } = "";
        public decimal Discount { get; set; } = 10;
        public bool IsPercentage { get; set; } = true;
        public bool IsActive { get; set; } = true;
    }

    private List<PromoCodeEntry> promoCodes = new()
    {
        new() { Code = "DISCOUNT10", Description = "10% off any order",       Discount = 10, IsPercentage = true,  IsActive = true  },
        new() { Code = "WELCOME5",   Description = "€5 off your first order", Discount = 5,  IsPercentage = false, IsActive = false },
    };

    private PromoCodeEntry newPromo = new();
    private bool showAddPromoForm = false;

    private void AddPromoCode()
    {
        if (string.IsNullOrWhiteSpace(newPromo.Code)) return;
        promoCodes.Add(new PromoCodeEntry
        {
            Code = newPromo.Code.ToUpper().Trim(),
            Description = newPromo.Description,
            Discount = newPromo.Discount,
            IsPercentage = newPromo.IsPercentage,
            IsActive = true
        });
        newPromo = new();
        showAddPromoForm = false;
    }

    @* ── Loyalty ──────────────────────────────────────────────────────────── *@
    private int pointsPerEuro = 10;
    private decimal minOrderToEarnPoints = 0m;
    private int minPointsToRedeem = 100;
    private bool allowPointRedemption = true;
    private bool showPointsOnStorefront = true;
    private bool doubleBirthdayPoints = false;

    @* ── Inventory ────────────────────────────────────────────────────────── *@
    private int defaultBakingTemp = 180;
    private int defaultBakingDuration = 12;
    private int dailyQuotaTarget = 50;
    private int lowStockThreshold = 10;
    private int maxDefectRatePercent = 5;
    private bool autoCreateBatchOnLowStock = false;

    @* ── Notifications ────────────────────────────────────────────────────── *@
    private string adminEmail = "admin@tigervancookie.nl";
    private bool notifyOnNewOrder = true;
    private bool notifyOnLowStock = true;
    private bool notifyOnNewCustomer = false;
    private bool notifyOnHighDefects = true;
    private bool dailySummaryReport = true;
    private bool soundAlertOnNewOrder = false;
    private bool browserPushNotifications = false;

    @* ── Appearance ───────────────────────────────────────────────────────── *@
    private string storeTagline = "Freshly Baked Every Morning";
    private string flavorOfTheMonth = "COOKIE-002";
    private int featuredProductCount = 4;
    private bool defaultDarkMode = false;
    private bool showLimitedBadge = true;
    private bool showTopSellerBadge = true;
}
