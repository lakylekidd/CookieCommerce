@using CookieCommerce.Web.Services
@implements IDisposable
@rendermode InteractiveServer
@inject ICartService CartService

<style>
    @@keyframes badge-pop {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.6) rotate(-10deg);
        }
        /* Big pop with a slight tilt */
        100% {
            transform: scale(1) rotate(0deg);
        }
    }

    .animate-pop {
        animation: badge-pop 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
</style>

<a href="/shop/cart"
   aria-label="Cart"
   id="shopping-bag"
   class="relative w-10 h-10 flex items-center justify-center rounded-full hover:bg-amber-100 dark:hover:bg-white/10 transition-colors">
    <span class="material-icons-round text-xl">shopping_bag</span>

    @* Added the conditional 'animate-pop' class *@
    <span class="absolute top-1 right-1 bg-primary text-white text-[10px] font-bold h-4 w-4 flex items-center justify-center rounded-full border-2 border-background-light dark:border-background-dark @(isPopping ? "animate-pop" : "")">
        @CartItemCount
    </span>
</a>

@code {
    private int CartItemCount { get; set; } = 0;
    private bool isPopping = false;

    protected override async Task OnInitializedAsync()
    {
        CartService.OnCartUpdated += HandleCartChanged;
        await LoadCartCountAsync();
    }

    private async void HandleCartChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadCartCountAsync();

            // Trigger the animation
            isPopping = true;
            StateHasChanged();

            // Wait for the animation duration (400ms)
            await Task.Delay(400);

            isPopping = false;
            StateHasChanged();
        });
    }

    private async Task LoadCartCountAsync()
    {
        CartItemCount = await CartService.GetCartItemCountAsync();
    }

    public void Dispose()
    {
        CartService.OnCartUpdated -= HandleCartChanged;
    }
}