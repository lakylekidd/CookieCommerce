<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="css/app.min.css" />
    <link rel="stylesheet" href="@Assets["CookieCommerce.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body class="bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark font-body transition-colors duration-300">
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />

    <script src="js/global.js"></script>
    <script src="js/phone-helper.js"></script>
    <script src="js/charting.js"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>

    @* TIGER PALETTE ANCHOR: 
       This hidden div ensures Tailwind includes the colors used in our 
       dynamic C# randomization logic.
    *@
    <div class="hidden
        bg-amber-100 dark:bg-amber-900/30 text-amber-600
        bg-orange-100 dark:bg-orange-900/30 text-orange-600
        bg-cyan-100 dark:bg-cyan-900/30 text-cyan-600
        bg-blue-100 dark:bg-blue-900/30 text-blue-600
        bg-purple-100 dark:bg-purple-900/30 text-purple-600
        bg-violet-100 dark:bg-violet-900/30 text-violet-600">
    </div>
</body>

</html>
