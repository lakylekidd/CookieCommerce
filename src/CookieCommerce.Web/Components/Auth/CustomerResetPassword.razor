@page "/auth/password/reset/{token}"
@using System.ComponentModel.DataAnnotations
@using CookieCommerce.Web.Services
@rendermode InteractiveServer

@layout AuthLayout

<main class="flex-grow relative flex items-center justify-center py-12 px-6 overflow-hidden">
    <div class="absolute inset-0 pattern-bg pointer-events-none"></div>
    <div class="absolute top-20 left-10 opacity-20 -rotate-12 hidden lg:block">
        <span class="material-symbols-outlined !text-8xl text-primary">cookie</span>
    </div>
    <div class="absolute bottom-20 right-10 opacity-20 rotate-12 hidden lg:block">
        <span class="material-symbols-outlined !text-9xl text-primary">bakery_dining</span>
    </div>
    <div class="absolute top-1/2 left-1/4 opacity-10 rotate-45 hidden lg:block">
        <span class="material-symbols-outlined !text-7xl text-primary">restaurant</span>
    </div>
    <div class="w-full max-w-md relative">
        <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-40 h-40 z-20 drop-shadow-2xl">
            <img alt="Confused Baby Tiger Mascot" class="w-full h-full object-contain"
                 src="/images/logo.png" />
        </div>
        <div class="bg-white dark:bg-surface-dark p-8 md:p-10 rounded-3xl cookie-shadow border border-amber-50 dark:border-amber-900/20 relative z-10 overflow-hidden mt-20">
            <div class="absolute top-0 right-0 w-24 h-24 bg-amber-50 dark:bg-amber-900/10 rounded-bl-full -mr-12 -mt-12">
            </div>

            @if(!isSuccess)
            {
                <div class="text-center mb-8 pt-4">
                    <h1 class="font-display font-bold text-3xl text-text-light dark:text-text-dark mb-4">
                        Set Your New Cookie Code
                    </h1>
                    <p class="text-gray-500 dark:text-gray-400 leading-relaxed">
                        Almost there! Create a strong new password to keep your cookie stash safe.
                    </p>
                </div>
                <form class="space-y-6" @onsubmit="HandlePasswordChangeAsync">
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-text-light dark:text-text-dark ml-1"
                               for="password">New Password</label>
                        <div class="relative">
                            <input class="w-full px-5 py-4 rounded-2xl border-2 border-amber-100 dark:border-amber-900/30 bg-amber-50/30 dark:bg-background-dark/50 focus:bg-white transition-all outline-none"
                                   id="password" 
                                   @bind="NewPassword"
                                   @bind:event="oninput"
                                   placeholder="••••••••" 
                                   required="" 
                                   type="password" />
                            <span class="material-icons-round absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 cursor-pointer hover:text-primary">visibility</span>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label class="block text-sm font-bold text-text-light dark:text-text-dark ml-1"
                               for="confirm-password">Confirm New Password</label>
                        <div class="relative">
                            <input class="w-full px-5 py-4 rounded-2xl border-2 border-amber-100 dark:border-amber-900/30 bg-amber-50/30 dark:bg-background-dark/50 focus:bg-white transition-all outline-none"
                                   id="confirm-password" 
                                   @bind="ConfirmPassword"
                                   @bind:event="oninput"
                                   placeholder="••••••••" 
                                   required="" 
                                   type="password" />
                            <span class="material-icons-round absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 cursor-pointer hover:text-primary">visibility</span>
                        </div>
                    </div>
                    
                    <PasswordValidator 
                        Password="@NewPassword" 
                        ConfirmPassword="@ConfirmPassword"
                        OnStrengthChanged="@((strength) => CurrentPasswordStrength = strength)"/>

                    <button type="submit" 
                            disabled="@IsButtonDisabled"
                            class="w-full py-4 bg-primary text-white rounded-2xl font-bold text-lg shadow-lg transition-all 
                                   @(IsButtonDisabled 
                                       ? "opacity-50 translate-y-0 cursor-not-allowed" 
                                       : "hover:bg-amber-700 shadow-amber-500/30 hover:-translate-y-1 active:translate-y-0 cursor-pointer")">
                        @if (isSubmitting)
                        {
                            <span class="animate-pulse">Resetting Password...</span>
                        }
                        else
                        {
                            <span>Reset Password</span>
                        }
                    </button>
                </form>
            }
            else
            {
                <div class="text-center py-8 animate-in fade-in zoom-in duration-500">
                    <div class="inline-flex items-center justify-center w-20 h-20 bg-green-100 dark:bg-green-900/30 rounded-full mb-6 relative">
                        <span class="material-symbols-outlined text-5xl text-green-600">task_alt</span>
                        <span class="absolute -top-1 -right-1 animate-ping h-3 w-3 rounded-full bg-amber-400 opacity-75"></span>
                    </div>
            
                    <h2 class="text-3xl font-bold text-text-light dark:text-text-dark mb-4">Code Locked In!</h2>
                    <p class="text-gray-500 dark:text-gray-400 mb-8 leading-relaxed px-4">
                        Great work, Tiger! Your new password is now safe in our jungle vault. 
                        We're pouncing back to the login page in...
                    </p>

                    <div class="flex flex-col items-center gap-4">
                        <div class="relative flex items-center justify-center">
                            <svg class="w-20 h-20 transform -rotate-90">
                                <circle cx="40" cy="40" r="@CircleRadius" 
                                        stroke="currentColor" stroke-width="6" fill="transparent" 
                                        class="text-gray-200 dark:text-amber-900/20" />
        
                                <circle cx="40" cy="40" r="@CircleRadius" 
                                        stroke="currentColor" stroke-width="6" fill="transparent"
                                        stroke-dasharray="@Circumference.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                        style="stroke-dashoffset: @((Circumference - (Circumference * (double)countdown / MaxCountdown)).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)); transition: stroke-dashoffset 1s linear;"
                                        class="text-primary" />
                            </svg>
                            <span class="absolute text-2xl font-black text-primary font-display">@(countdown)s</span>
                        </div>
        
                        <p class="text-[10px] uppercase tracking-[0.2em] font-bold text-amber-600 dark:text-amber-400 animate-pulse">
                            Getting ready to roar...
                        </p>
                    </div>
                </div>
            }

            <div class="mt-8 text-center">
                <a class="text-primary font-bold inline-flex items-center gap-2 group" href="#">
                    <span class="no-underline material-icons-round text-sm group-hover:-translate-x-1 transition-transform">arrow_back</span>
                    <span class="hover:underline">Back to Login</span>
                </a>
            </div>
        </div>
    </div>
</main>

@code {
    [Inject] private NavigationManager Navigation { get; set; }
    [Inject] private IAuthService Auth { get; set; }
    [Parameter] public string Token { get; set; } = string.Empty;
    private string NewPassword { get; set; } = string.Empty;
    private string ConfirmPassword { get; set; } = string.Empty;
    private bool isSubmitting;
    private bool IsButtonDisabled => isSubmitting || !IsPasswordValid();
    private bool isSuccess = false;
    private int countdown = MaxCountdown;
    private int CurrentPasswordStrength = 0;

    private const int MaxCountdown = 10; // Change this one number to update everything
    private const int CircleRadius = 35;
    private double Circumference => 2 * Math.PI * CircleRadius;

    private async Task HandlePasswordChangeAsync()
    {
        if (isSubmitting) return;

        isSubmitting = true;

        // Calling your service on the 192.168.0.195 server
        var result = await Auth.UpdatePasswordAsync(Token, NewPassword);
        await Task.Delay(2000);

        if (result.Success)
        {
            isSuccess = true;
            countdown = MaxCountdown; // Reset to max
            StateHasChanged(); // Force UI update to show success screen

            // The 10-second countdown loop
            while (countdown > 0)
            {
                await Task.Delay(1000);
                countdown--;
                StateHasChanged(); // Update the UI every second
            }

            // Redirect to login
            Navigation.NavigateTo("/auth/signin");
        }
        else
        {
            isSubmitting = false;
            NewPassword = string.Empty;
            ConfirmPassword = string.Empty;
            // You might want to show result.Message here
        }
    }

    private bool IsPasswordValid() 
    {
        return !string.IsNullOrEmpty(NewPassword) && 
               NewPassword.Length >= 8 &&
               NewPassword == ConfirmPassword; 
    }
}