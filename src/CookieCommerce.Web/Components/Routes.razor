@using CookieCommerce.Web.Components.ComingSoon
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(ComingSoonLayout)">
                <NotAuthorized>
                    <p>Sorry, you don't have permission to be here. Maybe try logging in?</p>
                </NotAuthorized>
                <Authorizing>
                    <p>Checking your credentials...</p>
                </Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>
