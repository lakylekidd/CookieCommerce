@rendermode InteractiveServer

<div class="mt-2 px-1">
    <div class="h-1.5 w-full bg-gray-200 dark:bg-amber-900/20 rounded-full overflow-hidden">
        <div class="h-full transition-all duration-500 @GetStrengthColor()"
             style="width: @(_strength * 25)%">
        </div>
    </div>

    <div class="flex justify-between mt-1">
        <p class="text-[10px] uppercase font-bold tracking-tighter text-gray-400">
            Strength: @(_strength == 4 ? "Tiger Proof" : "Weak")
        </p>

        @if (!string.IsNullOrEmpty(ConfirmPassword) && !string.IsNullOrEmpty(Password))
        {
            <p class="text-[10px] uppercase font-bold tracking-tighter @(Password == ConfirmPassword ? "text-green-500" : "text-red-500")">
                @(Password == ConfirmPassword ? "Passwords Match" : "Passwords do not match")
            </p>
        }
    </div>
</div>

@code {

    [Parameter] public string Password { get; set; } = string.Empty;
    [Parameter] public string ConfirmPassword { get; set; } = string.Empty;
    [Parameter] public EventCallback<int> OnStrengthChanged { get; set; }

    private int _strength;

    protected override async Task OnParametersSetAsync()
    {
        // Re-calculate whenever parameters from the parent change
        var newStrength = CalculateStrength();

        if (newStrength != _strength)
        {
            _strength = newStrength;
            await OnStrengthChanged.InvokeAsync(_strength);
        }
    }

    private int CalculateStrength()
    {
        if (string.IsNullOrEmpty(Password)) return 0;
        int score = 0;
        if (Password.Length >= 8) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(Password, @"[A-Z]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(Password, @"[0-9]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(Password, @"[^a-zA-Z0-9]")) score++;
        return score;
    }

    private string GetStrengthColor() => _strength switch
    {
        1 => "bg-red-500",
        2 => "bg-orange-500",
        3 => "bg-yellow-500",
        4 => "bg-green-500",
        _ => "bg-gray-200"
    };
}