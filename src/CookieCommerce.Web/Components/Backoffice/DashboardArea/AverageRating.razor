<div class="bg-surface-light dark:bg-surface-dark p-6 rounded-2xl shadow-sm border border-orange-50 dark:border-stone-700 hover:shadow-md transition-shadow group">
    <div class="flex justify-between items-start mb-4">
        <div class="flex items-center justify-center w-12 h-12 bg-yellow-100 dark:bg-yellow-900/30 rounded-full">
            <span class="material-icons-round text-yellow-600 text-xl">star</span>
        </div>
        <span class="flex items-center text-xs font-bold text-stone-500 bg-stone-100 dark:bg-stone-800 px-2 py-1 rounded-lg">
            @if (IsLoading)
            {
                <div class="h-9 w-24 animate-skeleton rounded-xl mt-1"></div>
            }
            else
            {
                @Total <span class="material-icons-round text-sm ml-1 text-yellow-500">star</span>
            }
        </span>
    </div>
    <h3 class="text-stone-500 dark:text-stone-400 text-sm font-semibold mb-1">Avg Rating</h3>
    <p class="text-3xl font-display font-bold text-primary dark:text-white">Top Tier</p>
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public double Total { get; set; }
}