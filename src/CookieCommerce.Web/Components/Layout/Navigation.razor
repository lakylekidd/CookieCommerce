@using CookieCommerce.Web.Components.Layout
@using CookieCommerce.Web.Components.Features.Cart
@using CookieCommerce.Web.Services
@rendermode InteractiveServer
@inject IAuthService Auth

<nav class="sticky top-0 z-50 bg-background-light/90 dark:bg-background-dark/90 backdrop-blur-md border-b border-amber-100 dark:border-amber-900/30">
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">
        <a class="flex items-center gap-3 group" href="#">
            <_Logo />
        </a>
        <div class="hidden md:flex items-center gap-8 font-semibold">
            <!-- Navigate to Main Shop -->
            <NavLink class="hover:text-primary transition-colors" href="/storefront" Match="NavLinkMatch.All">Home</NavLink>
            <NavLink class="hover:text-primary transition-colors" href="/shop" Match="NavLinkMatch.Prefix">Shop Cookies</NavLink>
            <NavLink class="hover:text-primary transition-colors" href="/our-story" Match="NavLinkMatch.All">Our Story</NavLink>
            <NavLink class="hover:text-primary transition-colors" href="/locations" Match="NavLinkMatch.All">Locations</NavLink>
        </div>
        <div class="flex items-center gap-4">
            <button aria-label="Toggle Dark Mode"
                    class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-amber-100 dark:hover:bg-white/10 transition-colors cursor-pointer"
                    @onclick="ToggleDarkMode">
                @if (isDarkMode)
                {
                    <span class="material-icons-round text-xl">light_mode</span>
                }
                else
                {
                    <span class="material-icons-round text-xl">dark_mode</span>
                }
            </button>
            <ShoppingBag />
            @if(Auth.IsLoggedIn)
            {
                <span class="px-6 py-2 text-xs font-bold uppercase opacity-50">Welcome, @Auth.CurrentUser!.FirstName</span>
                <button @onclick="Auth.Logout" class="cursor-pointer bg-primary-subtle flex items-center gap-3 px-6 py-4 rounded-2xl text-red-500 hover:bg-red-50">
                    <span class="material-symbols-outlined">logout</span>
                    Sign Out
                </button>
            }
            else
            {
                <a class="hidden md:block bg-primary hover:bg-amber-700 text-white px-5 py-2 rounded-full font-bold transition-transform active:scale-95 shadow-lg shadow-amber-500/30" href="/auth/signin">
                    Sign In
                </a>
            }
        </div>
    </div>
</nav>

@code {
    private bool isDarkMode = false;

    // Use JS Interop to actually toggle the class on the HTML tag
    [Inject] IJSRuntime JS { get; set; } = default!;

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("eval", "document.documentElement.classList.toggle('dark')");
    }
}