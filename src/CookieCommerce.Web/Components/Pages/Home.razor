@page "/"

<PageTitle>Coming Soon | Tiger van Cookie - Homemade cookies in Amsterdam</PageTitle>

<div id="jumbotron">
    <div id="postcard">
        <div id="comingsoon">
            <img src="/images/coming-soon-ribbon-label.png" alt="Alternate Text" />
        </div>
        <a href="https://www.instagram.com/tigervancookie/">
            <img id="social-instagram" src="/images/social-instagram.svg" alt="Instagram link" />
        </a>
        <img id="logo" src="images/logo.png" alt="Tiger van Cookies Logo" />
        <div>
            <div class="nocopy">
                <h1>Tiger van Cookie</h1>
                <h2>Homemade Cookies</h2>
                <p>Enter your e-mail address and we will notify you when we're open for business!</p>
            </div>            
            <form action="https://listmonk.vlachos.nl/subscription/form" method="post">
                <input type="hidden" name="l" value="707d985a-fdbf-487e-a892-259609dc12a9" />
                <input type="text" name="name" placeholder="Enter your name (optional)..." />
                <input type="email" name="email" required placeholder="Enter your e-mail..." />
                <button>Notify Me</button>
            </form>
        </div>
    </div>
</div>
