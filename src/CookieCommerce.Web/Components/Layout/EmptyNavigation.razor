@using CookieCommerce.Web.Components.Layout
@using CookieCommerce.Web.Components.Storefront.Cart
@using CookieCommerce.Web.Services
@rendermode InteractiveServer
@inject IAuthService Auth

<nav class="sticky top-0 z-50 bg-background-light/90 dark:bg-background-dark/90 backdrop-blur-md border-b border-amber-100 dark:border-amber-900/30">
    <div class="container mx-auto px-6 py-4 flex justify-between items-center">

        <a class="flex items-center gap-3 group" href="/storefront">
            <_Logo />
        </a>

        <div class="hidden md:flex items-center gap-4">

            <button aria-label="Toggle Dark Mode"
                    class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-amber-100 dark:hover:bg-white/10 transition-colors cursor-pointer"
                    @onclick="ToggleDarkMode">
                <span class="material-icons-round text-xl">@(isDarkMode ? "light_mode" : "dark_mode")</span>
            </button>

            <ShoppingBag />

            <a class="hidden lg:block bg-primary hover:bg-amber-700 text-white px-5 py-2 rounded-full font-bold transition-transform active:scale-95 shadow-lg shadow-amber-500/30" href="/storefront">
                Back to the Store
            </a>

        </div>

    </div>

</nav>


@code {
    private bool isDarkMode = false;
    private bool isMenuOpen = false;

    [Inject] IJSRuntime JS { get; set; } = default!;

    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("eval", "document.documentElement.classList.toggle('dark')");
    }

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }
}