<div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <h1 class="text-3xl font-display font-bold text-primary dark:text-white">Order History</h1>
    <div class="flex flex-wrap items-center gap-3">
        <div class="relative group">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-lg">search</span>
            <input class="pl-10 pr-4 py-2 bg-card-light dark:bg-card-dark border-orange-100 dark:border-gray-700 rounded-full text-sm focus:ring-primary focus:border-primary w-full md:w-64 transition-all"
                   placeholder="Search orders..." type="text" />
        </div>
        <div class="flex gap-4">
            <div class="relative">
                <select class="appearance-none bg-card-light dark:bg-card-dark border border-orange-100 dark:border-gray-700 rounded-full text-sm py-2 pl-4 pr-10 focus:ring-primary focus:border-primary dark:text-gray-200 cursor-pointer">
                    <option>All Statuses</option>
                    <option>In Transit</option>
                    <option>Delivered</option>
                    <option>Cancelled</option>
                </select>
            </div>

            <div class="relative">
                <select class="appearance-none bg-card-light dark:bg-card-dark border border-orange-100 dark:border-gray-700 rounded-full text-sm py-2 pl-4 pr-10 focus:ring-primary focus:border-primary dark:text-gray-200 cursor-pointer">
                    <option>Last 3 months</option>
                    <option>Last 6 months</option>
                    <option>2023</option>
                    <option>All time</option>
                </select>
            </div>
        </div>
    </div>
</div>