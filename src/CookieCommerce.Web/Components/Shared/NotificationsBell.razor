<style>
    @@keyframes ring {
        0% {
            transform: rotate(0);
        }

        10% {
            transform: rotate(15deg);
        }

        20% {
            transform: rotate(-15deg);
        }

        30% {
            transform: rotate(10deg);
        }

        40% {
            transform: rotate(-10deg);
        }

        50% {
            transform: rotate(0);
        }

        100% {
            transform: rotate(0);
        }
    }

    .animate-ring {
        animation: ring 2s ease infinite;
        transform-origin: top;
    }
</style>

<button class="group relative w-10 h-10 flex items-center justify-center rounded-full hover:bg-amber-100 dark:hover:bg-white/10 transition-colors cursor-pointer">
    @if (HasNotifications)
    {
        <span class="material-icons animate-ring group-hover:rotate-12 transition-transform">notifications</span>
        <span class="absolute top-1 right-1 w-2 h-2 bg-red-500 rounded-full border-2 border-white dark:border-stone-800"></span>
    }
    else
    {
        <span class="material-icons text-stone-400 group-hover:-rotate-12 transition-transform">notifications_none</span>
    }
</button>

@code {
    private bool HasNotifications => true;
}