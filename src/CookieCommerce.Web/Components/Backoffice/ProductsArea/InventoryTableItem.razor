@using CookieCommerce.Web.Services
@inject IBackofficeService BackofficeService
@using CookieCommerce.Web.Models.Products
@rendermode InteractiveServer

<tr @onclick="OnSelectedAsync"
    class="group cursor-pointer transition-all border-b border-gray-100 dark:border-gray-800/50
           @(IsSelected ? "bg-orange-50/50 dark:bg-orange-900/10" : "hover:bg-orange-50/20 dark:hover:bg-gray-800/30")">
    <td class="px-6 py-6 hidden sm:table-cell">
        <div class="flex items-center gap-3">
            @if (Item.ProductMainImage is not null)
            {
                <img src="@Item.ProductMainImage.Url"
                     alt="@Item.ProductName"
                     class="size-10 rounded-full object-cover border-2 border-stone-100 dark:border-stone-800 shadow-sm">
            }
            else
            {
                @* 🐯 Tiger Placeholder *@
                <div class="size-10 rounded-full bg-orange-100 dark:bg-orange-950/30 flex items-center justify-center border-2 border-orange-200/50 dark:border-orange-500/20 shadow-inner group-hover:scale-110 transition-transform duration-300">
                    <span class="text-lg" role="img" aria-label="tiger">🐯</span>
                </div>
            }

            <div>
                <div class="text-sm font-medium text-gray-900 dark:text-gray-300">@Item.ProductName</div>
                <div class="text-xs text-gray-500 dark:text-gray-600 font-mono">@Item.ProductReference</div>
            </div>
        </div>
    </td>
    <td class="px-6 py-5">
        <div class="inline-flex items-center gap-2 bg-stone-100 dark:bg-stone-800 px-3 py-1.5 rounded-full border border-stone-200 dark:border-stone-700 shadow-sm">
            <span class="size-2 rounded-full @(Item.Stock > 10 ? "bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]" : "bg-orange-500")"></span>
            <span class="text-sm font-black text-stone-700 dark:text-stone-200">
                @Item.Stock
            </span>
            <span class="text-[10px] font-bold text-stone-400 uppercase tracking-widest">Qty</span>
        </div>
    </td>
    <td class="px-6 py-5 text-right">
        <div class="flex flex-col items-end gap-1">
            <label class="relative inline-flex items-center cursor-pointer" for="@StatusControlId">
                <span class="sr-only">Product status is visible for review only and is not saved yet.</span>
                <input id="@StatusControlId"
                       type="checkbox"
                       checked="@Item.Active"
                       aria-label="Product status, "



                       @onchange="IgnoreStatusToggle"
                       class="sr-only peer">
                @* The Switch Track *@
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700
                            peer-checked:after:translate-x-full peer-checked:after:border-white
                            after:content-[''] after:absolute after:top-[2px] after:left-[2px]
                            after:bg-white after:border-gray-300 after:border after:rounded-full
                            after:h-5 after:w-5 after:transition-all
                            peer-checked:bg-primary"></div>
            </label>
            <span class="text-[10px] font-bold uppercase @(Item.Active ? "text-emerald-600" : "text-gray-400")">
                @(Item.Active ? "Live" : "Draft")
            </span>
        </div>
    </td>
    <td class="px-6 py-6 text-right w-20">
        <div class="flex justify-end">
            <div class="transition-all duration-300 transform
                    @(IsSelected
                            ? "opacity-100 translate-x-0"
                            : "opacity-0 -translate-x-4 group-hover:opacity-100 group-hover:translate-x-1")">
                <div class="p-1.5 rounded-full inline-flex transition-colors duration-300
                        @(IsSelected
                                ? "bg-primary text-white"
                                : "bg-secondary text-white")">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="3"
                         stroke-linecap="round"
                         stroke-linejoin="round"
                         class="size-4">
                        <path d="m9 18 6-6-6-6" />
                    </svg>
                </div>
            </div>
        </div>
    </td>
</tr>

@code {
    [Parameter] public ProductDto Item { get; set; } = default!;
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<Guid> OnSelected { get; set; }
    private string StatusControlId => $"product-status-{Item.ProductId:N}";

    private async Task IgnoreStatusToggle(ChangeEventArgs e)
    {
        var active = e.Value is bool value && value;
        await BackofficeService.ChangeProductStatusAsync(Item.ProductId, active);
        Item.Active = active;
    }

    private async Task OnSelectedAsync()
    {
        await OnSelected.InvokeAsync(Item.ProductId);
    }
}
