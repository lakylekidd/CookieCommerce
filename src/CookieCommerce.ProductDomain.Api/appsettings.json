{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ProductMedia": {
    "StorageRootPath": "product-media",
    "RequestPath": "/media/products",
    "MaxFileSizeBytes": 5242880,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp" ]
  },
  "ConnectionStrings": {
    "ProductDomain": "Host=localhost;Database=ProductDomain;Username=postgres;Password=postgres",
    "Messaging": "amqp://guest:guest@localhost:5672"
  }
}
