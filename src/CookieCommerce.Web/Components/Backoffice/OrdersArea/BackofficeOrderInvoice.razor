@page "/backoffice/orders/{OrderId:guid}/invoice"
@layout BackofficeLayout
@rendermode InteractiveServer

<section class="bg-card-light dark:bg-card-dark rounded-2xl p-6 space-y-4">
    <a href="/backoffice/orders/" class="text-primary underline">Back to orders</a>
    <h1 class="text-2xl font-bold">Order invoice</h1>
    <InvoiceActions OrderId="OrderId" />
</section>

@code { [Parameter] public Guid OrderId { get; set; } }
