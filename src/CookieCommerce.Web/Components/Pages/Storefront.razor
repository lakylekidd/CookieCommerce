@page "/storefront"
@layout Layout.MainLayout
@using CookieCommerce.Web.Services.Products
@using CookieCommerce.Web.Models.Products
@inject ICookieService CookieService

<PageTitle>Storefront - Tiger van Cookie</PageTitle>

<CookieCommerce.Web.Components.Layout.Navigation />


<header class="relative overflow-hidden pt-12 pb-24 lg:pt-20 lg:pb-32">
    <div class="absolute inset-0 pattern-bg pointer-events-none"></div>
    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20">
            <div class="lg:w-1/2 text-center lg:text-left">
                <span class="inline-block py-1 px-3 rounded-full bg-amber-100 dark:bg-amber-900/40 text-primary font-bold text-sm mb-6 tracking-wide uppercase">Freshly Baked Every Morning</span>
                <h1 class="font-display font-bold text-5xl lg:text-7xl mb-6 leading-[1.1]">
                    Roar with <br />
                    <span class="text-primary">Delightful Flavor</span>
                </h1>
                <p class="text-lg lg:text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-lg mx-auto lg:mx-0 leading-relaxed">
                    Handcrafted, chunky, gooey cookies baked with premium Belgian chocolate and a touch of wild spirit. Get your paws on them today.
                </p>
                <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
                    <a class="w-full sm:w-auto px-8 py-4 bg-primary text-white rounded-full font-bold text-lg hover:shadow-lg hover:shadow-primary/40 transition-all hover:-translate-y-1" href="#featured">
                        Order Now
                    </a>
                    <a class="w-full sm:w-auto px-8 py-4 bg-surface-light dark:bg-surface-dark border-2 border-amber-100 dark:border-amber-800 rounded-full font-bold text-lg hover:border-primary text-text-light dark:text-text-dark transition-colors flex items-center justify-center gap-2" href="#">
                        <span class="material-icons-round text-primary">play_circle</span>
                        Watch Baking
                    </a>
                </div>
                <div class="mt-10 flex items-center justify-center lg:justify-start gap-6 opacity-80">
                    <div class="flex -space-x-3">
                        <img alt="Customer" class="w-10 h-10 rounded-full border-2 border-white dark:border-background-dark" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDmFvN9ue-qiTSQsWDXrxWeVS88MndQlErF1sV2HdoFQQjKzeU7JjuSdYKluEBVjggwICjnjak13QTcNkdds3zAwl_Mgwr1dHiBukgHNDkX8zC6YEqDomoA_8nALuJahSiFWZ40OURy53F98Vt4NimCJupA8FFaYkuL0JKvnjYT8jKgwi09FNYKi0JQ39e6_uvPKkYUy6IFBXWlCX9kZCLHKXE_Wx2orZrCQ_9ROW-VmUDobEbyLGjjbEaxmKB5Q3xsAkv6UR_6cA" />
                        <img alt="Customer" class="w-10 h-10 rounded-full border-2 border-white dark:border-background-dark" src="https://lh3.googleusercontent.com/aida-public/AB6AXuCB9uUxu-B8A9KuNSRgCGQzLicdBnYe1dE3sAn8nHUmQYGvZeQk2C1Z0EJj_Qa8o_NvZCVTktungpn9GxpIBhlBKX43wTBLXH918oSGngtZBh9BgMhBLY2gYMURr-8Z9Vzi8yAlFDFDXcn1czNu3kjkfmBc4tbSIyyPncwQN8D64jruWnnQaMbZNKMf1cEoiYAAfI_ED7G0NiuBDNs5VT9vL9WIyS6dzY9xyngI_FHtWElw8nyEcyJfUV7fA1OCokLFXLMwIl4Gkg" />
                        <img alt="Customer" class="w-10 h-10 rounded-full border-2 border-white dark:border-background-dark" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAOW0BrAhfuXJxYTTP7SoOS7oZoMuhOpal0wRQBS61Ue9WhP7oNR7Zu6KqkzbAo7TKFoKe1R-K1Jzyjmab0k8FcveCaNX2JCurHTucDqHb_J1i_61yKpLUQrY5_W4962zLPvKKljg3hIWqyvjSJKDQLuZo9e5EkUZHPMb-5YUvIKd6EIjezxHgN386RQGgOjHFZXaLld-qBX8rPeQGZRRmp3J0QTyOdz5S2ucZVUtHwG-IraBHc_ttboghywcyYyYSPbDwbDWA-9A" />
                    </div>
                    <div class="text-sm font-semibold">
                        <span class="text-primary">5,000+</span> Happy Tigers
                    </div>
                </div>
            </div>
            <div class="lg:w-1/2 relative">
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-gradient-to-tr from-amber-200/50 to-orange-100/30 dark:from-primary/20 dark:to-transparent rounded-full blur-3xl -z-10"></div>
                <div class="relative floating">
                    <img alt="Giant Chocolate Chip Cookie Stack" class="w-full h-auto rounded-3xl shadow-2xl rotate-3 transform hover:rotate-0 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAClYDcfzF8RkGpoxGiEPGs_yB2_wxhuAkZQJbkYy2nfV8lspbymSWuMam4IAZX6LWfpLJQXejMTTep4m_e01OLN8XHIFSJBpXtZH4LCoaX-olS5d2RheuLZlIkh4t7sII9WplfYn45q2HyyZKMB9YgGGxmOzx2usigZyyivASTZ6w4pvPSHYtMxzmI4P2xeQl9w6fdN3fTdhM0lMfHP2PCfa_hPggoLqzPOZ85jhj8vv182zOA19GQ-rvqdpF6-2h2e-bvMyfJbg" />
                    <div class="absolute -bottom-6 -left-6 bg-surface-light dark:bg-surface-dark p-4 rounded-2xl shadow-xl flex items-center gap-3 max-w-xs">
                        <div class="bg-green-100 dark:bg-green-900/30 p-2 rounded-full text-green-600 dark:text-green-400">
                            <span class="material-icons-round">eco</span>
                        </div>
                        <div>
                            <p class="text-xs text-gray-500 dark:text-gray-400 font-bold uppercase">100% Organic</p>
                            <p class="font-display font-bold text-sm">Locally Sourced Ingredients</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Featured Section -->
<section class="py-20 bg-white dark:bg-surface-dark/50 rounded-t-[3rem] relative" id="featured">
    <div class="container mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="font-display font-bold text-4xl mb-4">Tiger's Favorites</h2>
            <p class="text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">Our most roared-about flavors, baked fresh daily just for you.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
            @foreach (var cookie in featuredCookies)
            {
                <CookieCommerce.Web.Components.Features.Products._CookieCard 
                    ImageUrl="@cookie.ImageUrl"
                    CookieTitle="@cookie.Title"
                    Description="@cookie.Description"
                    Price="@cookie.Price"
                    IsBestSeller="@cookie.IsBestSeller"
                    IsLimitedEdition="@cookie.IsLimitedEdition" />
            }
        </div>
        <div class="mt-16 text-center">
            <a class="inline-flex items-center gap-2 font-bold text-primary hover:text-amber-800 dark:hover:text-amber-400 transition-colors border-b-2 border-transparent hover:border-current pb-1" href="#">
                View All Flavors
                <span class="material-icons-round text-lg">arrow_forward</span>
            </a>
        </div>
    </div>
</section>

<!-- Subscribe Section -->
<section class="py-12 bg-primary">
    <div class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-8 text-white">
            <div class="flex items-center gap-6">
                <img 
                    alt="Tiger Mascot" 
                    class="w-24 h-24 md:w-32 md:h-32 object-contain drop-shadow-xl transform -rotate-12" 
                    src="/images/logo.png" />
                <div>
                    <h3 class="font-display font-bold text-2xl md:text-3xl mb-2">Join the Tiger Club!</h3>
                    <p class="text-amber-100 max-w-md">
                        Get 20% off your first order and exclusive access to limited edition drops.
                    </p>
                </div>
            </div>
            <div class="w-full md:w-auto flex-shrink-0">
                <form class="flex w-full md:w-96 bg-white rounded-full p-1 shadow-lg overflow-hidden">
                    <input 
                        class="flex-grow bg-transparent border-none focus:ring-0 px-6 py-3 text-gray-800 placeholder-gray-400 rounded-full" 
                        placeholder="Enter your email..." 
                        type="email" />
                    <button 
                        class="bg-[#2D2115] text-white px-6 py-2 rounded-full font-bold hover:bg-gray-800 transition-colors" 
                        type="button">
                        Subscribe
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

<CookieCommerce.Web.Components.Layout.Footer />

@code {
    private IReadOnlyList<CookieDto> featuredCookies = [];

    protected override async Task OnInitializedAsync()
    {
        featuredCookies = await CookieService.GetFeaturedCookiesAsync();
    }
}