                    <div class="px-6 py-3">
                        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 dark:text-gray-500">Theme</p>
                    </div>
                    <div class="flex items-center justify-between gap-6 px-6 py-4">
                        <div>
                            <p class="text-sm font-semibold text-gray-800 dark:text-gray-100">Default to Dark Mode</p>
