@using CookieCommerce.Web.Models.Account
@using CookieCommerce.Web.Services
@inject IAccountService AccountService
@rendermode InteractiveServer

<div class="fixed inset-0 z-200 flex items-center justify-center p-4 bg-black/40 backdrop-blur-sm">
    @if (isSaving)
    {
        <div class="absolute inset-0 z-50 flex flex-col items-center justify-center bg-white/60 dark:bg-black/60 backdrop-blur-[2px]">
            <div class="w-12 h-12 border-4 border-gray-200 border-t-primary rounded-full animate-spin mb-4"></div>
            <p class="font-display font-bold text-secondary dark:text-white animate-pulse">
                Saving your cookie profile...
            </p>
        </div>
    }
    <div class="bg-card-light dark:bg-card-dark w-full max-w-xl rounded-xl shadow-2xl overflow-hidden relative">
        <div class="p-8 pb-4 flex items-start gap-6 relative">
            <div class="flex-grow">
                <div class="flex items-center gap-3 mb-1">
                    <span class="text-primary material-symbols-outlined text-3xl">edit_square</span>
                    <h2 class="text-3xl font-display font-bold text-secondary dark:text-white">
                        Update Your Profile
                    </h2>
                </div>
                <p class="text-gray-500 dark:text-gray-400">Keep your cookie preferences and details fresh!</p>
            </div>
            <div class="w-20 h-20 -mt-2 -mr-2 flex-shrink-0">
                <div class="w-full h-full rounded-full border-4 border-accent-light dark:border-accent-dark overflow-hidden bg-orange-50 shadow-inner">
                    <img alt="Tiger van Cookie Mascot" class="w-full h-full object-cover"
                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuAsi3jTr65ZY8H4fnNGgNhYOfX-VxgVW56xrT4XSnPLdYLLBDgKcH0fFJJkbjZdGdRRV7tQEa4qOoH9YfYjFqqiSE1m_CCD0AOavYloSTiEDaOE1eiKsw7ZJaf4gETtAdlEWe15BwGTing5AXYbSaHxMhowD-gqfda7E7-Ctrj6I_luCNgZBikfiYvmsZRfiw2HL0l9pycDVyJiIh2C7C2QM__ffPQAafIrjKqol6sSB8EEj-ROgUmUllVT1_mLwIvBLx94RW2VVw" />
                </div>
            </div>
        </div>
        <form class="p-8 pt-4 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-primary dark:text-gray-300 uppercase tracking-wider"
                           for="first_name">First Name</label>
                    <input class="w-full px-4 py-3 rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 focus:ring-primary focus:border-primary text-primary dark:text-white font-medium"
                           @bind="profile.FirstName"
                            id="first_name" type="text" />
                </div>
                <div class="space-y-2">
                    <label class="block text-sm font-bold text-primary dark:text-gray-300 uppercase tracking-wider"
                           for="last_name">Last Name</label>
                    <input class="w-full px-4 py-3 rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 focus:ring-primary focus:border-primary text-primary dark:text-white font-medium"
                           @bind="profile.LastName"
                           id="last_name" type="text" />
                </div>
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-bold text-primary dark:text-gray-300 uppercase tracking-wider"
                       for="email">Email Address</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-400">mail</span>
                    <input class="w-full pl-12 pr-4 py-3 rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 focus:ring-primary focus:border-primary text-primary dark:text-white font-medium"
                           @bind="profile.Email"
                           id="email" type="email" />
                </div>
            </div>
            <div class="space-y-2">
                <label class="block text-xs font-black text-primary dark:text-gray-300 uppercase tracking-widest">
                    Gender
                </label>
                <div class="flex flex-row gap-2">
                    <label class="flex-1 cursor-pointer">
                        <input type="radio" name="gender" value="male" class="peer hidden"
                               checked="@(profile.Gender == "male")"
                               @onchange="@(() => profile.Gender = "male")" />
                        <div class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800
                            peer-checked:border-primary peer-checked:bg-orange-50 dark:peer-checked:bg-orange-900/30
                            peer-checked:ring-1 peer-checked:ring-primary transition-all">
                            <span class="material-symbols-outlined text-sm text-gray-400 peer-checked:text-primary">male</span>
                            <span class="text-xs font-bold text-gray-500 dark:text-gray-400 peer-checked:text-primary">Male</span>
                        </div>
                    </label>

                    <label class="flex-1 cursor-pointer">
                        <input type="radio" name="gender" value="female" class="peer hidden"
                               checked="@(profile.Gender == "female")"
                               @onchange="@(() => profile.Gender = "female")" />
                        <div class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800
                            peer-checked:border-primary peer-checked:bg-orange-50 dark:peer-checked:bg-orange-900/30
                            peer-checked:ring-1 peer-checked:ring-primary transition-all">
                            <span class="material-symbols-outlined text-sm text-gray-400 peer-checked:text-primary">female</span>
                            <span class="text-xs font-bold text-gray-500 dark:text-gray-400 peer-checked:text-primary">Female</span>
                        </div>
                    </label>

                    <label class="flex-1 cursor-pointer">
                        <input type="radio" name="gender" value="private" class="peer hidden"
                               checked="@(profile.Gender == "private")"
                               @onchange="@(() => profile.Gender = "private")" />
                        <div class="flex items-center justify-center gap-2 py-2 px-3 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800
                            peer-checked:border-primary peer-checked:bg-orange-50 dark:peer-checked:bg-orange-900/30
                            peer-checked:ring-1 peer-checked:ring-primary transition-all">
                            <span class="material-symbols-outlined text-sm text-gray-400 peer-checked:text-primary">visibility_off</span>
                            <span class="text-xs font-bold text-gray-500 dark:text-gray-400 peer-checked:text-primary">Secret</span>
                        </div>
                    </label>
                </div>
            </div>
            <div class="space-y-2">
                <label class="block text-sm font-bold text-primary dark:text-gray-300 uppercase tracking-wider"
                       for="dob">Date of Birth</label>
                <div class="flex gap-2">
                    <div class="relative flex-grow">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 material-symbols-outlined text-gray-400">cake</span>
                        <input class="w-full pl-12 pr-4 py-3 rounded-xl border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 focus:ring-primary focus:border-primary text-primary dark:text-white font-medium"
                               @bind="profile.DateOfBirth"
                               id="dob" type="date" />
                    </div>
                    <button class="px-4 rounded-xl border border-gray-200 dark:border-gray-700 hover:bg-red-50 dark:hover:bg-red-900/20 text-red-500 transition-colors flex items-center justify-center group"
                            @onclick="ClearBirthDate"
                            title="Clear date" type="button">
                        <span class="cursor-pointer material-symbols-outlined">backspace</span>
                    </button>
                </div>
                <p class="text-xs text-gray-400 italic">We might send a surprise on your birthday!</p>
            </div>
            <div class="flex items-center justify-end gap-4 pt-4 border-t border-gray-100 dark:border-gray-800">
                @* 1. The Cancel Button simply flips the bool *@
                <button @onclick="OnCancel"
                        class="cursor-pointer px-6 py-3 rounded-full font-bold text-secondary dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors"
                        type="button">
                    Cancel
                </button>

                @* 2. The Save button should ideally call a method that saves data THEN closes the modal *@
                <button @onclick="HandleSave"
                        class="cursor-pointer px-8 py-3 bg-primary hover:bg-orange-600 text-white font-bold rounded-full shadow-lg shadow-orange-200 dark:shadow-none transition-all transform hover:scale-105 active:scale-95"
                        type="button">
                    @* Changed type to button to prevent default form refresh *@
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@code {

    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private bool isSaving = false;
    private UserProfileDto profile = new();

    protected override async Task OnInitializedAsync()
    {
        if (await AccountService.GetProfileAsync() is { } data)
        {
            profile = data;
        }
    }

    private void ClearBirthDate()
    {
        profile.DateOfBirth = null;
    }

    private async Task HandleSave()
    {
        isSaving = true;
        var result = await AccountService.UpdateProfileAsync(profile);

        await Task.Delay(2000);

        if (result.Success)
        {
            await OnSave.InvokeAsync(); // Tell parent to close modal
        }
        isSaving = false;
    }
}