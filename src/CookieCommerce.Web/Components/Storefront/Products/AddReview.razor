@using CookieCommerce.Web.Models.Reviews
@using CookieCommerce.Web.Services
@inject IAuthService Auth
@inject IAccountService AccountService
@inject NavigationManager Nav

<style>
    /* Ensure clicked paws stay solid */
    .filled-paw {
        font-variation-settings: 'FILL' 1;
    }

    /* Keep the hover-fill logic working for non-selected paws */
    .group\/rating:hover span {
        font-variation-settings: 'FILL' 0;
    }

    .group\/rating button:hover span,
    .group\/rating button:hover ~ button span {
        font-variation-settings: 'FILL' 1 !important;
        color: #D97706 !important;
        opacity: 1 !important;
    }
</style>

@if (alreadyReviewed)
{
    <div class="relative z-10 mt-4 animate-in zoom-in-95 duration-500">
        <div class="flex flex-col md:flex-row items-center gap-6 p-6 bg-white/40 dark:bg-surface-dark rounded-[32px] border-2 border-dashed border-primary/30">

            <div class="relative flex-shrink-0">
                <div class="w-16 h-16 bg-primary rounded-2xl rotate-3 flex items-center justify-center shadow-lg shadow-primary/20">
                    <span class="material-symbols-outlined text-white text-3xl filled-paw">verified</span>
                </div>
                <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-orange-100 rounded-full flex items-center justify-center border-2 border-white">
                    <span class="text-lg">🐾</span>
                </div>
            </div>

            <div class="text-center md:text-left space-y-1 dark:text-gray-400">
                <h4 class="text-lg font-black ">Your roar was heard!</h4>
                <p class="text-sm text-gray-500 font-medium">
                    You've already shared your wild experience for this treat. The pride thanks you! 🐯✨
                </p>
            </div>

            <div class="ml-auto flex items-center gap-2 px-4 py-2 bg-white rounded-full border border-orange-100 shadow-sm">
                <span class="text-xs font-black text-primary uppercase tracking-tighter">Your Score:</span>
                <div class="flex items-center">
                    @for (int i = 0; i < selectedRating; i++)
                    {
                        <span class="material-symbols-outlined text-primary text-sm filled-paw">pets</span>
                    }
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="relative flex flex-col p-6 bg-[#FEF9E7]  dark:bg-surface-dark  border-2 border-dashed border-orange-200 rounded-[40px] overflow-hidden group">

        <div class="absolute -right-12 -bottom-10 opacity-[0.08] pointer-events-none z-0">
            <span class="material-symbols-outlined text-[200px] text-orange-900 rotate-[25deg]"
                  style="font-variation-settings: 'FILL' 1;">pets</span>
        </div>

        <div class="relative z-10 flex flex-col md:flex-row items-center justify-between">
            <div class="flex items-center gap-5">
                <div class="relative">
                    <div class="w-20 h-20 rounded-2xl overflow-hidden border-4 border-white shadow-lg">
                        <img src="/images/logo.png" alt="Tiger Mascot" class="w-full h-full object-cover">
                    </div>
                    <div class="absolute -top-2 -right-2 bg-[#FF5F5F] text-primary w-7 h-7 bg-white
                        rounded-full flex items-center justify-center shadow-md border-2 border-primary">
                        <span class="material-symbols-outlined text-xs filled-paw pointer-events-none">favorite</span>
                    </div>
                </div>
                <div class="space-y-1">
                    <h3 class="text-xl font-black">How roar-some was your cookie?</h3>
                    <p class="text-sm text-gray-500 font-medium">Share your wild experience with our pride!</p>
                </div>
            </div>

            <div class="mt-6 md:mt-0 flex items-center gap-4 bg-white/60 backdrop-blur-sm p-2
                rounded-3xl border border-white shadow-sm dark:bg-gray-800 dark:border-gray-700">
                <div class="flex flex-row-reverse items-center justify-end gap-1 px-4 group/rating">
                    @for (int i = 5; i >= 1; i--)
                    {
                        var ratingValue = i;
                        <button @onclick="() => SetRating(ratingValue)"
                                class="cursor-pointer peer group/paw transition-transform hover:scale-110 active:scale-95">
                            <span class="material-symbols-outlined transition-all duration-200
                                                @(selectedRating >= ratingValue ? "text-[#F3C28B] filled-paw" : "text-gray-300 dark:text-gray-600 group-hover/rating:opacity-40 peer-hover:opacity-100")">
                                pets
                            </span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @if (selectedRating > 0)
        {
            <div class="relative z-10 mt-6 space-y-4 animate-in slide-in-from-top-4 duration-500 ">
                <div class="relative">
                    <textarea @bind="reviewText"
                              placeholder="Tell us about your wild treat... 🐯"
                              class="w-full min-h-[120px] p-5 rounded-xl border-2 border-orange-100 bg-white/80 focus:bg-white focus:border-primary focus:ring-4 focus:ring-primary/10 outline-none transition-all resize-none text-[#4A2C2A] font-medium placeholder:text-gray-400">
                        </textarea>
                    <div class="absolute text-sm left-5 font-black uppercase tracking-widest
                            text-orange-300 pointer-events-none">
                        Tigers never lie!
                    </div>
                </div>

                <div class="flex justify-stretch md:justify-end">
                    <button @onclick="SubmitReview"
                            disabled="@isSubmitting"
                            class="group relative flex flex-1 mt-5 md:flex-none items-center 
                            justify-center gap-2 px-8 py-4 md:py-3 bg-primary text-white font-black rounded-2xl 
                            shadow-lg shadow-primary/20 hover:scale-105 active:scale-95 transition-all overflow-hidden 
                            disabled:opacity-70 disabled:cursor-not-allowed">

                        <span class="relative z-10 uppercase tracking-widest text-xs">
                            @(isSubmitting ? "Sending Roar..." : "Submit Roarview")
                        </span>

                        @if (isSubmitting)
                        {
                            <span class="material-symbols-outlined relative z-10 text-sm animate-spin">
                                progress_activity
                            </span>
                        }
                        else
                        {
                            <span class="material-symbols-outlined relative z-10 text-sm">send</span>
                        }

                        <div class="absolute inset-0 bg-white/20 translate-x-[-100%] @(!isSubmitting ? "group-hover:translate-x-[100%]" : "") transition-transform duration-700 skew-x-12">
                        </div>
                    </button>
                </div>
            </div>
        }
    </div>

}


@code {
    [Parameter] public Guid ProductId { get; set; }
    private int selectedRating = 0;
    private string reviewText = "";
    private bool alreadyReviewed = false;
    private bool isSubmitting = false;

    protected override async Task OnInitializedAsync()
    {
        if (Auth.IsLoggedIn)
        {
            var result = await AccountService.HasAlreadyReviewedProductIdAsync(ProductId);
            alreadyReviewed = result.Item1;
            selectedRating = result.Item2;
        }
        
    }

    private void SetRating(int value)
    {
        if (!Auth.IsLoggedIn) 
        {
            var returnUrl = Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri));
            Nav.NavigateTo($"/auth/signin/?returnUrl={returnUrl}");
            return;
        }
        selectedRating = value;
    }

    private async Task SubmitReview()
    {
        if (isSubmitting) return;

        isSubmitting = true;

        if (!Auth.IsLoggedIn)
        {
            var returnUrl = Uri.EscapeDataString(Nav.ToBaseRelativePath(Nav.Uri));
            Nav.NavigateTo($"/auth/signin/?returnUrl={returnUrl}");
            return;
        }

        await AccountService.SubmitReviewAsync(ProductId, new ReviewSubmitRequest
        {
            Comment = reviewText,
            Rating = selectedRating
        });

        alreadyReviewed = true;
        isSubmitting = false;
    }
}