<div class="@(CurrentStep < 2 ? "opacity-60" : "cookie-shadow") bg-white dark:bg-surface-dark rounded-2xl border border-amber-100 dark:border-amber-900/30 overflow-hidden cookie-shadow">
    <div class="p-6 flex items-center gap-4 border-b border-amber-50 dark:border-amber-900/20 bg-amber-50/30 dark:bg-amber-900/10">
        <span class="@(CurrentStep >= 2 ? "bg-primary text-white" : "bg-gray-200 text-gray-500") w-8 h-8 rounded-full bg-amber-200 dark:bg-amber-900/50 text-amber-700 dark:text-amber-200 flex items-center justify-center font-bold">2</span>
        <h2 class="font-display font-bold text-xl dark:text-amber-50">Contact & Shipping</h2>

        @if (CurrentStep > 2)
        {
            <button @onclick="() => GoToStep(2)" class="cursor-pointer ml-auto text-primary text-sm font-bold hover:underline">Edit</button>
        }
    </div>
    @if (CurrentStep == 2)
    {
        <div class="p-8 space-y-6 animate-in fade-in slide-in-from-top-4 duration-300">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-bold mb-2 text-gray-700 dark:text-amber-100/80">First Name</label>
                    <input class="w-full px-5 py-3 rounded-full border-amber-100 dark:border-amber-900/30 focus:border-primary focus:ring-primary bg-background-light/30 dark:bg-amber-900/10 dark:text-white dark:placeholder-gray-500"
                           placeholder="Roary"
                           @bind="ShippingFirstName"
                           @bind:event="oninput"
                           @bind:after="UpdateShippingFirstName"
                           type="text" />
                </div>
                <div>
                    <label class="block text-sm font-bold mb-2 text-gray-700 dark:text-amber-100/80">Last Name</label>
                    <input class="w-full px-5 py-3 rounded-full border-amber-100 dark:border-amber-900/30 focus:border-primary focus:ring-primary bg-background-light/30 dark:bg-amber-900/10 dark:text-white dark:placeholder-gray-500"
                           placeholder="Tiger"
                           @bind="ShippingLastName"
                           @bind:event="oninput"
                           @bind:after="UpdateShippingLastName"
                           type="text" />
                </div>
            </div>

            <h3 class="font-display text-lg text-primary uppercase tracking-widest flex items-center gap-2">
                <span class="material-symbols-outlined text-xl">local_shipping</span>
                Shipping Address
            </h3>

            <DutchAddressLookup PostalCode="@ShippingPostalCode"
                                HouseNumber="@ShippingHouseNumber"
                                HouseNumberAddition="@ShippingHouseNumberAddition"
                                OnAddressFound="HandleShippingAddressUpdated"
                                PostalCodeChanged="UpdateShippingPostalCode"
                                HouseNumberChanged="UpdateShippingHouseNumber"
                                HouseNumberAdditionChanged="UpdateShippingHouseNumberAddition" />

            <div>
                <label class="flex items-center gap-3 cursor-pointer group">
                    <input type="checkbox"
                           @bind="SameAsShipping"
                           @bind:after="UpdateSameAsShipping"
                           class="w-5 h-5 rounded-full border-amber-200 text-primary focus:ring-primary accent-primary cursor-pointer" />
                    <span class="text-sm font-semibold text-gray-600 dark:text-amber-100/70 group-hover:text-primary transition-colors">
                        Billing address same as Shipping?
                    </span>
                </label>
            </div>

            @if (!SameAsShipping)
            {
                <div class="h-px w-full bg-gradient-to-r from-transparent via-amber-200 dark:via-amber-900/50 to-transparent my-8"></div>
                <h3 class="font-display text-lg text-primary uppercase tracking-widest flex items-center gap-2">
                    <span class="material-symbols-outlined text-xl">receipt_long</span>
                    Billing Address
                </h3>

                <DutchAddressLookup PostalCode="@BillingPostalCode"
                                    HouseNumber="@BillingHouseNumber"
                                    HouseNumberAddition="@BillingHouseNumberAddition"
                                    OnAddressFound="HandleBillingAddressUpdated"
                                    PostalCodeChanged="UpdateBillingPostalCode"
                                    HouseNumberChanged="UpdateBillingHouseNumber"
                                    HouseNumberAdditionChanged="UpdateBillingHouseNumberAddition" />

            }

            <div class="flex justify-end pt-4">
                <button @onclick="() => GoToStep(3)"
                        disabled="@DisableContinueFromStep2()"
                        class="px-8 py-3 rounded-full font-bold transition-all 
                                @(DisableContinueFromStep2()
                                    ? "bg-gray-300 cursor-not-allowed text-gray-500" 
                                    : "bg-primary hover:bg-amber-700 shadow-xl cursor-pointer text-white")">
                    Continue to Delivery Method
                </button>


            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int CurrentStep { get; set; }
    [Parameter] public EventCallback<int> CurrentStepChanged { get; set; }

    [Parameter] public string ShippingFirstName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ShippingFirstNameChanged { get; set; }

    [Parameter] public string ShippingLastName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ShippingLastNameChanged { get; set; }

    [Parameter] public string ShippingPostalCode { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ShippingPostalCodeChanged { get; set; }

    [Parameter] public string ShippingHouseNumber { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ShippingHouseNumberChanged { get; set; }

    [Parameter] public string ShippingHouseNumberAddition { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ShippingHouseNumberAdditionChanged { get; set; }

    [Parameter] public string ShippingAddress { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ShippingAddressChanged { get; set; }

    [Parameter] public string ShippingCity { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ShippingCityChanged { get; set; }

    [Parameter] public string ShippingProvince { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ShippingProvinceChanged { get; set; }

    [Parameter] public bool SameAsShipping { get; set; } = true;
    [Parameter] public EventCallback<bool> SameAsShippingChanged { get; set; }

    [Parameter] public string BillingFirstName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> BillingFirstNameChanged { get; set; }

    [Parameter] public string BillingLastName { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> BillingLastNameChanged { get; set; }

    [Parameter] public string BillingPostalCode { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> BillingPostalCodeChanged { get; set; }

    [Parameter] public string BillingHouseNumber { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> BillingHouseNumberChanged { get; set; }

    [Parameter] public string BillingHouseNumberAddition { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> BillingHouseNumberAdditionChanged { get; set; }

    [Parameter] public string BillingAddress { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> BillingAddressChanged { get; set; }

    [Parameter] public string BillingCity { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> BillingCityChanged { get; set; }

    [Parameter] public string BillingProvince { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> BillingProvinceChanged { get; set; }

    private async Task GoToStep(int step) => await CurrentStepChanged.InvokeAsync(step);

    private async Task UpdateShippingFirstName() => await ShippingFirstNameChanged.InvokeAsync(ShippingFirstName);
    private async Task UpdateShippingLastName() => await ShippingLastNameChanged.InvokeAsync(ShippingLastName);

    private async Task UpdateShippingPostalCode(string value) { ShippingPostalCode = value; await ShippingPostalCodeChanged.InvokeAsync(ShippingPostalCode); }
    private async Task UpdateShippingHouseNumber(string value) { ShippingHouseNumber = value; await ShippingHouseNumberChanged.InvokeAsync(ShippingHouseNumber); }
    private async Task UpdateShippingHouseNumberAddition(string value) { ShippingHouseNumberAddition = value; await ShippingHouseNumberAdditionChanged.InvokeAsync(ShippingHouseNumberAddition); }

    private async Task UpdateSameAsShipping() { 
        await SameAsShippingChanged.InvokeAsync(SameAsShipping);
        if (SameAsShipping) {
            await BillingAddressChanged.InvokeAsync(ShippingAddress);
            await BillingCityChanged.InvokeAsync(ShippingCity);
            await BillingProvinceChanged.InvokeAsync(ShippingProvince);
            await BillingPostalCodeChanged.InvokeAsync(ShippingPostalCode);
            await BillingHouseNumberChanged.InvokeAsync(ShippingHouseNumber);
            await BillingHouseNumberAdditionChanged.InvokeAsync(ShippingHouseNumberAddition);
            await BillingFirstNameChanged.InvokeAsync(ShippingFirstName);
            await BillingLastNameChanged.InvokeAsync(ShippingLastName);
        }
    }

    private async Task UpdateBillingPostalCode(string value) { BillingPostalCode = value; await BillingPostalCodeChanged.InvokeAsync(BillingPostalCode); }
    private async Task UpdateBillingHouseNumber(string value) { BillingHouseNumber = value; await BillingHouseNumberChanged.InvokeAsync(BillingHouseNumber); }
    private async Task UpdateBillingHouseNumberAddition(string value) { BillingHouseNumberAddition = value; await BillingHouseNumberAdditionChanged.InvokeAsync(BillingHouseNumberAddition); }

    private async Task HandleShippingAddressUpdated(DutchAddressLookup.AddressUpdateEventArgs e)
    {
        ShippingAddress = e.Street;
        ShippingCity = e.City;
        ShippingProvince = e.Province;
        await ShippingAddressChanged.InvokeAsync(ShippingAddress);
        await ShippingCityChanged.InvokeAsync(ShippingCity);
        await ShippingProvinceChanged.InvokeAsync(ShippingProvince);
        
        if (SameAsShipping)
        {
            BillingAddress = ShippingAddress;
            BillingCity = ShippingCity;
            BillingProvince = ShippingProvince;
            BillingPostalCode = ShippingPostalCode;
            await BillingAddressChanged.InvokeAsync(BillingAddress);
            await BillingCityChanged.InvokeAsync(BillingCity);
            await BillingProvinceChanged.InvokeAsync(BillingProvince);
            await BillingPostalCodeChanged.InvokeAsync(BillingPostalCode);
        }
    }

    private async Task HandleBillingAddressUpdated(DutchAddressLookup.AddressUpdateEventArgs e)
    {
        BillingAddress = e.Street;
        BillingCity = e.City;
        BillingProvince = e.Province;
        await BillingAddressChanged.InvokeAsync(BillingAddress);
        await BillingCityChanged.InvokeAsync(BillingCity);
        await BillingProvinceChanged.InvokeAsync(BillingProvince);
    }

    private bool DisableContinueFromStep2()
    {
        if (string.IsNullOrWhiteSpace(ShippingFirstName) ||
            string.IsNullOrWhiteSpace(ShippingLastName) ||
            string.IsNullOrWhiteSpace(ShippingAddress) ||
            string.IsNullOrWhiteSpace(ShippingCity) ||
            string.IsNullOrWhiteSpace(ShippingPostalCode) ||
            string.IsNullOrWhiteSpace(ShippingHouseNumber) ||
            string.IsNullOrWhiteSpace(ShippingProvince))
            return true;

        if (!SameAsShipping)
        {
            if (string.IsNullOrWhiteSpace(BillingFirstName) ||
                string.IsNullOrWhiteSpace(BillingLastName) ||
                string.IsNullOrWhiteSpace(BillingAddress) ||
                string.IsNullOrWhiteSpace(BillingCity) ||
                string.IsNullOrWhiteSpace(BillingPostalCode) ||
                string.IsNullOrWhiteSpace(BillingHouseNumber) ||
                string.IsNullOrWhiteSpace(BillingProvince))
                return true;
        }
        return false;
    }
}
