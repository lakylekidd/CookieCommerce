@using CookieCommerce.Web.Components.Shared.ProductComponents
@using CookieCommerce.Web.Models.Order


<div class="bg-surface-light dark:bg-surface-dark p-6 rounded-[2.5rem] shadow-sm border border-orange-50 dark:border-stone-700">
    <h3 class="text-lg font-bold font-display text-primary mb-6">Cookies to Bake</h3>
    <div class="flex flex-col gap-4">
        @if (IsLoading)
        {
            @* Render 5 skeleton rows *@
            @for (int i = 0; i < 5; i++)
            {
                <div class="flex items-center gap-3 w-full p-2 animate-skeleton">
                    <div class="w-8 h-8 rounded-full bg-stone-200 dark:bg-stone-700 flex-shrink-0"></div>
                    <div class="h-4 bg-stone-200 dark:bg-stone-700 rounded-md w-32"></div>
                    <div class="ml-auto w-8 h-6 bg-stone-200 dark:bg-stone-700 rounded-lg"></div>
                </div>
            }
        }
        else
        {
            @foreach (var item in QuotaItems.OrderByDescending(x => x.Quantity))
            {
                <SmallCookieImageWithName ImageUrl="@item.ProductImageUrl"
                                          Quantity="@item.Quantity"
                                          Name="@item.ProductName" />
            }
        }
    </div>
</div>


@code {
    [Parameter] public ICollection<QuotaOrderItemDto> QuotaItems { get; set; } = [];
    [Parameter] public bool IsLoading { get; set; } = true;
}