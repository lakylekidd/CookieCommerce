@using CookieCommerce.Web.Models.Addresses
@using CookieCommerce.Web.Services
@rendermode InteractiveServer
@inject IAccountService AccountService

<div class="bg-card-light dark:bg-card-dark rounded-xl p-6 shadow-sm border-2 @(address.IsDefault? "border-primary" : "") relative overflow-hidden flex flex-col h-full">
    <div class="flex justify-between items-start mb-4">
        <div class="flex items-center gap-2">
            <div class="w-10 h-10 rounded-lg bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined">@address.Icon</span>
            </div>
            <h3 class="font-bold text-lg text-gray-900 dark:text-white">@address.Label</h3>
        </div>
        @if (address.IsDefault)
        {
            <span class="bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-300 text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">Primary</span>
        }
    </div>
    <div class="flex-grow space-y-1 mb-6">
        <p class="font-semibold text-gray-800 dark:text-gray-100">@address.FirstName @address.LastName</p>
        <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
            @address.Street<br />
            @address.PostalCode, @address.City<br />
            @address.Country
        </p>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-2">@address.Phone</p>
    </div>
    <div class="flex items-center justify-between pt-4 border-t border-gray-100 dark:border-gray-800">

        @if(address.IsDefault)
        {
            <span class="text-xs font-bold text-green-600 dark:text-green-400 flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">check_circle</span>
                Default Address
            </span>
        }
        else
        {
            <button @onclick="HandleSetPrimaryAsync"
                    disabled="@isProcessing"
                    class="cursor-pointer text-primary hover:text-orange-600 text-sm font-bold flex items-center gap-2 disabled:opacity-50">
                @if (isProcessing)
                {
                    <div class="w-4 h-4 border-2 border-primary/30 border-t-primary rounded-full animate-spin"></div>
                }
                Set as Primary
            </button>
        }

        <button @onclick="HandleDeleteAsync"
                disabled="@isProcessing"
                class="cursor-pointer flex items-center justify-center text-gray-400 hover:text-red-500 transition-colors p-2 rounded-full hover:bg-red-50 dark:hover:bg-red-900/20 disabled:opacity-50">
            @if (isProcessing)
            {
                <div class="w-5 h-5 border-2 border-red-200 border-t-red-500 rounded-full animate-spin"></div>
            }
            else
            {
                <span class="material-symbols-outlined">delete</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter] public AddressBookItemDto address { get; set; } = default!;
    [Parameter] public EventCallback OnAddressChanged { get; set; }

    private bool isProcessing = false;

    private async Task HandleDeleteAsync()
    {
        if (isProcessing) return;
        isProcessing = true;
        await Task.Delay(500);
        await AccountService.DeleteAddressAsync(address.Id);
        await OnAddressChanged.InvokeAsync();
        isProcessing = false;
    }

    private async Task HandleSetPrimaryAsync()
    {
        if (isProcessing) return;

        isProcessing = true;
        await Task.Delay(500);
        await AccountService.SetAsPrimaryAsync(address.Id);
        await OnAddressChanged.InvokeAsync();
        isProcessing = false;
    }
}