@using CookieCommerce.Web.Services
@inject NavigationManager Navigation
@rendermode InteractiveServer
@inject IAuthService Auth

<aside class="hidden md:flex w-64 flex-col bg-surface-light dark:bg-surface-dark border-r border-orange-100 dark:border-stone-800 shadow-sm z-20 transition-colors duration-300">
    <div class="flex items-center justify-center h-24 border-b border-orange-50 dark:border-stone-800">
        <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-full bg-primary flex items-center justify-center overflow-hidden border-2 border-white dark:border-stone-700 shadow-md">
                <img alt="Tiger Chef Logo" class="w-full h-full object-cover"
                     src="https://lh3.googleusercontent.com/aida-public/AB6AXuB_G-EgNMVhnPDw8cQJWsyMikXgUEkepIHoXfCGXvWo1HfukYgAesdWE7EVDcdzgDf-i4yMUaTZHL0Nl9nrFTQncs_bZwVWLEa-zQXO_r-xQHJ-fieaa6kZFc21i414OpMVhdJVib6QxYy_UDi0Ex6yT8W-tzGMxCAuTXYQin_9gvMR6VECyDDefDvo948favzov4lj9_OUfawcfC2lmEDvtQDzptDhyzOyS8Js20nLjrgEsO-v9z1edIR9UyFDpKwo1NgSBCC-4g" />
            </div>
            <div>
                <h1 class="font-display font-bold text-lg text-secondary dark:text-orange-100 leading-tight">
                    Tiger van Cookie
                </h1>
                <p class="text-xs text-stone-500 dark:text-stone-400">Admin Panel</p>
            </div>
        </div>
    </div>
    <nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
        <a class="flex items-center px-4 py-3 bg-primary/10 text-primary dark:text-primary rounded-xl transition-all group"
           href="#">
            <span class="material-icons-round text-2xl mr-3">dashboard</span>
            <span class="font-bold">Dashboard</span>
        </a>
        <p class="px-4 mt-6 mb-2 text-xs font-bold text-stone-400 dark:text-stone-500 uppercase tracking-wider">
            Store Management
        </p>
        <a class="flex items-center px-4 py-3 text-stone-600 dark:text-stone-300 hover:bg-orange-50 dark:hover:bg-stone-800 hover:text-primary dark:hover:text-primary rounded-xl transition-all group"
           href="#">
            <span class="material-icons-round text-2xl mr-3 group-hover:scale-110 transition-transform">cookie</span>
            <span class="font-semibold">Products</span>
        </a>
        <a class="flex items-center px-4 py-3 text-stone-600 dark:text-stone-300 hover:bg-orange-50 dark:hover:bg-stone-800 hover:text-primary dark:hover:text-primary rounded-xl transition-all group"
           href="#">
            <span class="material-icons-round text-2xl mr-3 group-hover:scale-110 transition-transform">receipt_long</span>
            <span class="font-semibold">Orders</span>
            <span class="ml-auto bg-primary text-white text-xs font-bold px-2 py-1 rounded-lg shadow-sm">12</span>
        </a>
        <a class="flex items-center px-4 py-3 text-stone-600 dark:text-stone-300 hover:bg-orange-50 dark:hover:bg-stone-800 hover:text-primary dark:hover:text-primary rounded-xl transition-all group"
           href="#">
            <span class="material-icons-round text-2xl mr-3 group-hover:scale-110 transition-transform">people</span>
            <span class="font-semibold">Customers</span>
        </a>
        <p class="px-4 mt-6 mb-2 text-xs font-bold text-stone-400 dark:text-stone-500 uppercase tracking-wider">
            Analytics &amp; Settings
        </p>
        <a class="flex items-center px-4 py-3 text-stone-600 dark:text-stone-300 hover:bg-orange-50 dark:hover:bg-stone-800 hover:text-primary dark:hover:text-primary rounded-xl transition-all group"
           href="#">
            <span class="material-icons-round text-2xl mr-3 group-hover:scale-110 transition-transform">insights</span>
            <span class="font-semibold">Reports</span>
        </a>
        <a class="flex items-center px-4 py-3 text-stone-600 dark:text-stone-300 hover:bg-orange-50 dark:hover:bg-stone-800 hover:text-primary dark:hover:text-primary rounded-xl transition-all group"
           href="#">
            <span class="material-icons-round text-2xl mr-3 group-hover:scale-110 transition-transform">settings</span>
            <span class="font-semibold">Settings</span>
        </a>
    </nav>
    <div class="p-4 border-t border-orange-50 dark:border-stone-800">
        <button @onclick="Logout"
                class="flex items-center cursor-pointer text-center align-content-center w-full gap-3 px-4 py-3 rounded-lg text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors font-medium">
            <span class="material-icons text-xl">logout</span>
            Logout
        </button>

    </div>
</aside>


@code {
    public void Logout()
    {
        Auth.Logout();
        Navigation.NavigateTo("/storefront");
    }
}