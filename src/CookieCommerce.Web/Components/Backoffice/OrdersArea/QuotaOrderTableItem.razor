@using CookieCommerce.Web.Components.Account.Orders
@using CookieCommerce.Web.Components.Shared.OrderComponents
@using CookieCommerce.Web.Components.Shared.ProductComponents
@using CookieCommerce.Web.Models.Order
@using CookieCommerce.Web.Services
@rendermode InteractiveServer
@inject IBackofficeService BackofficeService

<style>
    @@keyframes oven-glow {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }
    @@keyframes fresh-shimmer {
        0% {
            background-position: 0% 50%;
        }

        50% {
            background-position: 100% 50%;
        }

        100% {
            background-position: 0% 50%;
        }
    }

    .is-ready-row {
        background: linear-gradient(-45deg, #f0fdf4, #dcfce7, #f0fdf4, #ffffff);
        background-size: 400% 400%;
        animation: fresh-shimmer 4s ease-in-out infinite;
    }

    .dark .is-ready-row {
        background: linear-gradient(-45deg, #064e3b20, #065f4630, #064e3b20, #1c1917);
        background-size: 400% 400%;
        animation: fresh-shimmer 4s ease-in-out infinite;
    }

    .is-baking-row {
        background: linear-gradient(-45deg, #fffaf0, #ffedd5, #fee2e2, #fff7ed);
        background-size: 400% 400%;
        animation: oven-glow 3s ease infinite;
    }

    .dark .is-baking-row {
        background: linear-gradient(-45deg, #1c1917, #292524, #441515, #292524);
        background-size: 400% 400%;
        animation: oven-glow 3s ease infinite;
    }
</style>

<tr class="cursor-pointer transition-all duration-700 relative 
           @(Order.Status?.StatusId == 4 ? "is-baking-row" : "") 
           @(Order.Status?.StatusId == 5 ? "is-ready-row" : "")
           @(!(Order.Status?.StatusId == 4 || Order.Status?.StatusId == 5) ? "hover:bg-orange-50/30 dark:hover:bg-gray-800/30" : "")">
    <td class="px-6 py-6 hidden sm:table-cell">
        <OrderDateAndReference 
            OrderReference="@Order.OrderReference" 
            PlacedOn="@Order.PlacedOn" />
    </td>
    <td>
        <OrderCustomer AddressInformation="@Order.Address" />
    </td>
    <td class="">
        <div class="flex -space-x-2">
            @foreach (var item in Order.Items)
            {
                <div class="relative group flex items-center">
                    <SmallCookieImage ImageUrl="@item.ProductImageUrl"
                                      Name="@item.ProductName" />
                    <span class="absolute -top-10 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 transition-all duration-200 rounded bg-primary p-2 text-[10px] font-bold text-white whitespace-nowrap z-50 shadow-xl pointer-events-none origin-bottom">
                        @item.Quantity x @item.ProductName
                        <span class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-primary"></span>
                    </span>
                </div>
            }
        </div>        
    </td>
    <td>
        <div class="flex flex-col gap-1 items-start">
            <OrderStatus Status="@Order.Status" />
            @if (Order.Status?.StatusId == 4 && Shortfalls.Count > 0)
            {
                @foreach (var missing in Shortfalls)
                {
                    <span class="inline-flex text-[10px] font-medium text-red-500 whitespace-nowrap">@missing.MissingQuantity × @missing.CookieName missing</span>
                }
            }
        </div>
    </td>
    <td>
        <p class="font-bold">@Order.CurrencySymbol@Order.Total.ToString("N2")</p>
    </td>
    <td>
        <Handler 
            Icon="@Order.ShippingInformation.Icon" 
            Name="@Order.ShippingInformation.Carrier" />
    </td>
    @* 🐯 KITCHEN ACTIONS *@
    <td class="px-6 py-4 text-right">
        @if (Order.Status?.StatusId == 2) @* Confirmed *@
        {
            <button @onclick="StartProcessing" @onclick:stop="true"
                    class="cursor-pointer size-10 inline-flex items-center justify-center bg-white dark:bg-stone-900 border-2 border-orange-200 dark:border-stone-700 text-orange-500 hover:border-orange-500 hover:bg-orange-500 hover:text-white rounded-full transition-all shadow-sm active:scale-90">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                </svg>
            </button>
        }
        else if (Order.Status?.StatusId == 4)
        @* Processing / Baking *@
        {
            <div class="flex flex-row items-center justify-end gap-1">
                @if (Shortfalls.Count > 0)
                {
                    <button disabled @onclick:stop="true"
                            class="opacity-40 cursor-not-allowed size-10 inline-flex items-center justify-center bg-white dark:bg-stone-900 border-2 border-emerald-200 dark:border-emerald-900/50 text-emerald-500 rounded-full shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </button>
                }
                else
                {
                    <button @onclick="ReadyForPickup" @onclick:stop="true"
                            class="cursor-pointer size-10 inline-flex items-center justify-center bg-white dark:bg-stone-900 border-2 border-emerald-200 dark:border-emerald-900/50 text-emerald-500 hover:border-emerald-500 hover:bg-emerald-500 hover:text-white rounded-full transition-all shadow-sm active:scale-90 shadow-emerald-100">
                        <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                        </svg>
                    </button>
                }
                <div class="inline-flex items-center justify-center size-10 text-orange-600 dark:text-orange-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                    </svg>
                </div>
            </div>
        }
        @* PHASE 3: Ready for Pickup (Static Icon) *@
        else if (Order.Status?.StatusId == 5)
        {
            <div class="inline-flex items-center justify-center size-10 text-emerald-600 dark:text-emerald-400 animate-pulse">
                <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
            </div>
        }
    </td>
</tr>

@code {
    [Parameter] public QuotaOrderDto Order { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public EventCallback<QuotaOrderDto> OnStatusUpdated { get; set; }
    [Parameter] public IReadOnlyList<MissingCookieDto> Shortfalls { get; set; } = [];

    private async Task StartProcessing()
    {
        await BackofficeService.SetOrderAsProcessing(Order.Id);

        Order.Status = new OrderStatusDto { StatusId = 4, Status = "Processing" };

        await OnStatusUpdated.InvokeAsync(Order);
        StateHasChanged();
    }

    private async Task ReadyForPickup()
    {
        await BackofficeService.SetOrderAsReadyForPickup(Order.Id);

        Order.Status = new OrderStatusDto { StatusId = 5, Status = "Ready for Pickup" };

        await OnStatusUpdated.InvokeAsync(Order);
        StateHasChanged();
    }
}