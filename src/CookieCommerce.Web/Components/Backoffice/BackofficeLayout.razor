@inherits LayoutComponentBase
@layout MainLayout

<style>
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #EA9654;
        border-radius: 4px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #d67d38;
        }

    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
    }
</style>

@using CookieCommerce.Web.Services
@inject IAuthService Auth
@implements IDisposable
@if (ready && Auth.IsAdmin)
{
<div class="backoffice-ui bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark font-sans antialiased transition-colors duration-300">
    <div class="flex h-screen overflow-hidden">
        <BackofficeASide />
        <main class="flex-1 flex flex-col h-screen overflow-hidden bg-background-light dark:bg-background-dark relative">
            <BackofficeHeader />
            <div class="flex-1 overflow-y-auto p-8 flex flex-col">
                @Body                
            </div>
            <BackofficeFooter />
        </main>
    </div>
</div>

}
else
{
    <main class="container mx-auto p-8"><p>Sign in with an authorized account to view this page.</p><a href="/auth/signin">Sign in</a></main>
}
@code {
    private bool ready;
    protected override void OnInitialized() => Auth.OnChange += Refresh;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Auth.InitializeAsync();
        ready = true;
        StateHasChanged();
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.OnChange -= Refresh;
}
