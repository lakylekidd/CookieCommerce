@using CookieCommerce.Web.Components.Shared.ProductComponents
@using CookieCommerce.Web.Models.Backoffice
@using System.Globalization

<div class="bg-surface-light dark:bg-surface-dark p-6 rounded-2xl shadow-sm border border-orange-50 dark:border-stone-700">
    <h3 class="text-lg font-bold font-display text-primary dark:text-stone-200 mb-6">
        Top Selling Cookies
    </h3>
    <div class="space-y-4">
        @if (IsLoading)
        {
            @* Render 3 skeleton rows while loading *@
            @for (int i = 0; i < 3; i++)
            {
                <div class="flex items-center gap-4 p-3">
                    @* Image Skeleton *@
                    <div class="w-8 h-8 rounded-full animate-skeleton shadow-sm"></div>

                    @* Name and Sales Skeleton *@
                    <div class="flex-1 space-y-2">
                        <div class="h-4 w-24 animate-skeleton rounded-md"></div>
                        <div class="h-3 w-12 animate-skeleton rounded-md"></div>
                    </div>

                    @* Revenue Skeleton *@
                    <div class="h-4 w-16 animate-skeleton rounded-md"></div>
                </div>
            }
        }
        else
        {
            @foreach (var cookie in Cookies.OrderBy(x => x.Rank))
            {
                <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-stone-50 dark:hover:bg-stone-800 transition-colors">
                    <SmallCookieImage ImageUrl="@cookie.ImageUrl" Name="@cookie.Name" />
                    <div class="flex-1">
                        <h4 class="font-bold text-stone-700 dark:text-stone-200 text-sm">
                            @cookie.Name
                        </h4>
                        <p class="text-xs text-stone-500">@cookie.SalesCount sales</p>
                    </div>
                    <span class="font-bold text-primary">
                        €@cookie.Revenue.ToString("N2", CultureInfo.GetCultureInfo("nl-NL"))
                    </span>
                </div>
            }
        }
    </div>

    <button class="w-full mt-6 py-3 text-sm font-bold text-primary border border-primary/30 rounded-xl hover:bg-primary hover:text-white transition-colors">
        View All Products
    </button>
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public List<CookieRankDto> Cookies { get; set; } = [];
}