@page "/legal/faq"
@layout Legal.LegalMain

<div class="lg:w-[70%] bg-surface-light dark:bg-surface-dark rounded-[2.5rem] shadow-xl shadow-amber-900/5 border border-amber-100 dark:border-amber-900/30 overflow-hidden relative">
    <div class="absolute inset-0 pattern-bg pointer-events-none"></div>
    <div class="p-8 lg:p-16 relative z-10">
        <div class="mb-12">
            <div class="relative group">
                <span class="material-symbols-outlined absolute left-5 top-1/2 -translate-y-1/2 text-primary">search</span>
                <input class="w-full bg-amber-50/50 dark:bg-amber-900/10 border-2 border-amber-100 dark:border-amber-900/30 rounded-2xl py-5 pl-14 pr-6 focus:ring-4 focus:ring-primary/20 focus:border-primary outline-none transition-all text-lg font-medium placeholder:text-amber-900/30 dark:placeholder:text-amber-100/30"
                       placeholder="How can we help you, Tiger?" type="text" />
            </div>
        </div>
        <div class="space-y-12">
            <section>
                <h2 class="faq-category-title mt-0 flex items-center gap-4">
                    <span class="inline-flex items-center justify-center bg-amber-100 dark:bg-amber-900/40 w-12 h-12 rounded-xl text-primary shrink-0">
                        <span class="material-symbols-outlined text-2xl">shopping_basket</span>
                    </span>
                    Ordering &amp; Payment
                </h2>
                <div class="space-y-3">
                    <details class="group bg-amber-50/30 dark:bg-white/5 rounded-2xl border border-amber-100/50 dark:border-amber-900/20 overflow-hidden">
                        <summary class="flex items-center justify-between p-6 cursor-pointer list-none list-inside">
                            <span class="font-bold text-amber-900 dark:text-amber-100">
                                How do I place a bulk
                                order for events?
                            </span>
                            <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45">add_circle</span>
                        </summary>
                        <div class="px-6 pb-6 text-amber-900/70 dark:text-amber-100/70 leading-relaxed">
                            For orders larger than 5 dozen, please contact our catering team at
                            events@tigervancookie.com. We require at least 7 days' notice for large event orders
                            to ensure everything is baked to perfection.
                        </div>
                    </details>
                    <details class="group bg-amber-50/30 dark:bg-white/5 rounded-2xl border border-amber-100/50 dark:border-amber-900/20 overflow-hidden">
                        <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                            <span class="font-bold text-amber-900 dark:text-amber-100">
                                Which payment methods do
                                you accept?
                            </span>
                            <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45">add_circle</span>
                        </summary>
                        <div class="px-6 pb-6 text-amber-900/70 dark:text-amber-100/70 leading-relaxed">
                            We accept all major credit cards (Visa, Mastercard, American Express), Apple Pay,
                            and Google Pay. All transactions are securely processed and encrypted.
                        </div>
                    </details>
                </div>
            </section>
            <section>
                <h2 class="faq-category-title  mt-0 flex items-center gap-4">
                    <span class="inline-flex items-center justify-center bg-amber-100 dark:bg-amber-900/40 w-12 h-12 rounded-xl text-primary shrink-0">
                        <span class="material-symbols-outlined text-2xl">local_shipping</span>
                    </span>
                    Shipping
                </h2>
                <div class="space-y-3">
                    <details class="group bg-amber-50/30 dark:bg-white/5 rounded-2xl border border-amber-100/50 dark:border-amber-900/20 overflow-hidden">
                        <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                            <span class="font-bold text-amber-900 dark:text-amber-100">
                                How long will it take for
                                my cookies to arrive?
                            </span>
                            <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45">add_circle</span>
                        </summary>
                        <div class="px-6 pb-6 text-amber-900/70 dark:text-amber-100/70 leading-relaxed">
                            We bake and ship within 48 hours of your order. Standard shipping typically takes
                            2-3 business days. We recommend selecting Express Shipping if you're in a hurry for
                            that fresh-baked taste!
                        </div>
                    </details>
                    <details class="group bg-amber-50/30 dark:bg-white/5 rounded-2xl border border-amber-100/50 dark:border-amber-900/20 overflow-hidden">
                        <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                            <span class="font-bold text-amber-900 dark:text-amber-100">
                                Do you ship
                                internationally?
                            </span>
                            <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45">add_circle</span>
                        </summary>
                        <div class="px-6 pb-6 text-amber-900/70 dark:text-amber-100/70 leading-relaxed">
                            Currently, we only ship within the continental United States and Canada to ensure
                            our cookies reach you while they're still fresh and delicious.
                        </div>
                    </details>
                </div>
            </section>
            <section>
                <h2 class="faq-category-title">
                    <span class="inline-flex items-center justify-center bg-amber-100 dark:bg-amber-900/40 w-12 h-12 rounded-xl text-primary shrink-0">
                        <span class="material-symbols-outlined text-2xl">nutrition</span>
                    </span>
                    Ingredients &amp; Allergens
                </h2>
                <div class="space-y-3">
                    <details class="group bg-amber-50/30 dark:bg-white/5 rounded-2xl border border-amber-100/50 dark:border-amber-900/20 overflow-hidden">
                        <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                            <span class="font-bold text-amber-900 dark:text-amber-100">
                                Are there gluten-free or
                                vegan options?
                            </span>
                            <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45">add_circle</span>
                        </summary>
                        <div class="px-6 pb-6 text-amber-900/70 dark:text-amber-100/70 leading-relaxed">
                            Yes! We have a dedicated "Wild &amp; Free" line that includes both vegan and
                            gluten-free cookies. Please note that while we take every precaution, all cookies
                            are baked in a facility that handles wheat, dairy, and nuts.
                        </div>
                    </details>
                    <details class="group bg-amber-50/30 dark:bg-white/5 rounded-2xl border border-amber-100/50 dark:border-amber-900/20 overflow-hidden">
                        <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                            <span class="font-bold text-amber-900 dark:text-amber-100">
                                How should I store my
                                cookies?
                            </span>
                            <span class="material-symbols-outlined text-primary transition-transform group-open:rotate-45">add_circle</span>
                        </summary>
                        <div class="px-6 pb-6 text-amber-900/70 dark:text-amber-100/70 leading-relaxed">
                            For the best experience, keep them in an airtight container at room temperature for
                            up to 5 days. For that "just-out-of-the-oven" feel, pop them in the microwave for
                            10-15 seconds!
                        </div>
                    </details>
                </div>
            </section>
        </div>
        <div class="mt-16 pt-8 border-t border-amber-100 dark:border-amber-800/30 text-center">
            <p class="text-xs uppercase tracking-widest opacity-50">
                Still have questions? Chat with a human at
                support@tigervancookie.com
            </p>
        </div>
    </div>
</div>