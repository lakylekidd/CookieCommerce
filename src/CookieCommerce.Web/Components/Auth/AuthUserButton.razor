@using CookieCommerce.Web.Services
@rendermode InteractiveServer
@inject IAuthService Auth
@inject NavigationManager Nav

@if (Auth.IsLoggedIn)
{
    <div class="relative inline-block">

        <button @onclick="ToggleDropdown" class="cursor-pointer">
            <div class="flex items-center gap-3 pl-4 border-l border-gray-200 dark:border-gray-700">
                <div class="text-right hidden sm:block">
                    <p class="text-sm font-bold leading-tight">@GetFullName()</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Gold Member</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-accent-light dark:bg-accent-dark flex items-center justify-center text-primary font-bold">
                    @GetInitials()
                </div>
            </div>
        </button>
        

        @if (isDropdownOpen)
        {
            <div class="fixed inset-0 z-10" @onclick="ToggleDropdown"></div>

            <div class="absolute right-0 mt-3 w-56 bg-white dark:bg-stone-900 rounded-2xl shadow-xl border border-stone-100 dark:border-stone-800 z-20 overflow-hidden transform origin-top-right transition-all">

                <div class="p-2">
                    @if(Auth.IsAdmin)
                    {
                        <button @onclick='() => NavigateTo("/backoffice/dashboard")' class="cursor-pointer w-full flex items-center gap-3 px-3 py-2 text-sm text-stone-600 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800 rounded-xl transition-colors">
                            <span class="material-symbols-outlined text-lg">business</span>
                            Backoffice
                        </button>
                    }
                    <button @onclick='() => NavigateTo("/account/overview")' class="cursor-pointer w-full flex items-center gap-3 px-3 py-2 text-sm text-stone-600 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800 rounded-xl transition-colors">
                        <span class="material-symbols-outlined text-lg">person</span>
                        Dashboard
                    </button>
                    <button @onclick='() => NavigateTo("/account/orders")' class="cursor-pointer w-full flex items-center gap-3 px-3 py-2 text-sm text-stone-600 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800 rounded-xl transition-colors">
                        <span class="material-symbols-outlined text-lg">shopping_basket</span>
                        Order History
                    </button>
                </div>

                <div class="p-2 border-t border-stone-100 dark:border-stone-800">
                    <button @onclick="HandleLogout" class="cursor-pointer w-full flex items-center gap-3 px-3 py-2 text-sm text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 rounded-xl transition-colors font-medium">
                        <span class="material-symbols-outlined text-lg">logout</span>
                        Sign Out
                    </button>
                </div>
            </div>
        }
    </div>
}
else
{
    <a class="hidden lg:block bg-primary hover:bg-amber-700 text-white px-5 py-2 rounded-full font-bold transition-transform active:scale-95 shadow-lg shadow-amber-500/30" href="/auth/signin">
        Sign In
    </a>
}

@code {

    private bool isDropdownOpen = false;

    private string GetFullName() => $"{Auth.CurrentUser?.FirstName} {Auth.CurrentUser?.LastName}".Trim();
    private string GetInitials() => $"{(Auth.CurrentUser?.FirstName?[0])}{(Auth.CurrentUser?.LastName?[0])}".ToUpper();

    protected override void OnInitialized()
    {
        Auth.OnChange += HandleStatusChange;
    }

    private void HandleStatusChange()
    {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDropdown() => isDropdownOpen = !isDropdownOpen;

    private void NavigateTo(string url)
    {
        isDropdownOpen = false;
        Nav.NavigateTo(url);
    }

    private void HandleLogout()
    {
        isDropdownOpen = false;
        Auth.Logout();
        Nav.NavigateTo("/storefront");
    }
}