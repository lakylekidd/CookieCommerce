@inject CookieCommerce.Web.Services.Commerce.CartService Cart
@inject CookieCommerce.Web.Services.Commerce.StoreSettingsService Settings
@if (visible)
{
    <div class="bg-primary text-white rounded-2xl p-6 mb-6">
        <h2 class="font-display font-bold text-2xl">Welcome back!</h2>
        <p>You have @balance reward points available. 100 points = €1.</p>
        <a href="/shop/cart" class="underline">Redeem points in your cart</a>
    </div>
}
@code {
    private int balance;
    private bool visible;
    protected override async Task OnInitializedAsync()
    {
        visible = (await Settings.GetAsync()).Preference("showPointsOnStorefront", true);
        balance = await Cart.GetRewardBalanceAsync();
    }
}
