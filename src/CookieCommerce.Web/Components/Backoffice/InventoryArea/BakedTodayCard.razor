@using System.Globalization

<div class="group p-4 rounded-xl bg-white dark:bg-zinc-900 shadow-sm border border-amber-100/50 dark:border-zinc-800 flex flex-col justify-between h-28 transition-all hover:border-primary">
    <div>
        <h3 class="text-2xl font-black text-primary dark:text-amber-500">@Value.ToString("N0", CultureInfo.InvariantCulture)</h3>
        <p class="text-[10px] text-gray-400 dark:text-zinc-600">Fresh from the oven</p>
    </div>
</div>

@code {
    [Parameter] public int Value { get; set; }
    [Parameter] public double PercentageChange { get; set; }
}
