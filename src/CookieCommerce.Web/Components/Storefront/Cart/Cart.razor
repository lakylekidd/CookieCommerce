@page "/shop/cart"
@rendermode InteractiveServer
@using CookieCommerce.Web.Components.Storefront.Shop
@layout ShopLayout
@using CookieCommerce.Web.Components.Storefront.Products
@using CookieCommerce.Web.Components.Shared
@using CookieCommerce.Web.Models.Cart
@using CookieCommerce.Web.Services
@inject ICartService CartService

@if (CurrentCart == null || CurrentCart.Items.Count == 0)
{
    <main class="flex-grow flex flex-col items-center justify-center py-16 px-6">
        <div class="max-w-2xl w-full text-center space-y-8">
            <div class="relative inline-block">
                <div class="w-64 h-64 mx-auto bg-amber-100 dark:bg-surface-dark rounded-full flex items-center justify-center relative overflow-hidden cookie-shadow">
                    <span class="material-symbols-outlined text-amber-900/10 dark:text-amber-100/10 absolute -bottom-4 left-1/2 -translate-x-1/2"
                          style="font-size: 120px !important; line-height: 1;">
                        pets
                    </span>

                    <div class="relative z-10 flex flex-col items-center">
                        <span class="material-symbols-outlined text-primary/40"
                            style="font-variation-settings: 'FILL' 1; font-size: 96px !important; line-height: 1;">
                            sentiment_dissatisfied
                        </span>    
                        <span class="material-symbols-outlined text-amber-900/20 dark:text-white/20 -mt-2"
                            style="font-size: 60px !important; line-height: 1;">
                            kitchen
                        </span>
                    </div>
                </div>
                <div class="absolute -bottom-2 left-1/4 w-3 h-3 bg-amber-800 rounded-full opacity-20"></div>
                <div class="absolute bottom-4 right-1/4 w-2 h-2 bg-amber-800 rounded-full opacity-10"></div>
            </div>
            <div class="space-y-4">
                <h1 class="font-display font-bold text-4xl md:text-5xl text-text-light dark:text-text-dark">
                    Your Cookie Jar is empty!
                </h1>
                <p class="text-lg text-gray-600 dark:text-gray-400 max-w-md mx-auto leading-relaxed">
                    It looks like you haven't added any treats yet. Let's find something delicious to fill it up!
                </p>
            </div>
            <div>
                <a class="inline-block bg-primary hover:bg-amber-700 text-white px-10 py-4 rounded-full font-display font-bold text-xl transition-all shadow-xl shadow-amber-500/30 hover:-translate-y-1 active:scale-95"
                    href="/shop">
                    Start Shopping
                </a>
            </div>
        </div>
        <TopRatedCookies />
    </main>
}
else
{
    <main class="flex-grow container mx-auto px-6 py-12">
        <div class="mb-10 text-center md:text-left">
            <h1 class="font-display font-bold text-4xl mb-6 flex items-center gap-3 justify-center md:justify-start">
                Your Cookie Jar
                <span class="text-xl font-medium text-amber-900/40 dark:text-amber-100/40">(@CurrentCart.Items.Count() items)</span>
            </h1>
            <_FreeShippingMeter Cart="CurrentCart" />
        </div>

       <!-- Cart -->
       <div class="bg-white dark:bg-surface-dark rounded-3xl border border-amber-100 dark:border-amber-900/30 overflow-hidden cookie-shadow">
    
        <!-- Mobile Version -->
        <div class="md:hidden divide-y divide-amber-100/50 dark:divide-amber-900/20">
            @foreach(var item in CurrentCart.Items)
            {
                <div class="p-4 @(item.IsLimitedEdition ? "bg-orange-50/50 dark:bg-primary/5" : "")">
                    <div class="flex gap-4">
                        <div class="relative flex-shrink-0">
                            <img alt="@item.ProductName" class="w-20 h-20 rounded-xl object-cover" src="@item.ProductImageUrl" />
                            @if(item.IsLimitedEdition)
                            {
                                <span class="absolute -top-2 -right-2 bg-primary text-white text-[9px] font-bold px-2 py-0.5 rounded-full uppercase">
                                    Rare
                                </span>
                            }
                        </div>

                        <div class="flex-1 min-w-0">
                            <div class="flex justify-between items-start">
                                <h3 class="font-display font-bold text-base truncate">@item.ProductName</h3>
                                <button @onclick="async () => await RemoveItem(item.CartItemId)" class="flex text-gray-500 items-center justify-center p-4 cursor-pointer bg-amber-100 dark:bg-white/10 text-primary rounded-xl hover:text-red-900 hover:bg-primary transition-colors">
                                    <span class="material-symbols-outlined text-xl">delete</span>
                                </button>
                            </div>
                            <p class="text-xs text-gray-500 truncate">@item.ProductVariantName</p>
                        
                            <div class="flex justify-between items-end mt-3">
                                <div class="inline-flex items-center bg-amber-50 dark:bg-black/20 rounded-full p-1 border border-amber-100 dark:border-amber-900/30">
                                    <button @onclick="async () => await UpdateQuantity(item.CartItemId, item.Quantity - 1)" class="w-7 h-7 flex items-center justify-center rounded-full"><span class="material-icons-round text-xs">remove</span></button>
                                    <span class="px-2 font-bold text-sm">@item.Quantity</span>
                                    <button @onclick="async () => await UpdateQuantity(item.CartItemId, item.Quantity + 1)" class="w-7 h-7 flex items-center justify-center rounded-full"><span class="material-icons-round text-xs">add</span></button>
                                </div>
                                <div class="text-right pr-5">
                                    <span class="font-display font-bold text-xl text-primary">@item.CurrencySymbol@item.TotalPrice.ToString("F2")</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!-- Mobile Version -->

        <!-- Desktop -->
        <div class="hidden md:block overflow-x-auto">
            <table class="w-full border-collapse">
                <thead>
                    <tr class="bg-amber-50/50 dark:bg-black/20 text-left border-b border-amber-100 dark:border-amber-900/30">
                        <th class="px-8 py-6 font-display font-bold text-lg">Product</th>
                        <th class="px-8 py-6 font-display font-bold text-lg text-center">Price</th>
                        <th class="px-8 py-6 font-display font-bold text-lg text-center">Quantity</th>
                        <th class="px-8 py-6 font-display font-bold text-lg text-right">Total</th>
                        <th class="px-8 py-6"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-amber-100/50 dark:divide-amber-900/20">
                    @foreach(var item in CurrentCart.Items)
                    {
                        var trClass = item.IsLimitedEdition ? "bg-orange-50/50 dark:bg-primary/5" : "";
                        <tr class="@trClass">
                            <td class="px-8 py-6">
                                <div class="flex items-center gap-6">
                                    <div class="relative">
                                        <img alt="@item.ProductName" class="w-20 h-20 rounded-xl object-cover" src="@item.ProductImageUrl" />
                                        @if(item.IsLimitedEdition)
                                        {
                                            <span class="absolute -top-2 -left-2 bg-primary text-white text-[10px] font-bold px-2 py-0.5 rounded-full uppercase tracking-tighter">Rare Find</span>
                                        }
                                    </div>
                                    <div>
                                        <h3 class="font-display font-bold text-lg">@item.ProductName</h3>
                                        <p class="text-sm text-gray-500 dark:text-gray-400">@item.ProductVariantName</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6 text-center font-semibold">@item.CurrencySymbol@item.UnitPrice.ToString("F2")</td>
                            <td class="px-8 py-6">
                                <div class="flex items-center justify-center">
                                    <div class="inline-flex items-center bg-amber-50 dark:bg-black/20 rounded-full p-1 border border-amber-100 dark:border-amber-900/30">
                                        <button @onclick="async () => await UpdateQuantity(item.CartItemId, item.Quantity - 1)" class="w-8 h-8 flex items-center justify-center hover:bg-white dark:hover:bg-amber-900/50 rounded-full transition-colors cursor-pointer">
                                            <span class="material-icons-round text-sm">remove</span>
                                        </button>
                                        <span class="w-10 text-center font-bold">@item.Quantity</span>
                                        <button @onclick="async () => await UpdateQuantity(item.CartItemId, item.Quantity + 1)" class="w-8 h-8 flex items-center justify-center hover:bg-white dark:hover:bg-amber-900/50 rounded-full transition-colors cursor-pointer">
                                            <span class="material-icons-round text-sm">add</span>
                                        </button>
                                    </div>
                                </div>
                            </td>
                            <td class="px-8 py-6 text-right font-display font-bold text-lg">@item.CurrencySymbol@item.TotalPrice.ToString("F2")</td>
                            <td class="px-8 py-6 text-right">
                                <!-- flex items-center justify-center p-2 cursor-pointer bg-amber-100 dark:bg-white/10 text-primary rounded-xl hover:bg-primary hover:text-white transition-colors -->
                                <!-- text-gray-400 hover:text-red-500 transition-colors cursor-pointe -->
                                <button @onclick="async () => await RemoveItem(item.CartItemId)" class="flex items-center justify-center p-4 cursor-pointer bg-amber-100 dark:bg-white/10 text-primary rounded-xl hover:text-red-900 hover:bg-primary transition-colors">
                                    <span class="material-symbols-outlined">delete</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- Desktop -->

    </div>
    <!-- Cart -->

        <div class="mt-8 grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <div class="lg:col-span-2 space-y-8">

                <JoinTigerClubCallToAction />

                <AddNoteToCart />
                
                <!-- Continue Shopping -->
                <ContinueShoppingLink />
                <!-- Continue Shopping -->

            </div>
            <div class="lg:col-span-1 lg:sticky lg:top-28">
                <div class="bg-white dark:bg-surface-dark p-8 rounded-3xl border border-amber-100 dark:border-amber-900/30 cookie-shadow">
                    <h3 class="font-display font-bold text-2xl mb-6 pb-6 border-b border-amber-100 dark:border-amber-900/30">
                        Order Summary
                    </h3>
                    <div class="space-y-4 mb-8">
                        <div class="flex justify-between text-gray-600 dark:text-gray-400">
                            <span>Subtotal</span>
                            <span class="font-bold text-text-light dark:text-text-dark">@CurrentCart.CurrencySymbol@CurrentCart.SubTotalPrice.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between text-gray-600 dark:text-gray-400">
                            <span>Shipping</span>
                            <span class="font-bold text-text-light dark:text-text-dark">@CurrentCart.CurrencySymbol@CurrentCart.Shipping.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between text-gray-600 dark:text-gray-400">
                            <span>Tax</span>
                            <span class="font-bold text-text-light dark:text-text-dark">@CurrentCart.CurrencySymbol@CurrentCart.Tax.ToString("F2")</span>
                        </div>
                        <div class="pt-4 border-t border-amber-100 dark:border-amber-900/30 flex justify-between items-center">
                            <span class="font-display font-bold text-xl">Total</span>
                            <span class="font-display font-bold text-3xl text-primary">@CurrentCart.CurrencySymbol@CurrentCart.TotalPrice.ToString("F2")</span>
                        </div>
                    </div>

                    <a class="block w-full bg-primary hover:bg-amber-700 text-white text-center py-5 rounded-2xl font-bold text-xl transition-all shadow-xl shadow-primary/30 hover:-translate-y-1 active:scale-95 mb-6"
                       href="/shop/checkout">
                        Proceed to Checkout
                    </a>

                    <div class="pt-6 mt-6 border-t border-amber-100/50 dark:border-amber-900/30 space-y-4">    
                        <div class="flex items-start gap-4 p-3 rounded-2xl bg-amber-50/30 dark:bg-amber-900/10">
                            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-white dark:bg-surface-dark flex items-center justify-center border border-amber-100 dark:border-amber-900/50">
                                <span class="material-symbols-outlined text-xl text-primary animate-bounce-slow">local_shipping</span>
                            </div>
                            <div class="flex flex-col">
                                <span class="text-[10px] uppercase font-black tracking-widest text-amber-600/70 dark:text-amber-500/50">Freshness Guarantee</span>
                                <span class="text-xs text-gray-600 dark:text-gray-400">
                                    Arrives: <span class="font-bold text-gray-900 dark:text-amber-100">@DateTime.Now.AddDays(2).ToString("MMM dd") - @DateTime.Now.AddDays(4).ToString("MMM dd")</span>
                                </span>
                            </div>
                        </div>
                        <div class="flex flex-col items-center gap-2 py-2">
                            <div class="flex items-center gap-2 px-4 py-1.5 rounded-full bg-gray-50 dark:bg-amber-900/20 border border-gray-100 dark:border-amber-900/30">
                                <span class="material-symbols-outlined text-sm text-green-500">lock</span>
                                <span class="text-[10px] font-bold uppercase tracking-tighter text-gray-500 dark:text-amber-100/60">Secure SSL Encrypted Checkout</span>
                                <span class="material-symbols-outlined text-xs text-blue-400">verified</span>
                            </div>
        
                            <p class="text-[9px] text-gray-400 dark:text-gray-500 uppercase tracking-widest font-medium">
                                Powered by TigerPay & Stripe
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
}

@if (CurrentCart is not null) { <div class="container mx-auto px-6"><RewardPointsControl /></div> }
@code {
    private CartDto? CurrentCart { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CartService.OnCartUpdated += HandleCartChanged;
        await LoadCartAsync();
    }

    private async void HandleCartChanged()
    {
        await InvokeAsync(async () =>
        {
            await LoadCartAsync();
            StateHasChanged();
        });
    }

    private async Task LoadCartAsync()
    {
        CurrentCart = await CartService.GetCartAsync();
    }

    private async Task UpdateQuantity(Guid itemId, int newQuantity)
    {
        if (newQuantity < 1)
        {
            await CartService.RemoveItemAsync(itemId);
            return;
        }

        await CartService.UpdateQuantityAsync(itemId, newQuantity);
    }

    private async Task RemoveItem(Guid itemId)
    {
        await CartService.RemoveItemAsync(itemId);
    }

    public void Dispose()
    {
        CartService.OnCartUpdated -= HandleCartChanged;
    }
}
