@page "/auth/password/setup/{Token}"
@page "/auth/password/reset/{Token}"
@layout AuthLayout
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using CookieCommerce.Web.Services
@inject IAuthService Auth
@inject NavigationManager Navigation

<PageTitle>Choose your password - Tiger van Cookie</PageTitle>

<main class="flex-grow relative flex items-center justify-center py-12 px-6 overflow-hidden">
    <div class="absolute inset-0 pattern-bg pointer-events-none"></div>
    <div class="w-full max-w-lg relative">
        <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-32 h-32 z-20 drop-shadow-2xl">
            <img alt="Tiger van Cookie mascot" class="w-full h-full object-contain" src="/images/logo.png" />
        </div>
        <div class="bg-white dark:bg-surface-dark p-8 md:p-10 rounded-3xl cookie-shadow border border-amber-50 dark:border-amber-900/20 relative z-10 mt-16">
            <div class="text-center mb-8 pt-4">
                <h1 class="font-display font-bold text-3xl text-text-light dark:text-text-dark mb-3">Create your password</h1>
                <p class="text-gray-500 dark:text-gray-400">Choose a password for your Tiger van Cookie account. You’ll be signed in when it’s saved.</p>
            </div>

            <EditForm Model="Form" OnValidSubmit="SubmitAsync" class="space-y-6">
                <DataAnnotationsValidator />
                <div class="space-y-2">
                    <label for="password" class="block text-sm font-bold ml-1">Password</label>
                    <InputText id="password" type="password" @bind-Value="Form.Password"
                               class="w-full px-5 py-4 rounded-2xl border-2 border-amber-100 dark:border-amber-900/30 bg-amber-50/30 dark:bg-background-dark/50 focus:bg-white transition-all outline-none" />
                    <ValidationMessage For="@(() => Form.Password)" class="text-red-500 text-xs ml-1" />
                </div>
                <div class="space-y-2">
                    <label for="confirm-password" class="block text-sm font-bold ml-1">Confirm password</label>
                    <InputText id="confirm-password" type="password" @bind-Value="Form.ConfirmPassword"
                               class="w-full px-5 py-4 rounded-2xl border-2 border-amber-100 dark:border-amber-900/30 bg-amber-50/30 dark:bg-background-dark/50 focus:bg-white transition-all outline-none" />
                    <ValidationMessage For="@(() => Form.ConfirmPassword)" class="text-red-500 text-xs ml-1" />
                </div>
                <PasswordValidator Password="Form.Password" ConfirmPassword="Form.ConfirmPassword" />
                @if (Error is not null)
                {
                    <p role="alert" class="p-4 rounded-xl bg-red-50 dark:bg-red-900/20 text-red-600 dark:text-red-400 text-sm">@Error</p>
                }
                <button type="submit" disabled="@Busy"
                        class="w-full py-4 bg-primary hover:bg-amber-700 text-white rounded-2xl font-bold text-lg shadow-lg shadow-amber-500/30 transition-all disabled:opacity-50">
                    @(Busy ? "Saving password…" : "Save password and sign in")
                </button>
            </EditForm>
        </div>
    </div>
</main>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;
    private PasswordSetupForm Form { get; } = new();
    private string? Error;
    private bool Busy;

    private async Task SubmitAsync()
    {
        Busy = true;
        Error = null;
        var result = await Auth.UpdatePasswordAsync(Token, Form.Password);
        Busy = false;
        if (!result.Success) { Error = result.ErrorMessage; return; }
        Navigation.NavigateTo("/storefront");
    }

    private sealed class PasswordSetupForm
    {
        [Required, MinLength(8)] public string Password { get; set; } = string.Empty;
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
