@using CookieCommerce.Web.Components.Features.Cart
@rendermode InteractiveServer
@inject IJSRuntime JS

<header class="w-full bg-card-light dark:bg-card-dark shadow-sm border-b border-orange-100 dark:border-gray-800 sticky top-0 z-20">
    <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <_Logo />
        </div>
        <div class="flex items-center gap-4">
            <button aria-label="Toggle Dark Mode"
                    class="w-10 h-10 flex items-center justify-center rounded-full hover:bg-amber-100 dark:hover:bg-white/10 transition-colors cursor-pointer"
                    @onclick="ToggleDarkMode">
                <span class="material-icons-round text-xl">@(isDarkMode ? "light_mode" : "dark_mode")</span>
            </button>
            <ShoppingBag />
            <button class="cursor-pointer p-2 w-10 h-10 rounded-full flex items-center justify-center hover:bg-accent-light dark:hover:bg-accent-dark transition-colors text-gray-500 dark:text-gray-400">
                <span class="material-icons">notifications_none</span>
            </button>
            <div class="flex items-center gap-3 pl-4 border-l border-gray-200 dark:border-gray-700">
                <div class="text-right hidden sm:block">
                    <p class="text-sm font-bold leading-tight">Cookie Lover</p>
                    <p class="text-xs text-gray-500 dark:text-gray-400">Gold Member</p>
                </div>
                <div class="w-10 h-10 rounded-full bg-accent-light dark:bg-accent-dark flex items-center justify-center text-primary font-bold">
                    CL
                </div>
            </div>
        </div>
    </div>
</header>

@code {
    private bool isDarkMode = false;
    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await JS.InvokeVoidAsync("eval", "document.documentElement.classList.toggle('dark')");
    }
}