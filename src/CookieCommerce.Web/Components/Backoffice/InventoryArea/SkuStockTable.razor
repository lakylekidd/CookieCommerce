@using CookieCommerce.Web.Models.Products

<section class="bg-surface-light dark:bg-surface-dark p-6 rounded-xl border border-orange-50 dark:border-stone-700">
    <h3 class="text-lg font-bold font-display text-primary mb-4">Available stock</h3>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead><tr class="border-b border-stone-200 dark:border-stone-700"><th class="py-3">SKU</th><th>Type</th><th>Unit cost</th><th class="text-right">Available units</th></tr></thead>
            <tbody>
                @foreach (var sku in Skus.OrderBy(s => s.SkuType).ThenBy(s => s.Name))
                {
                    <tr class="border-b border-stone-100 dark:border-stone-800">
                        <td class="py-3"><span class="font-semibold">@sku.Name</span><p class="text-xs text-stone-500">@sku.Description</p></td>
                        <td>@sku.SkuType</td><td>€@sku.Cost.ToString("F3")</td><td class="text-right font-bold">@sku.Stock</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [Parameter] public ICollection<SkuDto> Skus { get; set; } = [];
}
