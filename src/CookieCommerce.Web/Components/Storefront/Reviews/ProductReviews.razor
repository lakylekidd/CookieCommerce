@using CookieCommerce.Web.Models.Reviews
@using CookieCommerce.Web.Services.Products
@using CookieCommerce.Web.Models.Products
@inject ICookieService CookieService

@code {
    [Parameter] public Guid Id { get; set; }

    private IReadOnlyList<ReviewDto> Reviews { get; set; } = [];
    
    protected override async Task OnInitializedAsync()
    {
        Reviews = await CookieService.GetReviewsByCookieIdAsync(Id);
    }
}



<section class="py-20 mt-12 bg-secondary dark:bg-surface-dark/30">
    <div class="container mx-auto px-6">
        <div class="text-center mb-12">
            <h2 class="font-display font-bold text-4xl text-text-light dark:text-text-dark">
                What Cookie Lovers Say
            </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">

            @foreach(var review in Reviews)
            {
                var initials = new string(review.Author?.Where(char.IsUpper).Take(2).ToArray() ?? []);
                
                <div class="bg-white dark:bg-surface-dark p-8 rounded-3xl border border-amber-100 dark:border-amber-900/30 shadow-sm relative">
                    <div class="absolute -top-4 left-8 text-6xl text-primary font-serif leading-none">“</div>
                    <div class="flex gap-1 mb-4">
                        @foreach(var i in Enumerable.Range(0, review.Rating))
                        {
                            <span class="material-icons-round text-amber-400 text-sm">star</span>
                        }
                    </div>
                    <p class="text-gray-600 dark:text-gray-300 italic mb-8 leading-relaxed">
                        "@review.Content"
                    </p>
                    <div class="flex items-center gap-4">
                        @if (string.IsNullOrEmpty(review.ProfileImageUrl))
                        {
                            <div class="w-12 h-12 rounded-full bg-primary/20 flex items-center justify-center font-bold text-primary">
                                @initials
                            </div>
                        }
                        else
                        {
                            <div class="w-12 h-12 rounded-full overflow-hidden border-2 border-primary/20">
                                <img alt="@review.Author"
                                     class="w-full h-full object-cover"
                                     src="@review.ProfileImageUrl" />
                            </div>
                        }
                        <div>
                            <h4 class="font-bold text-text-light dark:text-text-dark">@review.Author</h4>
                            <span class="text-xs text-gray-400 uppercase tracking-wider font-bold">
                                Verified
                                Buyer
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>