@using CookieCommerce.Web.Models.Backoffice
@implements IDisposable

<tr class="group bg-accent-light dark:bg-stone-800/40 border-b border-stone-100 dark:border-stone-700/50 transition-all duration-200">
    
    @* 🆔 Reference *@
    <td class="px-4 py-4 rounded-l-2xl">
        <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-xl bg-white dark:bg-stone-800 flex items-center justify-center border border-stone-200 dark:border-stone-700 shadow-sm">
                <span class="material-symbols-outlined text-sm text-stone-400 group-hover:text-primary transition-colors">qr_code_2</span>
            </div>
            <div class="flex flex-col">
                <span class="text-[10px] font-black text-stone-400 uppercase tracking-tighter leading-none">@BatchRun.StartedOn!.Value.ToString("MMM dd, yyyy")</span>
                <span class="font-bold text-sm text-stone-700 dark:text-stone-200">@BatchRun.BatchRunReference</span>
            </div>
        </div>
    </td>

    @* 🚦 Status Dropdown *@
    <td class="px-4 py-4">
        <div class="flex flex-col gap-1">
            <span class="text-[10px] font-black text-stone-400 uppercase tracking-tighter leading-none">Current Status</span>

            <div class="mt-1 relative group">
                @* 🐯 Added 'bg-none' and 'pr-10' to ensure the plugin chevron disappears *@
                <select @bind="BatchRun.Status" @bind:after="OnStatusChanged"
                        class="w-full bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 
                               text-xs font-bold rounded-lg pl-2 pr-10 py-2 outline-none focus:border-primary 
                               focus:ring-0 focus:outline-none appearance-none bg-none shadow-sm cursor-pointer 
                               transition-all">
                    @foreach (BatchRunStatus status in Enum.GetValues(typeof(BatchRunStatus)))
                    {
                        <option value="@status">@status.ToString()</option>
                    }
                </select>

                @* 🐾 Custom Tiger Chevron - This is the one we keep! *@
                <div class="absolute inset-y-0 right-0 flex items-center pr-2 pointer-events-none text-stone-400 group-hover:text-primary transition-colors">
                    <span class="material-symbols-outlined text-[18px]">unfold_more</span>
                </div>
            </div>
        </div>
    </td>

    @* 🌡️ Baking Information (Minutes Input & Live Timer) *@
    <td class="px-4 py-4">
        <div class="flex flex-col gap-1">
            <div class="flex items-center gap-2 mt-1">
                @* ⏲️ Duration Input Group *@
                <div class="flex flex-col gap-1">
                    <span class="text-[9px] font-bold text-stone-300 uppercase pl-1">Mins</span>
                    <div class="flex items-center bg-white dark:bg-stone-700/50 rounded-lg px-2 py-1 
                                focus-within:ring-2 focus-within:ring-primary transition-all">
                        <span class="material-symbols-outlined text-[14px] text-stone-400 mr-1">timer</span>
                        <input type="number" @bind="BatchRun.BakingInformation!.BakingDurationInMinutes"
                               class="w-10 bg-transparent border-none p-0 text-xs font-bold tabular-nums
                                      focus:ring-0 focus:border-none focus:outline-none" />
                    </div>
                </div>

                @* 🌡️ Temperature Input Group *@
                <div class="flex flex-col gap-1">
                    <span class="text-[9px] font-bold text-stone-300 uppercase pl-1">Temp °C</span>
                    <div class="flex items-center bg-white dark:bg-stone-700/50 rounded-lg px-2 py-1 
                                focus-within:ring-2 focus-within:ring-primary transition-all">
                        <span class="material-symbols-outlined text-[14px] text-stone-400 mr-1">thermostat</span>
                        <input type="number" @bind="BatchRun.BakingInformation!.TemperatureInCelsius"
                               class="w-12 bg-transparent border-none p-0 text-xs font-bold tabular-nums
                                      focus:ring-0 focus:border-none focus:outline-none" />
                    </div>
                </div>

                @* ✍️ Remarks *@
                <div class="flex flex-col gap-1">
                    <span class="text-[9px] font-black text-stone-400 uppercase tracking-tighter pl-1">Oven Settings</span>
                    <div class="flex items-center rounded-lg px-2 py-1 transition-all">
                        <input type="text" @bind="BatchRun.BakingInformation.OvenSettings" placeholder="Add oven settings..."
                               class="w-full bg-white dark:bg-stone-800 border-none text-xs font-bold rounded-lg 
                                      px-3 h-[38px] outline-none focus:ring-2 focus:ring-primary/20
                                      placeholder:text-stone-300 italic" />
                    </div>
                </div>
            </div>
        </div>
    </td>

    @* ⚙️ Actions *@
    <td class="px-4 py-4 text-right rounded-r-2xl">
        <button @onclick="() => OnEdit.InvokeAsync(BatchRun)"
                class="inline-flex items-center justify-center w-9 h-9 rounded-xl bg-white dark:bg-stone-800 border border-stone-200 dark:border-stone-700 text-stone-400 hover:text-primary hover:border-primary hover:shadow-md transition-all shadow-sm">
            <span class="material-symbols-outlined text-sm">save</span>
        </button>
    </td>
</tr>

@code {
    [Parameter] public BatchRunDto BatchRun { get; set; } = new();
    [Parameter] public EventCallback<BatchRunDto> OnEdit { get; set; }

    private CancellationTokenSource _cts = new();

    protected override void OnInitialized()
    {
        if (BatchRun.BakingInformation == null) BatchRun.BakingInformation = new();
        if (BatchRun.Status == BatchRunStatus.Baking) StartTicker();
    }

    private void OnStatusChanged()
    {
        // Tiger Logic: Auto-handle timestamps based on status
        if (BatchRun.Status == BatchRunStatus.Baking && !BatchRun.StartedOn.HasValue)
        {
            BatchRun.StartedOn = DateTime.Now;
            StartTicker();
        }
        else if ((BatchRun.Status == BatchRunStatus.Cooling || BatchRun.Status == BatchRunStatus.Completed) && !BatchRun.CompletedOn.HasValue)
        {
            BatchRun.CompletedOn = DateTime.Now;
        }

        // Trigger save or notification if needed
        OnEdit.InvokeAsync(BatchRun);
    }

    private string GetDisplayTime()
    {
        if (!BatchRun.StartedOn.HasValue) return "00:00";
        var endTime = BatchRun.CompletedOn ?? DateTime.Now;
        var diff = endTime - BatchRun.StartedOn.Value;
        return $"{(int)diff.TotalMinutes:D2}:{diff.Seconds:D2}";
    }

    private async void StartTicker()
    {
        _cts.Cancel(); // Reset previous ticker
        _cts = new CancellationTokenSource();
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_cts.Token) && BatchRun.Status == BatchRunStatus.Baking)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch { }
    }

    public void Dispose() => _cts.Cancel();
}