@inherits LayoutComponentBase
@layout MainLayout

<style>
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    ::-webkit-scrollbar-thumb {
        background: #EA9654;
        border-radius: 4px;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #d67d38;
        }

    .chart-container {
        position: relative;
        height: 300px;
        width: 100%;
    }
</style>

<div class="bg-background-light dark:bg-background-dark text-text-light dark:text-text-dark font-sans antialiased transition-colors duration-300">
    <div class="flex h-screen overflow-hidden">
        <BackofficeASide />
        <main class="flex-1 flex flex-col h-screen overflow-hidden bg-background-light dark:bg-background-dark relative">
            <BackofficeHeader />
            <div class="flex-1 overflow-y-auto p-8 flex flex-col">
                @Body                
            </div>
            <BackofficeFooter />
        </main>
    </div>
</div>
