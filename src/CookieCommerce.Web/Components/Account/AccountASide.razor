<aside class="w-full md:w-64 flex-shrink-0">
    <nav class="bg-card-light dark:bg-card-dark rounded-xl shadow-sm p-4 space-y-2 sticky top-28">

        <NavLink class="flex items-center gap-3 px-4 py-3 rounded-lg font-medium transition-all text-gray-600 dark:text-gray-300 hover:bg-accent-light dark:hover:bg-accent-dark hover:text-primary"
                 href="/account/overview"
                 ActiveClassName="bg-primary text-white shadow-md transform scale-[1.02] hover:text-white"
                 Match="NavLinkMatch.All">
            <span class="material-icons text-xl">person</span>
            Profile Overview
        </NavLink>

        <NavLink class="flex items-center gap-3 px-4 py-3 rounded-lg font-medium transition-all text-gray-600 dark:text-gray-300 hover:bg-accent-light dark:hover:bg-accent-dark hover:text-primary"
                 href="/account/orders"
                 ActiveClassName="bg-primary text-white shadow-md transform scale-[1.02] hover:text-white">
            <span class="material-icons text-xl">shopping_bag</span>
            My Orders
            @if (OrderCountInNeedOfAttention > 0)
            {
                <span class="ml-auto bg-orange-100 dark:bg-orange-900 
                    text-orange-600 dark:text-orange-300 text-xs font-bold px-2 py-0.5 rounded-full">
                    @OrderCountInNeedOfAttention
                </span>
            }
        </NavLink>

        <NavLink class="flex items-center gap-3 px-4 py-3 rounded-lg font-medium transition-all text-gray-600 dark:text-gray-300 hover:bg-accent-light dark:hover:bg-accent-dark hover:text-primary"
                 href="/account/favorites"
                 ActiveClassName="bg-primary text-white shadow-md transform scale-[1.02] hover:text-white">
            <span class="material-icons text-xl">favorite</span>
            Favorites
        </NavLink>

        <NavLink class="flex items-center gap-3 px-4 py-3 rounded-lg font-medium transition-all text-gray-600 dark:text-gray-300 hover:bg-accent-light dark:hover:bg-accent-dark hover:text-primary"
                 href="/account/addresses"
                 ActiveClassName="bg-primary text-white shadow-md transform scale-[1.02] hover:text-white">
            <span class="material-icons text-xl">location_on</span>
            Addresses
        </NavLink>

        <hr class="border-gray-100 dark:border-gray-700 my-2" />

        <a class="flex items-center gap-3 px-4 py-3 rounded-lg text-red-500 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors font-medium"
           href="logout">
            <span class="material-icons text-xl">logout</span>
            Logout
        </a>
    </nav>
</aside>

@code {
    private int OrderCountInNeedOfAttention = 2;
}