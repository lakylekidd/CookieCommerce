@using CookieCommerce.Web.Models.Products
@using CookieCommerce.Web.Services
@using CookieCommerce.Web.Components.Storefront.Products

@inject IAccountService AccountService

<div>
    <h2 class="text-xl font-display font-bold text-gray-800 dark:text-white mb-4">
        Reorder Your Favorites
    </h2>
    
    @if (FavoriteProducts == null)
    {
        <div class="flex items-center justify-center p-12">
            <div class="animate-spin size-8 border-4 border-primary border-t-transparent rounded-full"></div>
        </div>
    }
    else if (!FavoriteProducts.Any())
    {
        <div class="p-8 bg-surface-light dark:bg-card-dark rounded-2xl border border-dashed border-gray-100 dark:border-gray-800 text-center">
            <p class="text-gray-500 dark:text-gray-400">You haven't added any favorites yet.</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
            @foreach (var favorite in FavoriteProducts.Take(3))
            {
                <FeaturedCookieCard 
                    Id="@favorite.Id"
                    IsBestSeller="@favorite.IsBestSeller"
                    IsLimitedEdition="@favorite.IsLimitedEdition"
                    ImageUrl="@(favorite.ImageUrls.FirstOrDefault() ?? string.Empty)"
                    CookieTitle="@favorite.Title"
                    Description="@favorite.Description"
                    CurrencySymbol="@favorite.CurrencySymbol"
                    Price="@favorite.Price" />
            }
        </div>
    }
</div>

@code {
    private ICollection<StorefrontProductDto>? FavoriteProducts { get; set; }

    protected override async Task OnInitializedAsync()
    {
        FavoriteProducts = await AccountService.GetFavoriteProductsAsync();
    }
}