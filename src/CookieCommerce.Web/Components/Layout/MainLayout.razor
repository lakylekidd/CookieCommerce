@inherits LayoutComponentBase
@inject IJSRuntime JS

<HeadContent>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />   

    @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Production")
    {
        <environment include="Production">
            <meta name="google-site-verification" content="qg_XKjLH1Q-HM5s9K4uKesiQHWIOwF9XdE7iOYomv64" />
            <meta name="google-adsense-account" content="ca-pub-2415952858841772">
            <!-- Google tag (gtag.js) for analytics -->
            <script async src="https://www.googletagmanager.com/gtag/js?id=G-HNS116Q0G5"></script>
            <script>
                window.dataLayer = window.dataLayer || [];
                function gtag(){dataLayer.push(arguments);}
                gtag('js', new Date());

                gtag('config', 'G-HNS116Q0G5');
            </script>
            <!-- Google Tag -->
            <!-- Matomo -->
            <script>
                var _paq = window._paq = window._paq || [];
                /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
                _paq.push(['trackPageView']);
                _paq.push(['enableLinkTracking']);
                (function() {
                  var u="//matomo.vlachos.nl/";
                  _paq.push(['setTrackerUrl', u+'matomo.php']);
                  _paq.push(['setSiteId', '1']);
                  var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
                  g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
                })();
            </script>
            <!-- End Matomo Code -->
        </environment>
    }
    
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.2/dist/confetti.browser.min.js"></script>

    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&amp;family=Nunito:wght@400;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/intl-tel-input@24.5.0/build/css/intlTelInput.css">
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@24.5.0/build/js/intlTelInput.min.js"></script>
    <meta property="og:image" content="https://tigervancookie.nl/images/logo.png">

</HeadContent>

@Body

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Every time we render (including after navigation),
        // we tell JS to double-check the theme classes.
        await JS.InvokeVoidAsync("applyTheme");
    }
}