@using CookieCommerce.Web.Models.Products
@using CookieCommerce.Web.Services
@inject IBackofficeService BackofficeService

@if (_isVisible)
{
    <div class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-stone-900/60 backdrop-blur-sm transition-opacity">
        <div class="bg-white dark:bg-stone-900 w-full max-w-4xl max-h-[90vh] overflow-hidden rounded-[3rem] border-4 border-primary/10 shadow-2xl flex flex-col animate-in fade-in zoom-in duration-300">

            @* 🐯 HEADER *@
            <div class="p-8 border-b border-stone-100 dark:border-stone-800 flex justify-between items-center bg-orange-50/30 dark:bg-orange-950/10">
                <div>
                    <h2 class="text-2xl font-black text-primary uppercase tracking-tighter">Bake New Product</h2>
                    <p class="text-xs font-bold text-stone-400 uppercase tracking-widest mt-1">Fill in the ingredients for your new catalog item</p>
                </div>
                <button @onclick="Close" class="size-10 flex items-center justify-center rounded-full hover:bg-red-50 hover:text-red-500 text-stone-400 transition-all">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                </button>
            </div>

            @* 📋 FORM BODY *@
            <div class="flex-1 overflow-y-auto p-8 custom-scrollbar">
                <EditForm Model="newItem" OnValidSubmit="HandleSubmit">

                    <div class="space-y-10">
                        @* --- TOP SECTION: Basic Info & Image --- *@
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-5">
                            @* Product Name (Left Half) *@
                            <div class="space-y-2">
                                <label class="text-[10px] font-black uppercase tracking-widest text-stone-400 px-1">Product Name</label>
                                <InputText @bind-Value="newItem.ProductName"
                                           class="w-full bg-stone-50 dark:bg-stone-800 border-2 border-transparent focus:border-primary/30 rounded-2xl px-4 py-3 outline-none transition-all font-bold"
                                           placeholder="e.g. Dark Chocolate Chunk" />
                            </div>

                            @* Internal Reference (Right Half) *@
                            <div class="space-y-2">
                                <label class="text-[10px] font-black uppercase tracking-widest text-stone-400 px-1">Internal Reference</label>
                                <InputText @bind-Value="newItem.ProductReference"
                                           class="w-full bg-stone-50 dark:bg-stone-800 border-2 border-transparent focus:border-primary/30 rounded-2xl px-4 py-3 outline-none transition-all font-mono text-sm"
                                           placeholder="SKU-CHOC-001" />
                            </div>
                        </div>

                        @* --- BOTTOM SECTION: Variants (Full Width) --- *@
                        <div class="pt-6 border-t border-stone-100 dark:border-stone-800">
                            <AddVariantToProductModal 
                                Variants="newItem.Variants"
                                OnVariantsChagned="StateHasChanged" />
                            @if (!string.IsNullOrWhiteSpace(_variantValidationMessage))
                            {
                                <p class="mt-3 text-xs font-bold text-red-500" role="alert">@_variantValidationMessage</p>
                            }
                        </div>
                    </div>

                    @* 🐯 FOOTER ACTIONS *@
                    <div class="mt-12 flex items-center justify-end gap-4">
                        <button type="button" @onclick="Close" class="px-8 py-3 text-xs font-black uppercase tracking-widest text-stone-400 hover:text-stone-600 transition-colors">Cancel</button>
                        <button type="submit" class="bg-primary text-white px-10 py-4 rounded-2xl text-sm font-black uppercase tracking-widest shadow-lg shadow-orange-200 dark:shadow-none hover:scale-105 active:scale-95 transition-all">
                            Create Product
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private bool _isVisible = false;
    private string? _variantValidationMessage;
    private CreateProductDto newItem = new();

    [Parameter] public EventCallback OnProductCreated { get; set; }

    public void Open()
    {
        newItem = new CreateProductDto
        {
            Variants = new List<CreateProductVariantDto>
            {
                new CreateProductVariantDto { Name = "Standard", Price = 0 }
            }
        };
        _variantValidationMessage = null;
        _isVisible = true;
        StateHasChanged();
    }

    public void Close()
    {
        _isVisible = false;
        StateHasChanged();
    }

    private async Task HandleSubmit()
    {
        if (!ValidateVariants())
            return;

        await BackofficeService.CreateProductAsync(newItem);
        await OnProductCreated.InvokeAsync();
        Close();
    }

    private bool ValidateVariants()
    {
        _variantValidationMessage = null;

        if (newItem.Variants.Any(variant => string.IsNullOrWhiteSpace(variant.Name)))
        {
            _variantValidationMessage = "Every variant needs a name.";
            return false;
        }

        if (newItem.Variants.Any(variant => variant.Price <= 0))
        {
            _variantValidationMessage = "Every variant price must be greater than 0.";
            return false;
        }

        var hasDuplicate = newItem.Variants
            .GroupBy(variant => variant.Name.Trim(), StringComparer.OrdinalIgnoreCase)
            .Any(group => group.Count() > 1);

        if (hasDuplicate)
        {
            _variantValidationMessage = "Variant names must be unique.";
            return false;
        }

        return true;
    }
}