@page "/account/addresses"
@using CookieCommerce.Web.Models.Addresses
@using CookieCommerce.Web.Services
@rendermode InteractiveServer
@layout AccountLayout
@inject IAccountService AccountService

<div class="flex-grow">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
        <div>
            <h1 class="text-3xl font-display font-bold text-gray-800 dark:text-white">My Shipping Spots</h1>
            <p class="text-gray-500 dark:text-gray-400 mt-1">Manage where your cookies get delivered.</p>
        </div>
        <button class="flex items-center justify-center gap-2 bg-primary hover:bg-orange-600 text-white font-bold py-3 px-6 rounded-full shadow-lg transition-all transform hover:scale-105">
            <span class="material-symbols-outlined">add</span>
            Add New Address
        </button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-6">
        @foreach(var address in addresses)
        {
            <AddressCard address="@address"
                         OnAddressChanged="RefreshAddresses" />
        }
        <button @onclick="async () => await HandleAddAddressAsync()"
            class="cursor-pointer bg-orange-50/50 dark:bg-gray-800/20 rounded-xl p-6 
                   border-2 border-dashed border-orange-200 dark:border-gray-700 hover:border-primary 
                   dark:hover:border-primary transition-all flex flex-col items-center justify-center min-h-[220px] group">
            <div class="w-16 h-16 rounded-full bg-orange-100 dark:bg-gray-800 flex items-center justify-center text-primary mb-4 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-3xl">add_location_alt</span>
            </div>
            <p class="font-bold text-gray-700 dark:text-gray-300">Add another spot</p>
            <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">For more cookie deliveries!</p>
        </button>
    </div>
</div>

@code {
    private ICollection<AddressBookItemDto> addresses = null!;

    protected override async Task OnInitializedAsync()
    {
        addresses = await AccountService.GetAddressesAsync();
    }

    private async Task RefreshAddresses()
    {
        addresses = await AccountService.GetAddressesAsync();
        StateHasChanged();
    }

    private async Task HandleAddAddressAsync()
    {
        
    }
}