@using CookieCommerce.Web.Models.Account
@using CookieCommerce.Web.Services
@inject CustomerProfileService ProfileService
@inject CustomerProfileState ProfileState
@rendermode InteractiveServer
@implements IDisposable

<AccountCard>
    <div class="flex justify-between items-start mb-6">
        <h2 class="text-xl font-display font-bold text-gray-800 dark:text-white">Personal Details</h2>
        <button @onclick="() => IsEditModalOpen = true" class="cursor-pointer text-primary hover:text-orange-600 dark:hover:text-orange-400 text-sm font-semibold">
            Edit
        </button>
    </div>

    @if (isLoading)
    {
        <div class="space-y-4 animate-pulse">
            <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-3/4"></div>
            <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/2"></div>
            <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-2/3"></div>
        </div>
    }
    else if (loadError)
    {
        <p class="text-sm text-red-500">Unable to load your profile. Please refresh the page.</p>
    }
    else
    {
        <div class="space-y-4">
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-lg bg-orange-50 dark:bg-gray-800 flex items-center justify-center text-primary">
                    <span class="material-icons">badge</span>
                </div>
                <div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider font-semibold">Full Name</p>
                    <p class="font-medium">@profile.FirstName @profile.LastName</p>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-lg bg-orange-50 dark:bg-gray-800 flex items-center justify-center text-primary">
                    <span class="material-icons">email</span>
                </div>
                <div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider font-semibold">Email</p>
                    <p class="font-medium">@profile.Email</p>
                    @if (!string.IsNullOrWhiteSpace(profile.PendingEmail))
                    {
                        <p class="text-xs text-amber-600 dark:text-amber-400 mt-1">
                            Verification pending for <span class="font-semibold">@profile.PendingEmail</span>. 
                            Continue signing in with your current email.
                        </p>
                    }
                </div>
            </div>
            <div class="flex items-center gap-4">
                <div class="w-10 h-10 rounded-lg bg-orange-50 dark:bg-gray-800 flex items-center justify-center text-primary">
                    <span class="material-icons">cake</span>
                </div>
                <div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 uppercase tracking-wider font-semibold">Birthdate</p>
                    @if (profile.DateOfBirth.HasValue)
                    {
                        <p class="font-medium dark:text-white">
                            @profile.DateOfBirth.Value.ToString("MMM dd, yyyy")
                        </p>
                    }
                    else
                    {
                        <button type="button" @onclick="() => IsEditModalOpen = true"
                                class="group relative flex items-center gap-1.5 cursor-pointer focus:outline-none">
                            <p class="text-sm font-medium text-orange-400 dark:text-orange-300 italic group-hover:text-primary transition-colors">
                                Missing a birthday cookie?
                            </p>
                            <span class="material-icons text-xs text-orange-300 animate-bounce group-hover:text-primary">redeem</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</AccountCard>

@if (IsEditModalOpen)
{
    <EditProfileModal OnSave="HandleSave"
                      OnCancel="CloseModal" />
}

@code {
    [Parameter] public bool IsEditModalOpen { get; set; } = false;

    private UserProfileDto profile = new();
    private bool isLoading = true;
    private bool loadError = false;

    protected override async Task OnInitializedAsync()
    {
        ProfileState.OnProfileChanged += OnProfileStateChanged;
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        isLoading = true;
        loadError = false;

        var loaded = await ProfileService.GetProfileAsync();
        if (loaded is not null)
        {
            profile = loaded;
        }
        else
        {
            loadError = true;
        }

        isLoading = false;
    }

    private void OnProfileStateChanged()
    {
        if (ProfileState.Profile is { } updated)
            profile = updated;

        InvokeAsync(StateHasChanged);
    }

    private void CloseModal()
    {
        IsEditModalOpen = false;
    }

    private async Task HandleSave()
    {
        // Profile state already refreshed by EditProfileModal via CustomerProfileState
        IsEditModalOpen = false;
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        ProfileState.OnProfileChanged -= OnProfileStateChanged;
    }
}
