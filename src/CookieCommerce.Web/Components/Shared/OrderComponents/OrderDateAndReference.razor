<div class="flex flex-col">
    <div class="flex items-baseline gap-2">
        <p class="font-bold text-gray-900 dark:text-white leading-none">
            @PlacedOn.ToString("MMM dd, yyyy")
        </p>
        @* 🐯 Discreet time signature *@
        <span class="text-[10px] font-medium text-stone-300 dark:text-stone-600 uppercase tracking-tighter">
            @PlacedOn.ToString("HH:mm")
        </span>
    </div>
    <p class="text-xs text-gray-400 font-mono mt-0.5">#@OrderReference</p>
</div>

@code {
    [Parameter] public DateTime PlacedOn { get; set; }
    [Parameter] public string OrderReference { get; set; } = string.Empty;
}