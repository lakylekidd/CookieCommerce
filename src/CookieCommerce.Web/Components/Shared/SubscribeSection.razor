<section class="py-12 bg-primary">
    <div class="container mx-auto px-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-8 text-white">
            <div class="flex items-center gap-6">
                <img alt="Tiger Mascot"
                     class="w-24 h-24 md:w-32 md:h-32 object-contain drop-shadow-xl transform -rotate-12"
                     src="/images/logo.png" />
                <div>
                    <h3 class="font-display font-bold text-2xl md:text-3xl mb-2">Join the Tiger Club!</h3>
                    <p class="text-amber-100 max-w-md">
                        Receive news about our cookies and upcoming limited editions.
                    </p>
                </div>
            </div>
            <div class="max-w-2xl mx-auto">
                <form @onsubmit="SubscribeAsync" @onsubmit:preventDefault="true" class="flex flex-col md:flex-row items-center bg-white dark:bg-surface-dark p-1.5 rounded-3xl shadow-lg border border-amber-100 dark:border-amber-900/30 gap-2">

                    <div class="flex items-center flex-1 px-4 w-full">
                        <span class="material-icons-round text-primary/50 mr-2">person</span>
                        <input type="text" @bind="name" maxlength="200"
                               placeholder="Full Name"
                               class="w-full bg-transparent border-none focus:ring-0 text-text-light dark:text-text-dark placeholder:text-gray-400 py-3" />
                    </div>

                    <div class="hidden md:block w-px h-8 bg-amber-100 dark:bg-amber-900/30"></div>

                    <div class="flex items-center flex-1 px-4 w-full">
                        <span class="material-icons-round text-primary/50 mr-2">email</span>
                        <input type="email" @bind="email" required maxlength="254"
                               placeholder="Enter your email..."
                               class="w-full bg-transparent border-none focus:ring-0 text-text-light dark:text-text-dark placeholder:text-gray-400 py-3" />
                    </div>

                    <button type="submit" disabled="busy"
                            class="w-full md:w-auto bg-surface-dark dark:bg-primary text-white dark:text-text-dark px-8 py-3 rounded-2xl font-bold hover:scale-[1.02] active:scale-95 transition-all cursor-pointer">
                        Subscribe
                    </button>
                </form>
                <p role="status" class="mt-3">@message</p>
            </div>
        </div>
    </div>
</section>
@inject CookieCommerce.Web.Services.INewsletterService Newsletter
@code {
    private string email = "";
    private string name = "";
    private string? message;
    private bool busy;
    private async Task SubscribeAsync()
    {
        if (busy) return;
        busy = true;
        try { message = (await Newsletter.SubscribeAsync(email, name)).Message; }
        catch (Exception) { message = "Unable to save your subscription. Please try again."; }
        finally { busy = false; }
    }
}
