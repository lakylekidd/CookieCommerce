@inherits LayoutComponentBase
@layout MainLayout

<style>
    @@theme {
        --color-primary: #F59E0B;
        --color-secondary: #92400E;
        --color-background-light: #FFFBEB;
        --color-background-dark: #1F1D18;
        --color-card-light: #FFFFFF;
        --color-card-dark: #2D2A26;
        --color-accent-light: #FEF3C7;
        --color-accent-dark: #453825;
    }
</style>

@using CookieCommerce.Web.Services
@inject IAuthService Auth
@implements IDisposable
@if (ready && Auth.IsLoggedIn)
{
<div class="flex flex-col min-h-screen">
    <AccountHeader />

    <main class="flex-grow max-w-7xl w-full mx-auto px-6 py-8 flex flex-col md:flex-row gap-8">
        <AccountASide />
        @Body
    </main>

    <AccountFooter />
</div>
}
else
{
    <main class="container mx-auto p-8"><p>Sign in with an authorized account to view this page.</p><a href="/auth/signin">Sign in</a></main>
}
@code {
    private bool ready;
    protected override void OnInitialized() => Auth.OnChange += Refresh;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Auth.InitializeAsync();
        ready = true;
        StateHasChanged();
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.OnChange -= Refresh;
}
