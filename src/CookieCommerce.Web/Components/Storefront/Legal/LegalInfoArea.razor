@layout LegalMain
@inject NavigationManager Nav

@if (Nav.Uri.Contains("/legal/terms") || Nav.Uri.Contains("/legal/refund"))
{
    <div class="mt-12 p-6 bg-surface-light dark:bg-surface-dark rounded-3xl border border-amber-100 dark:border-amber-900/30 shadow-sm">
        <h4 class="font-bold text-sm uppercase tracking-wider text-primary mb-3">Need Help?</h4>
        <p class="text-xs mb-4 text-amber-900/60 dark:text-amber-100/60">
            Questions about our terms? We're here
            to help you roar back to shopping.
        </p>
        <a class="text-sm font-bold flex items-center gap-2 hover:underline"
           href="mailto:support@tigervancookie.com">
            <span class="material-symbols-outlined text-base">mail</span>
            Contact Support
        </a>
    </div>
}
else if(Nav.Uri.Contains("/legal/cookie"))
{
    <div class="mt-12 p-6 bg-surface-light dark:bg-surface-dark rounded-3xl border border-amber-100 dark:border-amber-900/30 shadow-sm">
        <h4 class="font-bold text-sm uppercase tracking-wider text-primary mb-3">Cookie Preferences</h4>
        <p class="text-xs mb-4 text-amber-900/60 dark:text-amber-100/60">
            You can update your cookie choices at
            any time to suit your browsing taste.
        </p>
        <button class="w-full bg-secondary hover:bg-amber-400 text-amber-900 py-3 rounded-xl font-bold text-sm transition-colors flex items-center justify-center gap-2">
            <span class="material-symbols-outlined text-sm">settings</span>
            Manage My Cookies
        </button>
    </div>
}
else if (Nav.Uri.Contains("/legal/privacy"))
{
    <div class="mt-12 p-6 bg-surface-light dark:bg-surface-dark rounded-3xl border border-amber-100 dark:border-amber-900/30 shadow-sm">
        <h4 class="font-bold text-sm uppercase tracking-wider text-primary mb-3">Your Privacy Matters</h4>
        <p class="text-xs mb-4 text-amber-900/60 dark:text-amber-100/60">
            We handle your data as carefully as we
            handle our cookie dough. Got questions?
        </p>
        <a class="text-sm font-bold flex items-center gap-2 hover:underline text-primary"
           href="mailto:privacy@tigervancookie.com">
            <span class="material-symbols-outlined text-base">mail</span>
            Privacy Team
        </a>
    </div>
}

