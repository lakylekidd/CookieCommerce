@using CookieCommerce.Web.Models.Products

@* 🐯 HEADER SECTION *@
<div class="flex items-center justify-between mb-6">
    <div>
        <label class="text-[10px] font-black uppercase tracking-widest text-stone-400">Product Variants</label>
    </div>
    <button type="button" @onclick="AddVariant"
            class="flex items-center gap-2 px-4 py-2 text-[10px] font-black text-primary uppercase bg-primary/5 hover:bg-primary/10 rounded-xl transition-all">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4">
            <path d="M12 5v14M5 12h14" />
        </svg>
        Add Variant
    </button>
</div>

@* 📋 TABLE-STYLE LIST *@
<div class="space-y-3">
    @* Table Header Simulation *@
    @if (Variants.Any())
    {
        <div class="grid grid-cols-12 px-6 mb-2 text-[9px] font-black uppercase tracking-widest text-stone-400">
            <div class="col-span-6">Variant Name</div>
            <div class="col-span-4">Price</div>
            <div class="col-span-2 text-right">Actions</div>
        </div>
    }

    @foreach (var variant in Variants)
    {
        <div class="grid grid-cols-12 items-center bg-stone-50/50 dark:bg-stone-800/50 rounded-2xl border border-stone-100 dark:border-stone-700/50 overflow-hidden group transition-all hover:border-primary/20">

            @* Name Input *@
            <div class="col-span-6 px-4 py-3">
                <InputText @bind-Value="variant.Name"
                           placeholder="e.g. 6-Pack"
                           class="w-full bg-transparent border-none outline-none font-bold text-sm text-stone-700 dark:text-stone-200 placeholder:text-stone-300" />
            </div>

            @* Price Input *@
            <div class="col-span-4 px-4 py-3 border-l border-stone-100 dark:border-stone-700/30">
                <div class="flex items-center gap-1">
                    <span class="text-stone-400 text-xs font-bold">@variant.CurrencySymbol</span>
                    <InputNumber @bind-Value="variant.Price"
                                 class="w-full bg-transparent border-none outline-none font-mono text-sm font-bold text-stone-600 dark:text-stone-300" />
                </div>
            </div>

            @* Delete Action *@
            <div class="col-span-2 px-4 py-2 text-right">
                <button type="button" @onclick="() => RemoveVariant(variant)"
                        class="inline-flex items-center justify-center size-9 bg-white dark:bg-stone-900 border border-primary text-primary hover:bg-primary hover:text-white rounded-full transition-all shadow-sm active:scale-90 ml-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </button>
            </div>
        </div>
    }

    @if (!Variants.Any())
    {
        <div class="py-12 border-2 border-dashed border-stone-100 dark:border-stone-800 rounded-[2.5rem] flex flex-col items-center justify-center opacity-40">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-10 mb-3 text-stone-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
            </svg>
            <p class="text-xs font-bold italic text-stone-400 uppercase tracking-widest">No variants added yet</p>
        </div>
    }
</div>

@code {
    [Parameter] public ICollection<CreateProductVariantDto> Variants { get; set; } = [];
    [Parameter] public EventCallback OnVariantsChagned { get; set; }

    private async Task AddVariant()
    {
        Variants.Add(new CreateProductVariantDto
        {
            Name = "New Variant",
            Price = 0,
        });
        await OnVariantsChagned.InvokeAsync();
    }

    private void RemoveVariant(CreateProductVariantDto variant)
    {
        Variants.Remove(variant);
    }
}