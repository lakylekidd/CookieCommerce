@using System.Globalization

<div class="group p-4 rounded-xl bg-surface-light col-span-6 sm:col-span-6 lg:col-span-3 xl:col-span-2
            dark:bg-surface-dark shadow-sm border border-amber-100/50
            dark:border-zinc-800 flex flex-col justify-between h-28 transition-all">
    <div class="flex justify-between items-start">
        <span class="text-[11px] font-bold text-gray-400 dark:text-zinc-500 uppercase tracking-widest">Fulfillment</span>
        <span class="px-2 py-0.5 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-600 dark:text-amber-400 text-[10px] font-bold">
            @Fulfillable/@Total
        </span>
    </div>
    <div>
        <h3 class="text-2xl font-black text-primary dark:text-amber-500">
            @(((decimal)Fulfillable / Total).ToString("P0", CultureInfo.InvariantCulture))
        </h3>
        <p class="text-[10px] text-gray-400 dark:text-zinc-600">Ready for dispatch</p>
    </div>
</div>

@code {
    [Parameter] public int Fulfillable { get; set; }
    [Parameter] public int Total { get; set; }
}
