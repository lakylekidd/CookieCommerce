@inject IJSRuntime JS

<div class="relative overflow-hidden lg:col-span-2 bg-surface-light dark:bg-surface-dark p-6 rounded-2xl shadow-sm border border-orange-50 dark:border-stone-700">
    @if (IsLoading)
    {
        <div class="absolute inset-0 bg-white/60 dark:bg-stone-900/60 z-10 backdrop-blur-[2px] flex flex-col items-center justify-center rounded-2xl">
            @* A little tiger-themed pulse *@
            <div class="w-16 h-16 border-4 border-amber-200 border-t-amber-500 rounded-full animate-spin mb-4"></div>
            <p class="text-amber-700 font-bold animate-pulse text-sm uppercase tracking-widest">Waking up the tiger...</p>
        </div>
    }
    
    <div class="flex items-center justify-between mb-6">
        <h3 class="text-lg font-bold font-display text-secondary dark:text-stone-200">
            Revenue
            Overview
        </h3>
        <select 
            @bind:get="Period"
            @bind:set="OnPeriodChanged"
            @bind:event="oninput"
            class="bg-stone-50 dark:bg-stone-800 border-none text-sm font-semibold text-stone-600 dark:text-stone-300 rounded-lg focus:ring-2 focus:ring-primary/50 cursor-pointer">
            <option>This Week</option>
            <option>This Month</option>
            <option>This Year</option>
        </select>
    </div>
    <div class="chart-container">
        <canvas id="revenueChart"></canvas>
    </div>
</div>

@code {
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string Period { get; set; } = "This Week";
    [Parameter] public EventCallback<string> PeriodChanged { get; set; }
    [Parameter] public List<(string Day, decimal Amount)> Revenue { get; set; } = [];

    private List<(string Day, decimal Amount)>? _lastRenderedRevenue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_lastRenderedRevenue != Revenue)
        {
            _lastRenderedRevenue = Revenue;

            var labels = Revenue.Select(x => x.Day).ToArray();
            var values = Revenue.Select(x => x.Amount).ToArray();

            await JS.InvokeVoidAsync("setupRevenueChart", labels, values);
        }
    }

    private Task OnPeriodChanged(string value)
    {
        Period = value;
        return PeriodChanged.InvokeAsync(value);
    }
}