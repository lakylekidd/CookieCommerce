@page "/auth/password/reset/{token}"
@layout AuthLayout

<main class="container mx-auto max-w-xl px-6 py-16">
    <h1 class="font-display text-3xl font-bold mb-6">Reset your password</h1>
    <p class="mb-6">Open the password reset link in your latest recovery email to choose a new password securely. If your link has expired, request a new email.</p>
    <a class="text-primary font-bold underline" href="/auth/forgot-password">Request a password reset email</a>
    <p class="mt-6"><a class="text-primary underline" href="/auth/signin">Back to sign in</a></p>
</main>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;
}
