@inherits LayoutComponentBase

<HeadContent>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="google-site-verification" content="qg_XKjLH1Q-HM5s9K4uKesiQHWIOwF9XdE7iOYomv64" />
    <meta name="google-adsense-account" content="ca-pub-2415952858841772">

    <!-- Google tag (gtag.js) for analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HNS116Q0G5"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-HNS116Q0G5');
    </script>
    <!-- Google Tag -->

    <script src="https://cdn.tailwindcss.com?plugins=forms,typography,container-queries"></script>
    <script>
        tailwind = {
            config: {
                darkMode: "class",
                theme: {
                    extend: {
                        colors: {
                            primary: "#D97706", // Amber-600 - Warm cookie brown/tiger orange
                            secondary: "#FCD34D", // Amber-300 - lighter yellow/cream
                            "background-light": "#FFFBEB", // Amber-50 - warm cream
                            "background-dark": "#1F1508", // Very dark brown
                            "surface-light": "#FFFFFF",
                            "surface-dark": "#2D2115", // Dark brown surface
                            "text-light": "#451a03", // Dark cookie brown
                            "text-dark": "#FEF3C7", // Light cream text
                        },
                        fontFamily: {
                            display: ["Fredoka", "sans-serif"],
                            body: ["Nunito", "sans-serif"],
                        },
                        borderRadius: {
                            DEFAULT: "1rem",
                            'xl': "1.5rem",
                            '2xl': "2rem",
                            '3xl': "3rem",
                        },
                    },
                },
            }
        };
    </script>
    
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&amp;family=Nunito:wght@400;600;700;800&amp;display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons+Round" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" />

    <meta property="og:image" content="https://tigervancookie.nl/images/logo.png">

    <!-- Matomo -->
    <script>
        var _paq = window._paq = window._paq || [];
        /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
        _paq.push(['trackPageView']);
        _paq.push(['enableLinkTracking']);
        (function() {
          var u="//matomo.vlachos.nl/";
          _paq.push(['setTrackerUrl', u+'matomo.php']);
          _paq.push(['setSiteId', '1']);
          var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
          g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
        })();
    </script>
    <!-- End Matomo Code -->

</HeadContent>

@Body
