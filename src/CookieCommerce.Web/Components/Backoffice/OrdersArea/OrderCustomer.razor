@using CookieCommerce.Web.Models.Order
@using CookieCommerce.Web.Services.StaticData

<div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center font-bold text-sm @ColorClass">
        @AddressInformation.GetInitials()
    </div>
    <div class="min-w-0">
        <p class="text-sm font-semibold text-slate-900 dark:text-white leading-tight truncate">
            @AddressInformation.FirstName @AddressInformation.LastName
        </p>
        <p class="text-[11px] text-slate-500 truncate">@AddressInformation.City, @AddressInformation.Country</p>
    </div>
</div>

@code {
    [Parameter] public QuotaOrderAddressDto AddressInformation { get; set; } = new();

    private string ColorClass => TigerPalette.GetColorFromString(AddressInformation.LastName);
}