@using CookieCommerce.Web.Models.Cart
@using CookieCommerce.Web.Services
@inject ICartService CartService
@inject IJSRuntime JS

<script>
    window.fireConfettiFromElement = (elementId) => {
        const el = document.getElementById(elementId);
        if (!el) return;

        const rect = el.getBoundingClientRect();
        const x = (rect.left + rect.width / 2) / window.innerWidth;
        const y = (rect.top + rect.height / 2) / window.innerHeight;

        confetti({
            particleCount: 150, // Increased for more "color punch"
            spread: 80,
            origin: { x: x, y: y },
            // A mix of your brand and high-energy party colors
            colors: [
                '#D97706', // Primary Amber
                '#FCD34D', // Secondary Amber
                '#F97316', // Brand Orange
                '#EF4444', // Red-Orange
                '#10B981', // Emerald (for contrast)
                '#3B82F6', // Bright Blue
                '#8B5CF6', // Purple
                '#F472B6'  // Pink
            ],
            ticks: 300,
            gravity: 1,
            scalar: 1.2, // Slightly larger particles to show off colors
            drift: 0.5
        });
    };
</script>

@code {
    [Parameter] public CartDto? Cart { get; set; } = default;
    private bool _isCelebrating = false;
    private decimal _lastKnownPercentage = 0;

    protected override async Task OnParametersSetAsync()
    {
        var currentPercentage = CalculatePercentage();

        // If it just hit 100% and we aren't already celebrating
        if (currentPercentage >= 100 && _lastKnownPercentage < 100 && !_isCelebrating)
        {
            _isCelebrating = true;

            // 1. Fire the confetti
            await JS.InvokeVoidAsync("fireConfettiFromElement", "shipping-bar-container");

            // 2. Wait for the CSS transition (700ms) plus a moment to enjoy
            await Task.Delay(1200);

            _isCelebrating = false;

            StateHasChanged();
        }

        _lastKnownPercentage = currentPercentage;
    }

    private int CalculatePercentage()
    {
        if (Cart == null) return 0;
        if (Cart.ToGoUntilFreeShipping <= 0) return 100;

        var currValue = (int)((Cart.SubTotalPrice / CartDto.FREE_SHIPPING_THRESHOLD) * 100);
        return Math.Min(currValue, 100);
    }

}

@if (Cart != null)
{
    if (Cart.ToGoUntilFreeShipping > 0 || _isCelebrating)
    {
        <div class="max-w-2xl bg-white dark:bg-surface-dark p-6 rounded-2xl border border-amber-100 dark:border-amber-900/30 shadow-sm transition-all duration-500 
                            @(_isCelebrating ? "animate-pop scale-105 border-primary shadow-amber-200" : "")">
            <div class="flex justify-between items-center mb-3">
                <span class="text-sm font-bold flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary @(_isCelebrating ? "animate-bounce" : "")">local_shipping</span>
                    Free Shipping Progress
                </span>
                <span class="text-sm font-bold text-primary">
                    @if (_isCelebrating)
                    {
                        <span>Goal Reached!</span>
                    }
                    else
                    {

                        <span>@Cart.CurrencySymbol@Cart.ToGoUntilFreeShipping to go!</span>
                    }
                </span>
            </div>
            <div id="shipping-bar-container" class="w-full bg-amber-50 dark:bg-amber-950 rounded-full h-3 overflow-hidden">
                <div class="h-3 rounded-full transition-all duration-700 @(_isCelebrating ? "celebration-glow" : "bg-primary")"
                     style="width: @CalculatePercentage()%;">
                </div>
            </div>
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-3 italic">
                @Cart.FreeShippingMessage
            </p>
        </div>
    }
    else
    {
        <div class="max-w-2xl bg-primary text-white p-6 rounded-2xl shadow-lg animate-in fade-in zoom-in duration-500">
            <div class="flex items-center gap-3">
                <span class="material-symbols-outlined">celebration</span>
                <span class="font-bold">Congratulations! @Cart.FreeShippingMessage</span>
            </div>
        </div>
    }
}