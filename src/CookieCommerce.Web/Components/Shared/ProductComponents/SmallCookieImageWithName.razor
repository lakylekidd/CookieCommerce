<div class="relative group flex items-center gap-3 w-full p-2 rounded-2xl hover:bg-orange-50/50 dark:hover:bg-white/5">
    <div class="w-8 h-8 flex-shrink-0 rounded-full border-2 border-primary bg-orange-100 flex items-center justify-center shadow-md overflow-hidden ring-1 ring-black/5 dark:ring-white/10 group-hover:scale-110 transition-transform">
        <img src="@ImageUrl"
             alt="@Name"
             class="w-full h-full object-cover" />
    </div>
    <span class="font-bold text-stone-700 dark:text-stone-200 text-sm" ">
        @Name
    </span>
    <div class="ml-auto flex items-baseline rounded-full">
        <span class="ml-auto bg-primary text-white text-m font-bold px-2 py-1 rounded-lg shadow-sm">
            @Quantity
        </span>
    </div>
</div>
@code {
    [Parameter] public string ImageUrl { get; set; } = default!;
    [Parameter] public string Name { get; set; } = default!;
    [Parameter] public int Quantity { get; set; }
}